{"module": "pipelines.yasAMsi_jas_shi_num", "callable": "derive_yasAMsi", "ok": true, "smoke_note": null, "invocation": {"args": [], "kwargs": {}}, "result_kind": "state", "final_flat_slp1": "yasAMsi", "phase": "angakarya", "tripadi_zone": true, "trace_len": 16, "trace": [{"sutra_id": "4.1.2", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "yasas", "form_after": "yasasjas", "why_dev": "एकविंशति सुप्-प्रत्ययाः क्रमेण प्रातिपदिकात् विधीयन्ते; अधिकारः ४.१.२ तः ५.४.१६० पर्यन्तम्।", "status": "APPLIED", "parts": [["yasas", "prakriti", "yasas"], ["jas", "sup", "jas"]], "chronological_transition": {"from_sutra": null, "to_sutra": "4.1.2"}}, {"sutra_id": "7.1.20", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "yasasjas", "form_after": "yasasSi", "why_dev": "नपुंसक-अङ्गात् परयोः जस्/शस्-प्रत्यययोः ‘शि’-आदेशः (ज्ञानानि)।", "status": "APPLIED", "parts": [["yasas", "prakriti", "yasas"], ["Si", "sup", "Si"]], "chronological_transition": {"from_sutra": "4.1.2", "to_sutra": "7.1.20"}}, {"sutra_id": "1.3.2", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "yasasSi", "form_after": "yasasSi", "why_dev": "उपदेशावस्थायाम् अज् वर्णः अनुनासिकः चेद् इत्-संज्ञकः; इँर्-वार्तिके पुनः द्वयोः संयुक्तः इत्। लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.20", "to_sutra": "1.3.2"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "yasasSi", "form_after": "yasasSi", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.2", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.4", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "yasasSi", "form_after": "yasasSi", "why_dev": "विभक्ति-प्रत्यये अन्त्यौ तु-स्म-वर्णौ हलन्त्य-इत् संज्ञां न लभेते; विधिः १.३.३ एव न प्रवर्तते (तुस्मान्त-निषेधः)।", "status": "SKIPPED", "