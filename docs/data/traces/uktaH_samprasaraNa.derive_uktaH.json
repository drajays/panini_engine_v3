{"module": "pipelines.uktaH_samprasaraNa", "callable": "derive_uktaH", "ok": true, "smoke_note": null, "invocation": {"args": [], "kwargs": {}}, "result_kind": "state", "final_flat_slp1": "uktaH", "phase": "angakarya", "tripadi_zone": true, "trace_len": 16, "trace": [{"sutra_id": "1.1.26", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "vackta", "form_after": "vackta", "why_dev": "क्त/क्तवतु-प्रत्यययोः निष्ठा-संज्ञा।", "status": "APPLIED", "chronological_transition": {"from_sutra": null, "to_sutra": "1.1.26"}}, {"sutra_id": "1.3.8", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "vackta", "form_after": "vackta", "why_dev": "अतद्धिते प्रत्ययादौ ल्-श्-कु-वर्णानाम् इत्-संज्ञा; लोपः १.३.९। सुप्-पङ्क्तिषु ङ्-आदिर् अपि (*N* ∈ *ku*)।", "status": "APPLIED", "why_now_dev": "अतद्धित-प्रत्ययस्य आदौ ल्/श्/कवर्ग-वर्णः 'इत्'-संज्ञां प्राप्नोति; अयं वर्णः अनन्तरं १.३.९ इति लुप्यते (यथा शप् → अ, ङी → ई)। (१.३.८)", "chronological_transition": {"from_sutra": "1.1.26", "to_sutra": "1.3.8"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vackta", "form_after": "vacta", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.8", "to_sutra": "1.3.9"}}, {"sutra_id": "6.1.15", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vacta", "form_after": "vacta", "why_dev": "कित्-प्रत्यये परे वच्/स्वप्/यज्-आदीनां यण्-वर्णस्य सम्प्रसारण-प्रसङ्गः।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "6.1.15"}}, {"sutra_id": "1.1.45", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "vacta", "form_after": "uacta", "why_dev": "यण्-वर्णस्य (य्/व्/र्/ल्) इक्-वर्णे (इ/उ/ऋ/ऌ) सम्प्रसारणम् — यथासंख्येन।", "status": "AUDIT", "chronological_transition": {"from_sutra": "6.1.15", "to_sutra": "1.1.45"}}, {"sutra_id": "6.1.108", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "uacta", "form_after": "ucta", "why_dev": "सम्प्रसारण-वर्णात् परस्य अचः पूर्वरूप-एकादेशः (उ+अ→उ इत्यादि)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.1.45", "to_sutra": "6.1.108"}}, {"sutra_id": "__UKTA_MERGE__", "sutra_type": "STRUCTURAL", "type_label": "उक्त-मेलनम्", "form_before": "ucta", "form_after": "ucta", "why_dev": "धातु + क्त → प्रातिपदिकम् (संरचनात्मकं, न सूत्रम्)।", "status": "APPLIED"}, {"sutra_id": "4.1.2", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "ucta", "form_after": "uctasu", "why_dev": "एकविंशति सुप्-प्रत्ययाः क्रमेण प्रातिपदिकात् विधीयन्ते; अधिकारः ४.१.२ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "6.1.108", "to_sutra": "4.1.2"}}, {"sutra_id": "1.3.2", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "uctasu", "form_after": "uctasu", "why_dev": "उपदेशावस्थायाम् अज् वर्णः अनुनासिकः चेद् इत्-संज्ञकः; इँर्-वार्तिके पुनः द्वयोः संयुक्तः इत्। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "4.1.2", "to_sutra": "1.3.2"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "uctasu", "form_after": "uctas", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.2", "to_sutra": "1.3.9"}}, {"sutra_id": "1.2.41", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "uctas", "form_after": "uctas", "why_dev": "एक-हल्-प्रत्ययः अपृक्त-संज्ञकः (ईट्-आगम ७.३.९६ इत्यादि-प्रसङ्गे)।", "status": "APPLIED", "why_now_dev": "एक-अल् (एक-वर्ण) प्रत्ययः 'अपृक्त'-संज्ञां प्राप्नोति; 