{"module": "pipelines.sthanivat_anal_ashrita_lesson", "callable": "derive_dviz_am_laG", "ok": true, "smoke_note": null, "invocation": {"args": [], "kwargs": {}}, "result_kind": "state", "final_flat_slp1": "dviamla", "phase": "angakarya", "tripadi_zone": false, "trace_len": 10, "trace": [{"sutra_id": "3.1.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "dviz", "form_after": "dviz", "why_dev": "अधिकारः प्रत्यय-विधानम् — ३.१.१ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": null, "to_sutra": "3.1.1"}}, {"sutra_id": "3.1.2", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "dviz", "form_after": "dviz", "why_dev": "प्रत्ययः निमित्तात् परः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.1", "to_sutra": "3.1.2"}}, {"sutra_id": "3.1.3", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "dviz", "form_after": "dviz", "why_dev": "प्रत्ययस्य आद्युदात्तत्वम् — अधिकारः ३.१.३ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.2", "to_sutra": "3.1.3"}}, {"sutra_id": "3.2.111", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "dviz", "form_after": "dvizla", "why_dev": "अनद्यतन-भूते लङ्-लकार-स्थापनम् (इह 'laG' प्लेसहोल्डर्) ।", "status": "APPLIED", "chronological_transition": {"from_sutra": "3.1.3", "to_sutra": "3.2.111"}}, {"sutra_id": "3.4.77", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "dvizlalaG", "form_after": "dvizlalaG", "why_dev": "लाधिकारः — ३.४.७७ तः ३.४.११२ पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.2.111", "to_sutra": "3.4.77"}}, {"sutra_id": "1.1.56", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "dvizlalaG", "form_after": "dvizlalaG", "why_dev": "आदेशः स्थानिनः समानधर्मा भवति, परम् अल्-विधिं विहाय।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.4.77", "to_sutra": "1.1.56"}}, {"sutra_id": "3.4.78", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "dvizlalaG", "form_after": "dvizmiplaG", "why_dev": "लकार-प्रत्ययस्य स्थाने तिङ्-आदेश (तिप्-तस्-झि-…-महिङ्) — संज्ञाः १.४.९९ इत्यादि-सूत्रैः पृथक्; सूत्रे अभिकल्पित-तिङ्-लक्ष्यम्, न पुरुष-वचन-परिगणनम् (CONSTITUTION २)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.1.56", "to_sutra": "3.4.78"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "dvizmiplaG", "form_after": "dvizmiplaG", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "3.4.78", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "dvizmiplaG", "form_after": "dvimila", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.9"}}, {"sutra_id": "3.4.101", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "dvimila", "form_after": "dviamla", "why_dev": "लङि: तस्→ताम् (प्रथम-द्विवचन), थस्→तम् (मध्यम-द्वि), थ→त (मध्यम-बहु), मि→अम् (उत्तम-एक)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "3.4.101"}}]}