m_before": "lUyaG", "form_after": "lUy", "why_dev": "यङ्-प्रसङ्गे द्वित्व-प्रवृत्तिः (ग्लास-बॉक्स् marker)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "6.1.1", "to_sutra": "6.1.9"}}, {"sutra_id": "6.1.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "lUy", "form_after": "lUylUy", "why_dev": "द्वित्वाधिकारः — ६.१.१ तः ६.१.१२ पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "6.1.9", "to_sutra": "6.1.1"}}, {"sutra_id": "6.1.4", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "lUylUy", "form_after": "lUylUy", "why_dev": "द्वित्व-प्रसङ्गे पूर्वभागः अभ्यास-संज्ञकः (ग्लास-बॉक्स् gate)।", "status": "AUDIT", "chronological_transition": {"from_sutra": "6.1.1", "to_sutra": "6.1.4"}}, {"sutra_id": "7.4.60", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "lUylUy", "form_after": "lUlUy", "why_dev": "अभ्यासे हलादिः एव शेषः (ग्लास-बॉक्स्: द्वित्व-प्रकरणे); प०३७ च ``Iw``→``I``।", "status": "APPLIED", "chronological_transition": {"from_sutra": "6.1.4", "to_sutra": "7.4.60"}}, {"sutra_id": "7.4.82", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "lUlUy", "form_after": "lolUy", "why_dev": "यङ्-प्रसङ्गे अभ्यासस्य गुणः (लू→लो)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "7.4.60", "to_sutra": "7.4.82"}}, {"sutra_id": "2.4.74", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "lolUya", "form_after": "lolUa", "why_dev": "यङन्त-धातोः अचि परे अन्त्य-यकारस्य लुक् (लोप-टैग सह)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "7.4.82", "to_sutra": "2.4.74"}}, {"sutra_id": "1.1.4", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "lolUa", "form_after": "lolUa", "why_dev": "आर्धधातुके क्षेपे सति यदि धातु-लोपः, तदा १.१.३-वर्णितः इक-स्थानिन्-नियमो गुण-वृद्धि-क्रियायै न प्रवर्तते।", "status": "AUDIT", "chronological_transition": {"from_sutra": "2.4.74", "to_sutra": "1.1.4"}}, {"sutra_id": "7.3.84", "sutra_type": "VIDH