er": "katikftvasT", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.2.46", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.8", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "katikftvasT", "form_after": "katikftvasT", "why_dev": "अतद्धिते प्रत्ययादौ ल्-श्-कु-वर्णानाम् इत्-संज्ञा; लोपः १.३.९। सुप्-पङ्क्तिषु ङ्-आदिर् अपि (*N* ∈ *ku*)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.8"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "katikftvasT", "form_after": "katikftvas", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.8", "to_sutra": "1.3.9"}}, {"sutra_id": "1.3.10", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "katikftvas", "form_after": "katikftvas", "why_dev": "द्वयोः समसङ्ख्यक-गणयोः मध्ये अनुदेशः यदा, तदा सः सदस्येषु क्रमेण — यथा ६.१.७८ (ए→अय्, ऐ→आय्), ३.१.१३४ (ल्यु्-णिनि-अच्), १.१.४६ (टित्-कित्)। असमसङ्ख्ये (८.२.३९) न; अन्तरतमम् १.१.५० आदि।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "1.3.10"}}, {"sutra_id": "__KFTVAS_MERGE__kati__", "sutra_type": "STRUCTURAL", "type_label": "कृत्वस्-मेलनम्", "form_before": "katikftvas", "form_after": "katikftvas", "why_dev": "अङ्ग+कृत्वसुट्-संयोजनम् (संरचनात्मकं)।", "status": "APPLIED"}, {"sutra_id": "4.1.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "katikftvas", "form_after": "katikftvas", "why_dev": "प्रातिपदिकाधिकारः — ४.१.१ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.3.10", "to_sutra": "4.1.