{"module": "pipelines.sAmanyas_taddhita", "callable": "derive_sAmanyas", "ok": true, "smoke_note": null, "invocation": {"args": [], "kwargs": {}}, "result_kind": "state", "final_flat_slp1": "sAmanyaH", "phase": "angakarya", "tripadi_zone": true, "trace_len": 103, "trace": [{"sutra_id": "4.4.98", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanNi", "form_after": "sAmanNiyat", "why_dev": "तत्रार्थे साधौ यत्-प्रत्ययः (सामसु साधुः → सामन्यः)।", "status": "APPLIED", "chronological_transition": {"from_sutra": null, "to_sutra": "4.4.98"}}, {"sutra_id": "6.4.168", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sAmanNiyat", "form_after": "sAmanNiyat", "why_dev": "यत्-प्रत्यये प्रकृतिभावः — ६.४.१४४-टिलोप-प्रतिषेधाङ्कनम्।", "status": "APPLIED", "chronological_transition": {"from_sutra": "4.4.98", "to_sutra": "6.4.168"}}, {"sutra_id": "6.4.144", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanNiyat", "form_after": "sAmanNiyat", "why_dev": "अन्-ान्ताद् यत्-परे टि-लोपः (प्रकृतिभावेन बाध्यते इति अङ्कनम्)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.4.168", "to_sutra": "6.4.144"}}, {"sutra_id": "1.2.46", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sAmanNiyat", "form_after": "sAmanNiyat", "why_dev": "कृत्-तद्धित-समासान्ताः शब्दाः प्रातिपदिक-संज्ञकाः।", "status": "APPLIED", "chronological_transition": {"from_sutra": "6.4.144", "to_sutra": "1.2.46"}}, {"sutra_id": "2.4.71", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanNiyat", "form_after": "sAmanyat", "why_dev": "धातु/प्रातिपदिक-अवयवे विद्यमानस्य सुपः लुक् (आर्म्ड-मेटा)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.2.46", "to_sutra": "2.4.71"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sAmanyat", "form_after": "sAmanyat", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "2.4.71", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.8", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sAmanyat", "form_after": "sAmanyat", "why_dev": "अतद्धिते प्रत्ययादौ ल्-श्-कु-वर्णानाम् इत्-संज्ञा; लोपः १.३.९। सुप्-पङ्क्तिषु ङ्-आदिर् अपि (*N* ∈ *ku*)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.8"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyat", "form_after": "sAmanya", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.8", "to_sutra": "1.3.9"}}, {"sutra_id": "1.3.10", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "sAmanya", "form_after": "sAmanya", "why_dev": "द्वयोः समसङ्ख्यक-गणयोः मध्ये अनुदेशः यदा, तदा सः सदस्येषु क्रमेण — यथा ६.१.७८ (ए→अय्, ऐ→आय्), ३.१.१३४ (ल्यु्-णिनि-अच्), १.१.४६ (टित्-कित्)। असमसङ्ख्ये (८.२.३९) न; अन्तरतमम् १.१.५० आदि।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "1.3.10"}}, {"sutra_id": "__TADDHITA_SAMANYA_MERGE__", "sutra_type": "STRUCTURAL", "type_label": "तद्धित-मेलनम्", "form_before": "sAmanya", "form_after": "sAmanya", "why_dev": "सामन् + यत्-इत-lopa → सामन्य (संरचनात्मकं)।", "status": "APPLIED"}, {"sutra_id": "6.1.213", "sutra_type": "ANUVADA", "type_label": "अनुवाद", "form_before": "sAmanya", "form_after": "sAmanya", "why_dev": "यत्-प्रत्यये आद्य्-उदात्त-न्यायः (श्रुति-स्तरः)।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.3.10", "to_sutra": "6.1.213"}}, {"sutra_id": "6.1.158", "sutra_type": "ANUVADA", "type_label": "अनुवाद", "form_before": "sAmanya", "form_after": "sAmanya", "why_dev": "वाक्ये अनुदात्त-पद-न्यायः (श्रुति-स्तरः; वर्ण-पटे नास्ति)।", "status": "AUDIT", "chronological_transition": {"from_sutra": "6.1.213", "to_sutra": "6.1.158"}}, {"sutra_id": "4.1.2", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "sAmanya", "form_after": "sAmanyasu", "why_dev": "एकविंशति सुप्-प्रत्ययाः क्रमेण प्रातिपदिकात् विधीयन्ते; अधिकारः ४.१.२ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "6.1.158", "to_sutra": "4.1.2"}}, {"sutra_id": "3.1.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "sAmanyasu", "form_after": "sAmanyasu", "why_dev": "अधिकारः प्रत्यय-विधानम् — ३.१.१ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "4.1.2", "to_sutra": "3.1.1"}}, {"sutra_id": "3.1.2", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "sAmanyasu", "form_after": "sAmanyasu", "why_dev": "प्रत्ययः निमित्तात् परः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.1", "to_sutra": "3.1.2"}}, {"sutra_id": "1.4.102", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sAmanyasu", "form_after": "sAmanyasu", "why_dev": "प्रत्येक-पुरुष-त्रिके क्रमेण एक-द्वि-बहु-वचन-संज्ञा; अष्टादश-तिङ्-क्रमः ३.४.७८।", "status": "APPLIED", "why_now_dev": "प्रत्येक-पुरुष-त्रिके क्रमेण एकवचन-द्विवचन-बहुवचन-संज्ञाः; विभक्ति-प्रत्ययस्य वचन-संज्ञा अत्र निर्धार्यते। (१.४.१०२)", "chronological_transition": {"from_sutra": "3.1.2", "to_sutra": "1.4.102"}}, {"sutra_id": "1.1.43", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sAmanyasu", "form_after": "sAmanyasu", "why_dev": "सु-प्रत्ययः (नपुंसकाद् भिन्नः) सर्वनामस्थान-संज्ञकः।", "status": "APPLIED", "why_now_dev": "अनपुंसक (पुं/स्त्री) प्रातिपदिकस्य सुँ-आदिः सर्वनामस्थान-सुप् 'सर्वनामस्थान'-संज्ञां प्राप्नोति; अनया संज्ञया अङ्ग-कार्याणि (यथा ७.१.७० नुम्) प्रवर्तन्ते। (१.१.४३)", "chronological_transition": {"from_sutra": "1.4.102", "to_sutra": "1.1.43"}}, {"sutra_id": "1.4.103", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "sAmanyasu", "form_after": "sAmanyasu", "why_dev": "एकविंशति-सुप्-प्रत्ययानाम् 'सुप्' संज्ञा; अनेन १.४.१०४ 'विभक्ति'-संज्ञा-विधाने सुप्-समुच्चयः साधु।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.43", "to_sutra": "1.4.103"}}, {"sutra_id": "1.4.13", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sAmanyasu", "form_after": "sAmanyasu", "why_dev": "प्रत्यय-विधेर् यस्मात् तदादि प्रत्यये यत् तद् अङ्गम्।", "status": "APPLIED", "why_now_dev": "प्रत्ययात् पूर्वं स्थितः अवयवः अङ्ग-संज्ञकः (प्रत्यये परतः अङ्गम्); अनेन अङ्ग-अधिकार-कार्याणि (६.४.१ आदि) प्रसजन्ति। (१.४.१३)", "chronological_transition": {"from_sutra": "1.4.103", "to_sutra": "1.4.13"}}, {"sutra_id": "1.4.14", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sAmanyasu", "form_after": "sAmanyasu", "why_dev": "सुप्-अन्तः तिङ्-अन्तः वा शब्दः पद-संज्ञकः (अष्टाध्यायी)।", "status": "APPLIED", "why_now_dev": "सुप्-अन्तः तिङ्-अन्तः वा शब्दः पद-संज्ञकः; अनेन पद-कार्याणि (त्रिपादी-सन्धि-आदि) प्रसजन्ति। (१.४.१४)", "chronological_transition": {"from_sutra": "1.4.13", "to_sutra": "1.4.14"}}, {"sutra_id": "1.3.2", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sAmanyasu", "form_after": "sAmanyasu", "why_dev": "उपदेशावस्थायाम् अज् वर्णः अनुनासिकः चेद् इत्-संज्ञकः; इँर्-वार्तिके पुनः द्वयोः संयुक्तः इत्। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.4.14", "to_sutra": "1.3.2"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sAmanyasu", "form_after": "sAmanyasu", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.2", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.4", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sAmanyasu", "form_after": "sAmanyasu", "why_dev": "विभक्ति-प्रत्यये अन्त्यौ तु-स्म-वर्णौ हलन्त्य-इत् संज्ञां न लभेते; विधिः १.३.३ एव न प्रवर्तते (तुस्मान्त-निषेधः)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.4"}}, {"sutra_id": "1.3.5", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sAmanyasu", "form_after": "sAmanyasu", "why_dev": "ञ्-इट्-डु-वर्णेषु प्रथमः हल् ‘इत्’ संज्ञकः; लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.4", "to_sutra": "1.3.5"}}, {"sutra_id": "1.3.6", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sAmanyasu", "form_after": "sAmanyasu", "why_dev": "प्रत्ययस्य आदौ ष्-वर्णः ‘इत्’ संज्ञकः; लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.5", "to_sutra": "1.3.6"}}, {"sutra_id": "1.3.7", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sAmanyasu", "form_after": "sAmanyasu", "why_dev": "चवर्ग-टवर्गीयः प्रथमः हल् ‘इत्’ संज्ञकः; लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.6", "to_sutra": "1.3.7"}}, {"sutra_id": "1.3.8", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sAmanyasu", "form_after": "sAmanyasu", "why_dev": "अतद्धिते प्रत्ययादौ ल्-श्-कु-वर्णानाम् इत्-संज्ञा; लोपः १.३.९। सुप्-पङ्क्तिषु ङ्-आदिर् अपि (*N* ∈ *ku*)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.7", "to_sutra": "1.3.8"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyasu", "form_after": "sAmanyas", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.8", "to_sutra": "1.3.9"}}, {"sutra_id": "1.3.10", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "द्वयोः समसङ्ख्यक-गणयोः मध्ये अनुदेशः यदा, तदा सः सदस्येषु क्रमेण — यथा ६.१.७८ (ए→अय्, ऐ→आय्), ३.१.१३४ (ल्यु्-णिनि-अच्), १.१.४६ (टित्-कित्)। असमसङ्ख्ये (८.२.३९) न; अन्तरतमम् १.१.५० आदि।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "1.3.10"}}, {"sutra_id": "7.1.93", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "सखि-शब्दस्य सौ-प्रत्यये परे 'अनङ्'-आदेशः — अन्त्य-इकारस्य स्थाने [अ,न्] (ṅकार-लोपानन्तरम्): सखि → सखन् → सखान् → सखा।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.10", "to_sutra": "7.1.93"}}, {"sutra_id": "6.4.8", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "असम्बुद्धि-सर्वनामस्थाने परे नपुंसक-अङ्गस्य उपधा-अकारस्य दीर्घः (ज्ञानानि)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.93", "to_sutra": "6.4.8"}}, {"sutra_id": "1.4.7", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "ह्रस्व-इक्-अन्तस्य अङ्गस्य घि-संज्ञा (हरि-प्रकारे प्रयोगाय)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.4.8", "to_sutra": "1.4.7"}}, {"sutra_id": "1.2.41", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "एक-हल्-प्रत्ययः अपृक्त-संज्ञकः (ईट्-आगम ७.३.९६ इत्यादि-प्रसङ्गे)।", "status": "APPLIED", "why_now_dev": "एक-अल् (एक-वर्ण) प्रत्ययः 'अपृक्त'-संज्ञां प्राप्नोति; अनया संज्ञया ईट्-आगम-आदि-विधयः (यथा ७.३.९६) प्रवर्तन्ते। (१.२.४१)", "chronological_transition": {"from_sutra": "1.4.7", "to_sutra": "1.2.41"}}, {"sutra_id": "7.2.106", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "तद्/त्यद्-शब्दयोः सुँ-प्रत्यये परे आद्य-तकारस्य सकारादेशः (सः)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.2.41", "to_sutra": "7.2.106"}}, {"sutra_id": "7.2.102", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "त्यदादि-गण-शब्दानां विभक्ति-प्रत्यये परे अन्त्य-हल्-स्थानि अकार-आदेशः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.2.106", "to_sutra": "7.2.102"}}, {"sutra_id": "6.1.68", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "हल्-अन्तात् / ङी-आभ्-अन्तात् दीर्घात् अङ्गात् परस्य अपृक्त-सु-हल्-लोपः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.2.102", "to_sutra": "6.1.68"}}, {"sutra_id": "6.4.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "६.४.१ तः ७.४.९७ पर्यन्तानि सूत्राणि अङ्गस्य विधयः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "6.1.68", "to_sutra": "6.4.1"}}, {"sutra_id": "7.1.94", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "ऋकारान्ते अनङ्-आदेशः (तृच् + सु)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.4.1", "to_sutra": "7.1.94"}}, {"sutra_id": "6.4.11", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "तृण्-विषये उपधा-दीर्घः सर्वनामस्थाने (चेता-पथ)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.94", "to_sutra": "6.4.11"}}, {"sutra_id": "6.1.66", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "तृच्-पथ: दीर्घात् परस्य अपृक्त हल्-लोपः (सु→स्)। विधि-लिङ्-पथ: यासुट्-अवशेष [i,y] में य्-लोपः हल्-पूर्वे। आशीर्-लिङ्-पथ (२मध्यम-एक): यासुट्-पश्चात् सिप्-जन्य-स्-लोपः। कर्मणि-पथ: ७.२.८१-जन्य इय् में य्-लोपः हल्-पूर्वे (इय्ते→इते)। कर्मणि-विधिलिङ्-पथ: सीयुट्-अवशेष [I,y] में य्-लोपः हल्-पूर्वे। व्योः-वलि-पथ: य्-लोपः व/ल/र/त्-पूर्वम् (**1.1.58**+**6.4.48** पाठ)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.4.11", "to_sutra": "6.1.66"}}, {"sutra_id": "7.1.2", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "तद्धित-प्रत्ययस्य आदौ फ्-ढ्-ख्-छ्-घ्-क्रमेण आयन्-एय्-ईन्-ईय्-इय्-आदेशाः (१.३.१० यथासङ्ख्यम्)। कृत्-सुप्-तिङ्-प्रत्ययेषु न।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.66", "to_sutra": "7.1.2"}}, {"sutra_id": "6.1.97", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "गुणे पररूप-एकादेशः — अकार-द्वय-संयोगे प्रथमम् अकारं लोपयति।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.2", "to_sutra": "6.1.97"}}, {"sutra_id": "7.2.113", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "इदम्-एतद्-शब्दयोर् हल्-वर्णादौ सुपि परे 'इद्'-'एत्'-भागस्य लोपः, ततः 'अ' मात्रेण अदन्त-अङ्गं *सुपि* दीर्घ-योग्यम् (७.३.१०२, १.१.२१)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.97", "to_sutra": "7.2.113"}}, {"sutra_id": "7.3.106", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "(सूत्रम् ७.३.१०६) सम्बुद्धौ च — आबन्त-स्त्रीलिङ्ग-अङ्गस्यान्त्य-आ-कारस्य 'ए'-आदेशः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.2.113", "to_sutra": "7.3.106"}}, {"sutra_id": "6.1.69", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "एङ्-अन्त / ह्रस्व-अन्त अङ्गात् परस्य सम्बुद्धि-एकवचन-सु-प्रत्ययस्य हल्-वर्णस्य लोपः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.3.106", "to_sutra": "6.1.69"}}, {"sutra_id": "7.1.15", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "अदन्त-सर्वनाम-अङ्गात् परयोः ङसि/ङि-प्रत्यययोः क्रमशः ‘स्मात्’/‘स्मिन्’ आदेशौ।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.69", "to_sutra": "7.1.15"}}, {"sutra_id": "7.1.12", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "अदन्त-अङ्गात् परेषां टा/ङसि/ङसाम् क्रमेण इन/आत्/स्य-आदेशाः भवन्ति।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.15", "to_sutra": "7.1.12"}}, {"sutra_id": "7.1.14", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "अदन्त-सर्वनाम-अङ्गात् परस्य ङे-प्रत्ययस्य ‘स्मै’ आदेशः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.12", "to_sutra": "7.1.14"}}, {"sutra_id": "7.3.113", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "आबन्तात् न-सर्वनाम्नः परे ङिति ङे याट्-आगमः; अङ्गे ह्रस्वो न भवति।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.14", "to_sutra": "7.3.113"}}, {"sutra_id": "7.3.114", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "आबन्तात् सर्वनाम्नः परे ङिति सुपि स्याट्-आगमः, अङ्गस्य च ह्रस्वः; ततः वृद्धिः (६.१.८८) इति क्रमः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.3.113", "to_sutra": "7.3.114"}}, {"sutra_id": "7.1.13", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "अदन्त-अङ्गात् परस्य ङे-प्रत्ययस्य 'य'-आदेशः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.3.114", "to_sutra": "7.1.13"}}, {"sutra_id": "7.1.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "अदन्त-अङ्गात् परस्य 'भिस्'-प्रत्ययस्य 'ऐस्'-आदेशः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.13", "to_sutra": "7.1.9"}}, {"sutra_id": "7.1.17", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "अदन्त-सर्वनाम-अङ्गात् परस्य जस्-प्रत्ययस्य ‘शी’-आदेशः (सर्वे)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.9", "to_sutra": "7.1.17"}}, {"sutra_id": "7.1.24", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "अकारान्त-नपुंसक-अङ्गात् परस्य सुँ/अम्-प्रत्ययस्य ‘अम्’-आदेशः (ज्ञानम्)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.17", "to_sutra": "7.1.24"}}, {"sutra_id": "7.1.19", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "नपुंसक-अङ्गात् परस्य औ/औट्-प्रत्ययस्य ‘शी’-आदेशः (ज्ञाने)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.24", "to_sutra": "7.1.19"}}, {"sutra_id": "7.1.20", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "नपुंसक-अङ्गात् परयोः जस्/शस्-प्रत्यययोः ‘शि’-आदेशः (ज्ञानानि)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.19", "to_sutra": "7.1.20"}}, {"sutra_id": "7.1.23", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sAmanyas", "form_after": "sAmanyas", "why_dev": "नप