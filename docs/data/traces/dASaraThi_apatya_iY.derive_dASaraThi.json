{"module": "pipelines.dASaraThi_apatya_iY", "callable": "derive_dASaraThi", "ok": true, "smoke_note": null, "invocation": {"args": [], "kwargs": {}}, "result_kind": "state", "final_flat_slp1": "dASaraTi", "phase": "angakarya", "tripadi_zone": false, "trace_len": 19, "trace": [{"sutra_id": "4.1.82", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "daSaraTa", "form_after": "daSaraTa", "why_dev": "अर्थज्ञापकसूत्रे समर्थेषु यः प्रथमः पदार्थः, तेन निर्दिष्टात् पदात् परः तद्धितः विकल्पेन (महाभाष्य-सामर्थ्यम्, कृतसंधिकार्यपरम्) — ४.१.८२ तः ५.२.१४० पर्यन्तं समर्थाधिकारः; ४.१.८१ तः अन्यतरस्याम् अनुवृत्तिः।", "status": "AUDIT", "chronological_transition": {"from_sutra": null, "to_sutra": "4.1.82"}}, {"sutra_id": "4.1.92", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "daSaraTa", "form_after": "daSaraTa", "why_dev": "प्राग्दीव्यतीयः शेषाधिकारः — ४.१.९२ तः ४.३.१२० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "4.1.82", "to_sutra": "4.1.92"}}, {"sutra_id": "4.1.95", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "daSaraTa", "form_after": "daSaraTaiY", "why_dev": "(सूत्रम् 4.1.95) अत इञ्।", "status": "APPLIED", "chronological_transition": {"from_sutra": "4.1.92", "to_sutra": "4.1.95"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "daSaraTaiY", "form_after": "daSaraTaiY", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "4.1.95", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.8", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "daSaraTaiY", "form_after": "daSaraTaiY", "why_dev": "अतद्धिते प्रत्ययादौ ल्-श्-कु-वर्णानाम् इत्-संज्ञा; लोपः १.३.९। सुप्-पङ्क्तिषु ङ्-आदिर् अपि (*N* ∈ *ku*)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.8"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "daSaraTaiY", "form_after": "daSaraTai", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.8", "to_sutra": "1.3.9"}}, {"sutra_id": "1.3.10", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "daSaraTai", "form_after": "daSaraTai", "why_dev": "द्वयोः समसङ्ख्यक-गणयोः मध्ये अनुदेशः यदा, तदा सः सदस्येषु क्रमेण — यथा ६.१.७८ (ए→अय्, ऐ→आय्), ३.१.१३४ (ल्यु्-णिनि-अच्), १.१.४६ (टित्-कित्)। असमसङ्ख्ये (८.२.३९) न; अन्तरतमम् १.१.५० आदि।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "1.3.10"}}, {"sutra_id": "1.4.13", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "daSaraTai", "form_after": "daSaraTai", "why_dev": "प्रत्यय-विधेर् यस्मात् तदादि प्रत्यये यत् तद् अङ्गम्।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.10", "to_sutra": "1.4.13"}}, {"sutra_id": "6.4.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "daSaraTai", "form_after": "daSaraTai", "why_dev": "६.४.१ तः ७.४.९७ पर्यन्तानि सूत्राणि अङ्गस्य विधयः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.4.13", "to_sutra": "6.4.1"}}, {"sutra_id": "1.1.1", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "daSaraTai", "form_after": "daSaraTai", "why_dev": "आ-ऐ-औ इति वृद्धि-संज्ञा (अधिकार-बद्धा न, सर्वत्र उपलब्धा)। अनया केवल वर्ण-समूहस्य निर्देशः — पदेषु स्वतः परिवर्तनं न। वृद्धि-प्रयोगः तु यदा विधि-सूत्रेषु (यथा ६.१.८८) प्रसङ्गः, तदा। अष्टाध्याय्यां 'वृद्धि' इयं संज्ञा नवसु सूत्रेषु साक्षात्, अन्यत्र अनुवृत्त्या च।", "status": "APPLIED", "why_now_dev": "आ, ऐ, औ — एते वर्णाः 'वृद्धि'-संज्ञां प्राप्नुवन्ति; इयं संज्ञा वृद्धि-विधिषु (यथा ६.१.८८ वृद्धिरेचि, ७.२.१ सिचि वृद्धिः) उपयुज्यते। (१.१.१)", "chronological_transition": {"from_sutra": "6.4.1", "to_sutra": "1.1.1"}}, {"sutra_id": "1.1.3", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "daSaraTai", "form_after": "daSaraTai", "why_dev": "यत्र गुण-वृद्धी उत्सर्गतः, न च स्थानी षष्ठ्यन्तं निर्दिष्टः, तत्र स्थानी इक्-वर्ण एव; अत्र तत्-परिभाषा-द्वारा निश्चयः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.1", "to_sutra": "1.1.3"}}, {"sutra_id": "1.1.4", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "daSaraTai", "form_after": "daSaraTai", "why_dev": "आर्धधातुके क्षेपे सति यदि धातु-लोपः, तदा १.१.३-वर्णितः इक-स्थानिन्-नियमो गुण-वृद्धि-क्रियायै न प्रवर्तते।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.3", "to_sutra": "1.1.4"}}, {"sutra_id": "1.1.5", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "daSaraTai", "form_after": "daSaraTai", "why_dev": "क्‍ङ्-परिच्छिन्ने प्रत्यय-क्षेपे, तस्मिन् आङ्ग-कार्ये, यः १.१.३-उत्सर्ग-इक-नियमः, सो न।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.4", "to_sutra": "1.1.5"}}, {"sutra_id": "1.1.6", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "daSaraTai", "form_after": "daSaraTai", "why_dev": "इडागम-इकारस्य गुणनिषेधः (परिभाषा-गेट)।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.5", "to_sutra": "1.1.6"}}, {"sutra_id": "1.1.50", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "daSaraTai", "form_after": "daSaraTai", "why_dev": "आदेश-चयनस्य परिभाषा — स्थाने (उच्चारण-स्थान-प्रयत्नादि-साम्ये) अन्तरतमः विकल्प्यते।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.6", "to_sutra": "1.1.50"}}, {"sutra_id": "7.2.117", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "daSaraTai", "form_after": "dASaraTai", "why_dev": "णित्/ञित्-तद्धित-प्रत्यये परे अङ्गस्य आद्य-अचः वृद्धिः (दक्ष+इञ्→दाक्ष, शीत+ष्यञ्→शैत, सोम+ट्यण्→सौम)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.1.50", "to_sutra": "7.2.117"}}, {"sutra_id": "6.4.129", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "dASaraTai", "form_after": "dASaraTai", "why_dev": "भाधिकारः — ६.४.१२९ तः ६.४.१७५ पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "7.2.117", "to_sutra": "6.4.129"}}, {"sutra_id": "6.4.148", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "dASaraTai", "form_after": "dASaraTi", "why_dev": "भाधिकारे इत्यादौ परे अङ्गान्त्यस्य अ/इ-वर्णस्य लोपः।", "status": "APPLIED", "chronological_transition": {"from_sutra": "6.4.129", "to_sutra": "6.4.148"}}, {"sutra_id": "1.1.60", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "dASaraTi", "form_after": "dASaraTi", "why_dev": "स्थानिनि वर्णः वा वर्णसमूहः वा अदर्शनं यत्, तत् 'लोप' इति संज्ञा — उपयोगः १.३.९, ८.२.२३, ६.१.६८, … इतिषु; अत्र केवल संज्ञा-निर्णयः।", "status": "APPLIED", "why_now_dev": "स्थाने वर्णस्य वर्णसमूहस्य वा अदर्शनं 'लोप'-संज्ञां प्राप्नोति; अनया संज्ञया उत्तर-विधयः (यथा १.३.९ इत्-लोपः) प्रवर्तन्ते। (१.१.६०)", "chronological_transition": {"from_sutra": "6.4.148", "to_sutra": "1.1.60"}}]}