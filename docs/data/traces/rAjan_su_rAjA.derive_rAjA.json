{"module": "pipelines.rAjan_su_rAjA", "callable": "derive_rAjA", "ok": true, "smoke_note": null, "invocation": {"args": [], "kwargs": {}}, "result_kind": "state", "final_flat_slp1": "rAjA", "phase": "angakarya", "tripadi_zone": true, "trace_len": 11, "trace": [{"sutra_id": "1.2.46", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAjan", "form_after": "rAjan", "why_dev": "कृत्-तद्धित-समासान्ताः शब्दाः प्रातिपदिक-संज्ञकाः।", "status": "APPLIED", "chronological_transition": {"from_sutra": null, "to_sutra": "1.2.46"}}, {"sutra_id": "4.1.2", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "rAjan", "form_after": "rAjansu", "why_dev": "एकविंशति सुप्-प्रत्ययाः क्रमेण प्रातिपदिकात् विधीयन्ते; अधिकारः ४.१.२ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.2.46", "to_sutra": "4.1.2"}}, {"sutra_id": "1.3.2", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAjansu", "form_after": "rAjansu", "why_dev": "उपदेशावस्थायाम् अज् वर्णः अनुनासिकः चेद् इत्-संज्ञकः; इँर्-वार्तिके पुनः द्वयोः संयुक्तः इत्। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "4.1.2", "to_sutra": "1.3.2"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAjansu", "form_after": "rAjans", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.2", "to_sutra": "1.3.9"}}, {"sutra_id": "1.1.43", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAjans", "form_after": "rAjans", "why_dev": "सु-प्रत्ययः (नपुंसकाद् भिन्नः) सर्वनामस्थान-संज्ञकः।", "status": "APPLIED", "why_now_dev": "अनपुंसक (पुं/स्त्री) प्रातिपदिकस्य सुँ-आदिः सर्वनामस्थान-सुप् 'सर्वनामस्थान'-संज्ञां प्राप्नोति; अनया संज्ञया अङ्ग-कार्याणि (यथा ७.१.७० नुम्) प्रवर्तन्ते। (१.१.४३)", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "1.1.43"}}, {"sutra_id": "6.4.8", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAjans", "form_after": "rAjAns", "why_dev": "असम्बुद्धि-सर्वनामस्थाने परे नपुंसक-अङ्गस्य उपधा-अकारस्य दीर्घः (ज्ञानानि)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.1.43", "to_sutra": "6.4.8"}}, {"sutra_id": "1.2.41", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAjAns", "form_after": "rAjAns", "why_dev": "एक-हल्-प्रत्ययः अपृक्त-संज्ञकः (ईट्-आगम ७.३.९६ इत्यादि-प्रसङ्गे)।", "status": "APPLIED", "why_now_dev": "एक-अल् (एक-वर्ण) प्रत्ययः 'अपृक्त'-संज्ञां प्राप्नोति; अनया संज्ञया ईट्-आगम-आदि-विधयः (यथा ७.३.९६) प्रवर्तन्ते। (१.२.४१)", "chronological_transition": {"from_sutra": "6.4.8", "to_sutra": "1.2.41"}}, {"sutra_id": "6.1.68", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAjAns", "form_after": "rAjAn", "why_dev": "हल्-अन्तात् / ङी-आभ्-अन्तात् दीर्घात् अङ्गात् परस्य अपृक्त-सु-हल्-लोपः।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.2.41", "to_sutra": "6.1.68"}}, {"sutra_id": "__MERGE__", "sutra_type": "STRUCTURAL", "type_label": "पद-मेलनम्", "form_before": "rAjAn", "form_after": "rAjAn", "why_dev": "पद-रचना — सर्व-धातु/सुबन्त/कृदन्त-संयोजनम् (संरचनात्मकं, न सूत्रम्)।", "status": "APPLIED", "event": "MERGE"}, {"sutra_id": "8.2.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "rAjAn", "form_after": "rAjAn", "why_dev": "८.२.१ तः ८.४.६८ पर्यन्तम् (त्रिपादी) पूर्व-सूत्रेभ्यः असिद्धम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "6.1.68", "to_sutra": "8.2.1"}}, {"sutra_id": "8.2.7", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAjAn", "form_after": "rAjA", "why_dev": "प्रातिपदिकान्त्यवर्णे नकारस्य लोपः (चेता-पथ)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "8.2.1", "to_sutra": "8.2.7"}}]}