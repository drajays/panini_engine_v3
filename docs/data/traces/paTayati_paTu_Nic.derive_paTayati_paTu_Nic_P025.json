: "लकार-प्रत्ययस्य स्थाने तिङ्-आदेश (तिप्-तस्-झि-…-महिङ्) — संज्ञाः १.४.९९ इत्यादि-सूत्रैः पृथक्; सूत्रे अभिकल्पित-तिङ्-लक्ष्यम्, न पुरुष-वचन-परिगणनम् (CONSTITUTION २)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "3.4.77", "to_sutra": "3.4.78"}}, {"sutra_id": "3.1.68", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "paTitip", "form_after": "paTiSaptip", "why_dev": "कर्तरि सार्वधातुके परे विकरण-शप्-आगमः; अपवादाः ३.१.६९ इत्यादौ पृथक्।", "status": "APPLIED", "chronological_transition": {"from_sutra": "3.4.78", "to_sutra": "3.1.68"}}, {"sutra_id": "1.3.8", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "paTiSaptip", "form_after": "paTiSaptip", "why_dev": "अतद्धिते प्रत्ययादौ ल्-श्-कु-वर्णानाम् इत्-संज्ञा; लोपः १.३.९। सुप्-पङ्क्तिषु ङ्-आदिर् अपि (*N* ∈ *ku*)।", "status": "APPLIED", "why_now_dev": "अतद्धित-प्रत्ययस्य आदौ ल्/श्/कवर्ग-वर्णः 'इत्'-संज्ञां प्राप्नोति; अयं वर्णः अनन्तरं १.३.९ इति लुप्यते (यथा शप् → अ, ङी → ई)। (१.३.८)", "chronological_transition": {"from_sutra": "3.1.68", "to_sutra": "1.3.8"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "paTiSaptip", "form_after": "paTiaptip", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.8", "to_sutra": "1.3.9"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "paTiaptip", "form_after": "paTiaptip", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "paTiaptip", "form_after": "paTiati", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.9"}}, {"sutra_id": "7.3.84", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "paTiati", "form_after": "paTeati", "why_dev": "अङ्गान्तिकः गुणः — धातोः परतरं सार्वधातुके वा आर्धधातुके वा (तिङ्-शित्-सूची, तृच्-आदि)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "7.3.84"}}, {"sutra_id": "6.1.78", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "paTeati", "form_after": "paTayati", "why_dev": "एचः (ए, ऐ, ओ, औ) स्थाने परे अचि क्रमेण अय्, अव्, आय्, आव् आदेशः (एचोऽयवायावः) — ओस्-विषयकः पूर्वे य्-आगम-वर्णनम् अत्रानुपयुक्तम्। अत्र यथा अङ्गान्ते एच्-वर्णः \"e\" (गुणात्) + परे अच् \"a\" (विकरणादादौ) → \"e\"+\"a\" → \"a\"+\"y\"+\"a\" (अय्) → je+a+… → jay+a+… → jayati। अपरः प्रसङ्गः: अदन्त-अङ्ग + \"ओस्\"-प्रत्यय (a+o) पूर्वे \"य्\"-आगमः।", "status": "APPLIED", "why_now_dev": "अच्-वर्णे परे एच्-वर्णस्य (ए/ऐ/ओ/औ) क्रमेण अय्/आय्/अव्/आव् इति आदेशः; यथा ए+अ → अय् (जे+अ → जय → जयति)। (६.१.७८)", "chronological_transition": {"from_sutra": "7.3.84", "to_sutra": "6.1.78"}}, {"sutra_id": "1.1.68", "sutra_type": "ANUVADA", "type_label": "अनुवाद", "form_before": "paTayati", "form_after": "paTayati", "why_dev": "शब्दः स्व-रूप-पर्यायः (अशब्द-संज्ञा-अपवादः) — डेमो-आडिट्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "6.1.78", "to_sutra": "1.1.68"}}]}