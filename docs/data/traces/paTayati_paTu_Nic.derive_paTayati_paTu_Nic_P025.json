{"module": "pipelines.paTayati_paTu_Nic", "callable": "derive_paTayati_paTu_Nic_P025", "ok": true, "smoke_note": null, "invocation": {"args": [], "kwargs": {}}, "result_kind": "state", "final_flat_slp1": "paTayati", "phase": "angakarya", "tripadi_zone": false, "trace_len": 27, "trace": [{"sutra_id": "1.1.68", "sutra_type": "ANUVADA", "type_label": "अनुवाद", "form_before": "paTu", "form_after": "paTu", "why_dev": "शब्दः स्व-रूप-पर्यायः (अशब्द-संज्ञा-अपवादः) — डेमो-आडिट्।", "status": "AUDIT", "chronological_transition": {"from_sutra": null, "to_sutra": "1.1.68"}}, {"sutra_id": "1.2.45", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "paTu", "form_after": "paTu", "why_dev": "धातु-प्रत्यय-प्रत्ययान्त-वर्जितम् अर्थवच्छब्दरूपं प्रातिपदिकसंज्ञकम्।", "status": "APPLIED", "why_now_dev": "अर्थवत्-शब्दरूपं धातु-प्रत्यय-प्रत्ययान्त-वर्जितम् इति प्रातिपदिक-संज्ञां लभते (अव्युत्पन्न-प्रातिपदिकम्)। (१.२.४५)", "chronological_transition": {"from_sutra": "1.1.68", "to_sutra": "1.2.45"}}, {"sutra_id": "4.1.2", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "paTu", "form_after": "paTuam", "why_dev": "एकविंशति सुप्-प्रत्ययाः क्रमेण प्रातिपदिकात् विधीयन्ते; अधिकारः ४.१.२ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.2.45", "to_sutra": "4.1.2"}}, {"sutra_id": "2.1.26", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "paTuam", "form_after": "paTuRic", "why_dev": "पटु-प्रातिपदिकात् परे णिच्-प्रत्ययः (P025 *tat-karoti tad-ācaṣṭe* डेमो)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "4.1.2", "to_sutra": "2.1.26"}}, {"sutra_id": "1.3.7", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "paTuRic", "form_after": "paTuRic", "why_dev": "चवर्ग-टवर्गीयः प्रथमः हल् ‘इत्’ संज्ञकः; लोपः १.३.९।", "status": "APPLIED", "why_now_dev": "उपदेशे प्रत्ययस्य आदौ चवर्ग-टवर्गीयः प्रथमः हल् 'इत्'-संज्ञां प्राप्नोति; अयं वर्णः अनन्तरं १.३.९ इति लुप्यते (यथा ण्यत्, ण्वुल्, ण्यन्तर्गत-ण्)। (१.३.७