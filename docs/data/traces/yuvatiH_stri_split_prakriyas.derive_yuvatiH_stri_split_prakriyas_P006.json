i", "yuvan"], ["ti", "pratyaya", "tip"]], "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.9"}}, {"sutra_id": "6.4.134", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "yuvanti", "form_after": "yuvati", "why_dev": "भसंज्ञके नान्ते उपधायाः अकारस्य लोपः (उदा. राजन् + शस्)।", "status": "APPLIED", "parts": [["yuva", "prakriti", "yuvan"], ["ti", "pratyaya", "tip"]], "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "6.4.134"}}, {"sutra_id": "1.2.46", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "yuvati", "form_after": "yuvati", "why_dev": "कृत्-तद्धित-समासान्ताः शब्दाः प्रातिपदिक-संज्ञकाः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.4.134", "to_sutra": "1.2.46"}}, {"sutra_id": "__MERGE__", "sutra_type": "STRUCTURAL", "type_label": "पद-मेलनम्", "form_before": "yuvati", "form_after": "yuvati", "why_dev": "पद-रचना — सर्व-धातु/सुबन्त/कृदन्त-संयोजनम् (संरचनात्मकं, न सूत्रम्)।", "status": "APPLIED", "event": "MERGE"}, {"sutra_id": "4.1.2", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "yuvati", "form_after": "yuvatisu~", "why_dev": "एकविंशति सुप्-प्रत्ययाः क्रमेण प्रातिपदिकात् विधीयन्ते; अधिकारः ४.१.२ तः ५.४.१६० पर्यन्तम्।", "status": "APPLIED", "parts": [["yuvati", "pada", ""], ["su~", "sup", "s~"]], "chronological_transition": {"from_sutra": "1.2.46", "to_sutra": "4.1.2"}}, {"sutra_id": "1.3.2", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "yuvatisu~", "form_after": "yuvatisu~", "why_dev": "उपदेशावस्थायाम् अज् वर्णः अनुनासिकः चेद् इत्-संज्ञकः; इँर्-वार्तिके पुनः द्वयोः संयुक्तः इत्। लोपः १.३.९।", "status": "APPLIED", "parts": [["yuvati", "pada", ""], ["su~", "sup", "s~"]], "chronological_transition": {"from_sutra": "4.1.2", "to_sutra": "1.3.2"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "yuvatisu~", "form_after": "yuvatisu~", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; त