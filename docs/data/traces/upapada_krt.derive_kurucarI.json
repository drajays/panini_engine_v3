3", "to_sutra": "3.2.16"}}, {"sutra_id": "2.2.19", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "kuruNicarwa", "form_after": "kuruNicarwa", "why_dev": "उपपद-समासार्थं संज्ञा-अनुमोदनम् (प्रक्रिया-२२)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "3.2.16", "to_sutra": "2.2.19"}}, {"sutra_id": "1.2.46", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "kuruNicarwa", "form_after": "kuruNicarwa", "why_dev": "कृत्-तद्धित-समासान्ताः शब्दाः प्रातिपदिक-संज्ञकाः।", "status": "APPLIED", "chronological_transition": {"from_sutra": "2.2.19", "to_sutra": "1.2.46"}}, {"sutra_id": "2.4.71", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "kuruNicarwa", "form_after": "kurucarwa", "why_dev": "धातु/प्रातिपदिक-अवयवे विद्यमानस्य सुपः लुक् (आर्म्ड-मेटा)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.2.46", "to_sutra": "2.4.71"}}, {"sutra_id": "1.3.7", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "kurucarwa", "form_after": "kurucarwa", "why_dev": "चवर्ग-टवर्गीयः प्रथमः हल् ‘इत्’ संज्ञकः; लोपः १.३.९।", "status": "APPLIED", "why_now_dev": "उपदेशे प्रत्ययस्य आदौ चवर्ग-टवर्गीयः प्रथमः हल् 'इत्'-संज्ञां प्राप्नोति; अयं वर्णः अनन्तरं १.३.९ इति लुप्यते (यथा ण्यत्, ण्वुल्, ण्यन्तर्गत-ण्)। (१.३.७)", "chronological_transition": {"from_sutra": "2.4.71", "to_sutra": "1.3.7"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "kurucarwa", "form_after": "kurucara", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.7", "to_sutra": "1.3.9"}}, {"sutra_id": "__MERGE__", "sutra_type": "STRUCTURAL", "type_label": "उपपद-कुरुचर", "form_before": "kurucara", "form_after": "kurucara", "why_dev": "कुरु + चर् + ट्-शेष → कुरुचर।", "status": "APPLIED"}, {"sutra_id": "1.2.46", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "kurucara", "form_after": "kurucara", "why_dev": "कृत्-तद्धित-समासान्ताः शब्दाः प्रातिपदिक-संज्ञकाः।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "1.2.46"}}, {"sutra_id": "4.1.15", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "kurucara", "form_after": "kurucaraNIp", "why_dev": "टितः कृतः स्त्रियां ङीप् (प००५-अ, संक्षिप्तम्)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.2.46", "to_sutra": "4.1.15"}}, {"sutra_id": "1.3.8", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "kurucaraNIp", "form_after": "kurucaraNIp", "why_dev": "अतद्धिते प्रत्ययादौ ल्-श्-कु-वर्णानाम् इत्-संज्ञा; लोपः १.३.९। सुप्-पङ्क्तिषु ङ्-आदिर् अपि (*N* ∈ *ku*)।", "status": "APPLIED", "why_now_dev": "अतद्धित-प्रत्ययस्य आदौ ल्/श्/कवर्ग-वर्णः 'इत्'-संज्ञां प्राप्नोति; अयं वर्णः अनन्तरं १.३.९ इति लुप्यते (यथा शप् → अ, ङी → ई)। (१.३.८)", "chronological_transition": {"from_sutra": "4.1.15", "to_sutra": "1.3.8"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "kurucaraNIp", "form_after": "kurucaraNIp", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.8", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "kurucaraNIp", "form_after": "kurucaraI", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.9"}}, {"sutra_id": "6.4.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "kurucaraI", "f