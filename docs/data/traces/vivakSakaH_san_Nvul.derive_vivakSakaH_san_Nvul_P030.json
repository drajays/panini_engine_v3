ra": "6.1.15"}}, {"sutra_id": "1.1.45", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "vacis", "form_after": "uacis", "why_dev": "यण्-वर्णस्य (य्/व्/र्/ल्) इक्-वर्णे (इ/उ/ऋ/ऌ) सम्प्रसारणम् — यथासंख्येन।", "status": "AUDIT", "chronological_transition": {"from_sutra": "6.1.15", "to_sutra": "1.1.45"}}, {"sutra_id": "6.1.108", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "uacis", "form_after": "ucis", "why_dev": "सम्प्रसारण-वर्णात् परस्य अचः पूर्वरूप-एकादेशः (उ+अ→उ इत्यादि)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.1.45", "to_sutra": "6.1.108"}}, {"sutra_id": "6.1.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "ucis", "form_after": "ucucis", "why_dev": "द्वित्वाधिकारः — ६.१.१ तः ६.१.१२ पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "6.1.108", "to_sutra": "6.1.1"}}, {"sutra_id": "6.1.4", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "ucucis", "form_after": "ucucis", "why_dev": "द्वित्व-प्रसङ्गे पूर्वभागः अभ्यास-संज्ञकः (ग्लास-बॉक्स् gate)।", "status": "AUDIT", "chronological_transition": {"from_sutra": "6.1.1", "to_sutra": "6.1.4"}}, {"sutra_id": "6.4.16", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "ucucis", "form_after": "ucUcs", "why_dev": "सनि परे अङ्गस्य दीर्घः — चिचीषति (द्वित्वोत्तर-अङ्ग-स्थाने)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "6.1.4", "to_sutra": "6.4.16"}}, {"sutra_id": "7.4.60", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "ucUcs", "form_after": "uUcs", "why_dev": "अभ्यासे हलादिः एव शेषः (ग्लास-बॉक्स्: द्वित्व-प्रकरणे); प०३७ च ``Iw``→``I``।", "status": "APPLIED", "chronological_transition": {"from_sutra": "6.4.16", "to_sutra": "7.4.60"}}, {"sutra_id": "6.1.77", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "uUcs", "form_after": "vUcs", "why_dev": "इक्-समाप्तेः परे अच्-आदौ यण्-आदेशः — सार्वत्रिकः उत्सर्गः; प्राग्र्ह्य-वर्ज्यम् (१.१.११); अपवादाः यथायोग्यम् (६.१.१०१ इत्यादि)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "7.4.60", "to_sutra": "6.1.77"}}, {"sutra_id": "__MERGE__", "sutra_type": "STRUCTURAL", "type_label": "पद-मेलनम्", "form_before": "vUcs", "form_after": "vUcs", "why_dev": "पद-रचना — सर्व-धातु/सुबन्त/कृदन्त-संयोजनम् (संरचनात्मकं, न सूत्रम्)।", "status": "APPLIED", "event": "MERGE"}, {"sutra_id": "6.1.112", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vUcs", "form_after": "vivacs", "why_dev": "वच्+सन्-मध्यावस्था → विवक्ष्-प्रत्यया-pूर्व आकारः (प०३०)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "6.1.77", "to_sutra": "6.1.112"}}, {"sutra_id": "8.2.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "vivacs", "form_after": "vivacs", "why_dev": "८.२.१ तः ८.४.६८ पर्यन्तम् (त्रिपादी) पूर्व-सूत्रेभ्यः असिद्धम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "6.1.112", "to_sutra": "8.2.1"}}, {"sutra_id": "8.2.30", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vivacs", "form_after": "vivaks", "why_dev": "झलि/पदान्ते परे च-वर्णस्य क-वर्णादेशः (उक्त-उपपत्ति)। प००३-ए: त्रिपादी-प्रवेशात् पूर्वम् अनुमतम्।", "status": "APPLIED", "chronological_transition": {"from_sutra": "8.2.1", "to_sutra": "8.2.30"}}, {"sutra_id": "8.3.46", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vivaks", "form_after": "vivakS", "why_dev": "जिघृक्षति-प्रसङ्गे क्+स् → क्+ष् (डेमो-slice)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "8.2.30", "to_sutra": "8.3.46"}}, {"sutra_id": "3.1.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "vivakS", "form_after": "vivakS", "why_dev": "अधिकारः प्रत्यय-विधानम् — ३.१.१ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "8.3.46", "to_sutra": "3.1.1"}}, {"sutra_id": "3.1.2", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "vivakS", "form_after": "vivakS", "why_dev": "प्रत्ययः निमित्तात् परः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.1", "to_sutra": "3.1.2"}}, {"sutra_id": "3.1.3", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "vivakS", "form_after": "vivakS", "why_dev": "प्रत्ययस्य आद्युदात्तत्वम् — अधिकारः ३.१.३ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.2", "to_sutra": "3.1.3"}}, {"sutra_id": "3.1.91", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "vivakS", "form_after": "vivakS", "why_dev": "धातोः कृत्-तिङ्-प्रत्ययाः — अधिकारः ३.१.९१ तः ३.४.११७ पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.3", "to_sutra": "3.1.91"}}, {"sutra_id": "3.4.67", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "vivakS", "form_after": "vivakS", "why_dev": "कर्तरि अर्थे कृत्-प्रत्ययानां विधानम् — अधिकारः ३.४.६७ तः ३.४.११७ पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.91", "to_sutra": "3.4.67"}}, {"sutra_id": "3.1.133", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vivakS", "form_after": "vivakSRvul", "why_dev": "कर्तरि अर्थे धातोः ण्वुल्-प्रत्ययः (पाचक इत्यादि)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "3.4.67", "to_sutra": "3.1.133"}}, {"sutra_id": "1.3.8", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "vivakSRvul", "form_after": "vivakSRvul", "why_dev": "अतद्धिते प्रत्ययादौ ल्-श्-कु-वर्णानाम् इत्-संज्ञा; लोपः १.३.९। सुप्-पङ्क्तिषु ङ्-आदिर् अपि (*N* ∈ *ku*)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "3.1.133", "to_sutra": "1.3.8"}}, {"sutra_id": "1.3.7", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "vivakSRvul", "form_after": "vivakSRvul", "why_dev": "चवर्ग-टवर्गीयः प्रथमः हल् ‘इत्’ संज्ञकः; लोपः १.३.९।", "status": "APPLIED", "why_now_dev": "उपदेशे प्रत्ययस्य आदौ चवर्ग-टवर्गीयः प्रथमः हल् 'इत्'-संज्ञां प्राप्नोति; अयं वर्णः अनन्तरं १.३.९ इति लुप्यते (यथा ण्यत्, ण्वुल्, ण्यन्तर्गत-ण्)। (१.३.७)", "chronological_transition": {"from_sutra": "1.3.8", "to_sutra": "1.3.7"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "vivakSRvul", "form_after": "vivakSRvul", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.7", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vivakSRvul", "form_after": "vivakSvu", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.9"}}, {"sutra_id": "7.1.1", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vivakSvu", "form_after": "vivakSak", "why_dev": "‘यु’-‘वु’-स्थाने ‘अन्’-‘अक्’ आदेशः (ण्वुल् / ल्युट् इति संकीर्णम्)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "7.1.1"}}, {"sutra_id": "1.4.13", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "vivakSak", "form_after": "vivakSak", "why_dev": "प्रत्यय-विधेर् यस्मात् तदादि प्रत्यये यत् तद् अङ्गम्।", "status": "APPLIED", "why_now_dev": "प्रत्ययात् पूर्वं स्थितः अवयवः अङ्ग-संज्ञकः (प्रत्यये परतः अङ्गम्); अनेन अङ्ग-अधिकार-कार्याणि (६.४.१ आदि) प्रसजन्ति। (१.४.१३)", "chronological_transition": {"from_sutra": "7.1.1", "to_sutra": "1.4.13"}}, {"sutra_id": "1.1.65", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "vivakSak", "form_after": "vivakSak", "why_dev": "अन्त्याल्-वर्णात् पूर्वः वर्णः उपधा-संज्ञकः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.4.13", "to_sutra": "1.1.65"}}, {"sutra_id": "6.4.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "vivakSak", "form_after": "vivakSak", "why_dev": "६.४.१ तः ७.४.९७ पर्यन्तानि सूत्राणि अङ्गस्य विधयः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.65", "to_sutra": "6.4.1"}}, {"sutra_id": "7.2.116", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vivakSak", "form_after": "vivakSak", "why_dev": "णित्-प्रत्यये परे धातोः उपधास्थ-अकारस्य वृद्धि (पच् → पाच्)।", "status": "BLOCKED", "gate_reason": "PRATISHEDHA-BLOCKED", "chronological_transition": {"from_sutra": "6.4.1", "to_sutra": "7.2.116"}}, {"sutra_id": "7.2.115", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vivakSak", "form_after": "vivakSak", "why_dev": "ञित्/णिति-परे अङ्गान्त्यचः वृद्धिः (णीञ्+ण्वुल् → नै/नायक)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.2.116", "to_sutra": "7.2.115"}}, {"sutra_id": "6.1.78", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vivakSak", "form_after": "vivakSak", "why_dev": "एचः (ए, ऐ, ओ, औ) स्थाने परे अचि क्रमेण अय्, अव्, आय्, आव् आदेशः (एचोऽयवायावः) — ओस्-विषयकः पूर्वे य्-आगम-वर्णनम् अत्रानुपयुक्तम्। अत्र यथा अङ्गान्ते एच्-वर्णः \"e\" (गुणात्) + परे अच् \"a\" (विकरणादादौ) → \"e\"+\"a\" → \"a\"+\"y\"+\"a\" (अय्) → je+a+… → jay+a+… → jayati। अपरः प्रसङ्गः: अदन्त-अङ्ग + \"ओस्\"-प्रत्यय (a+o) पूर्वे \"य्\"-आगमः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.2.115", "to_sutra": "6.1.78"}}, {"sutra_id": "6.1.77", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vivakSak", "form_after": "vivakSak", "why_dev": "इक्-समाप्तेः परे अच्-आदौ यण्-आदेशः — सार्वत्रिकः उत्सर्गः; प्राग्र्ह्य-वर्ज्यम् (१.१.११); अपवादाः यथायोग्यम् (६.१.१०१ इत्यादि)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.78", "to_sutra": "6.1.77"}}, {"sutra_id": "1.2.45", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "vivakSak", "form_after": "vivakSak", "why_dev": "धातु-प्रत्यय-प्रत्ययान्त-वर्जितम् अर्थवच्छब्दरूपं प्रातिपदिकसंज्ञकम्।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.77", "to_sutra": "1.2.45"}}, {"sutra_id": "1.2.46", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "vivakSak", "form_after": "vivakSak", "why_dev": "कृत्-तद्धित-समासान्ताः शब्दाः प्रातिपदिक-संज्ञकाः।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.2.45", "to_sutra": "1.2.46"}}, {"sutra_id": "__KRD_MERGE__", "sutra_type": "STRUCTURAL", "type_label": "कृदन्त-मेलनम्", "form_before": "vivakSak", "form_after": "vivakSaka", "why_dev": "धातु + कृत्-प्रत्ययः → प्रातिपदिकम् (संरचनात्मकं, न सूत्रम्)।", "status": "APPLIED"}, {"sutra_id": "__MERGE__", "sutra_type": "STRUCTURAL", "type_label": "पद-मेलनम्", "form_before": "vivakSaka", "form_after": "vivakSaka", "why_dev": "पद-रचना — सर्व-धातु/सुबन्त/कृदन्त-संयोजनम् (संरचनात्मकं, न सूत्रम्)।", "status": "APPLIED", "event": "MERGE"}, {"sutra_id": "4.1.2", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "vivakSaka", "form_after": "vivakSakasu", "why_dev": "एकविंशति सुप्-प्रत्ययाः क्रमेण प्रातिपदिकात् विधीयन्ते; अधिकारः ४.१.२ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.2.46", "to_sutra": "4.1.2"}}, {"sutra_id": "1.3.2", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "vivakSakasu", "form_after": "vivakSakasu", "why_dev": "उपदेशावस्थायाम् अज् वर्णः अनुनासिकः चेद् इत्-संज्ञकः; इँर्-वार्तिके पुनः द्वयोः संयुक्तः इत्। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "4.1.2", "to_sutra": "1.3.2"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vivakSakasu", "form_after": "vivakSakas", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.2", "to_sutra": "1.3.9"}}, {"sutra_id": "__MERGE__", "sutra_type": "STRUCTURAL", "type_label": "पद-मेलनम्", "form_before": "vivakSakas", "form_after": "vivakSakas", "why_dev": "पद-रचना — सर्व-धातु/सुबन्त/कृदन्त-संयोजनम् (संरचनात्मकं, न सूत्रम्)।", "status": "APPLIED", "event": "MERGE"}, {"sutra_id": "8.2.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "vivakSakas", "form_after": "vivakSakas", "why_dev": "८.२.१ तः ८.४.६८ पर्यन्तम् (त्रिपादी) पूर्व-सूत्रेभ्यः असिद्धम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "8.2.1"}}, {"sutra_id": "8.2.23", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vivakSakas", "form_after": "vivakSakas", "why_dev": "संयोगान्त-पदस्य अन्त्य-हल्-लोपः (चितवान्)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.1", "to_sutra": "8.2.23"}}, {"sutra_id": "8.2.39", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vivakSakas", "form_after": "vivakSakas", "why_dev": "पदान्ते झल्-व्यञ्जनस्य स्थाने जश्-व्यञ्जनः (सूत्रम् ८.२.३९ झलां जशोऽन्ते) — त् → द्।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.23", "to_sutra": "8.2.39"}}, {"sutra_id": "8.2.66", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vivakSakas", "form_after": "vivakSakar", "why_dev": "पदान्त-सकारस्य सजुषः च रु-आदेशः (त्रिपादी)।", "status": "APPLIED", "why_now_dev": "पदान्त-सकारस्य 'रु'-आदेशः (त्रिपादी); अयं रु पुनः ८.३.१५ इति खर्/अवसाने विसर्गः, अन्यत्र (घोष-हलि) रेफः अवशिष्यते। (८.२.६६)", "chronological_transition": {"from_sutra": "8.2.39", "to_sutra": "8.2.66"}}, {"sutra_id": "8.3.15", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vivakSakar", "form_after": "vivakSakaH", "why_dev": "खर्-वर्णे परे अवसाने च रु-आदेशस्य विसर्गः।", "status": "APPLIED", "why_now_dev": "खर्-वर्णे परे अवसाने च 'रु' (८.२.६६) इत्यस्य विसर्गः (ः); एवं रामः, धनुः इति विसर्गान्त-रूपं सिध्यति। (८.३.१५)", "chronological_transition": {"from_sutra": "8.2.66", "to_sutra": "8.3.15"}}, {"sutra_id": "8.3.24", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vivakSakaH", "form_after": "vivakSakaH", "why_dev": "अपदान्त-नकारस्य झलि परे अनुस्वारः (डेमो: मुञ्चति)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.15", "to_sutra": "8.3.24"}}, {"sutra_id": "8.3.59", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vivakSakaH", "form_after": "vivakSakaH", "why_dev": "इन्-कुक्-पूर्वे स-कारस्य (प्रत्ययस्थस्य) 'ष'-आदेशः (त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.24", "to_sutra": "8.3.59"}}, {"sutra_id": "8.3.60", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vivakSakaH", "form_after": "vivakSakaH", "why_dev": "वसादौ (सम्प्रसारणोत्तरं) सस्य षत्वं (उषित्वा)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.59", "to_sutra": "8.3.60"}}, {"sutra_id": "8.4.41", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vivakSakaH", "form_after": "vivakSakaH", "why_dev": "ष्-समीपे तकारस्य टकारादेशः; प०३१ न्→ण्; प०३६ ``Na``→``a``; P001-B पूर्व-त्रिपादी ``z``+``t``।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.60", "to_sutra": "8.4.41"}}, {"sutra_id": "8.4.54", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vivakSakaH", "form_after": "vivakSakaH", "why_dev": "अभ्यास-स्थिते झश्-वर्णस्य जश्-आदेशः (भि→बि) — विभिदतुः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.41", "to_sutra": "8.4.54"}}, {"sutra_id": "8.4.55", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vivakSakaH", "form_after": "vivakSakaH", "why_dev": "खरि परे झल्-कार्यम् (द्→त्); प०३१—प०३४ ग्लास्-बॉक्स् पूरणम्।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.54", "to_sutra": "8.4.55"}}, {"sutra_id": "8.4.56", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vivakSakaH", "form_after": "vivakSakaH", "why_dev": "(सूत्रम् 8.4.56) वाऽवसाने।", "status": "APPLIED", "chronological_transition": {"from_sutra": "8.4.55", "to_sutra": "8.4.56"}}, {"sutra_id": "8.4.58", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vivakSakaH", "form_after": "vivakSakaH", "why_dev": "ययि परे अनुस्वारस्य परसवर्णः (डेमो: मुञ्चति)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.56", "to_sutra": "8.4.58"}}, {"sutra_id": "8.4.68", "sutra_type": "ANUVADA", "type_label": "अनुवाद", "form_before": "vivakSakaH", "form_after": "vivakSakaH", "why_dev": "(सूत्रम् 8.4.68) अ अ इति।", "status": "AUDIT", "chronological_transition": {"from_sutra": "8.4.58", "to_sutra": "8.4.68"}}]}