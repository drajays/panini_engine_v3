ail": "अत्र तिङ्-प्रत्ययः (तिप्) परस्मैपद-नियतः; तङ्-शानच्-कानच्-आत्मनेपद-नियम १.४.१०० अत्र न प्रवर्तते, अतः १.४.९९-दत्ता परस्मैपद-संज्ञा अनिर्बाधा।", "chronological_transition": {"from_sutra": "1.4.99", "to_sutra": "1.4.100"}}, {"sutra_id": "1.3.78", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "cijhi", "form_after": "cijhi", "why_dev": "१.३.१२–७७ इत्यादिष्व् आत्मनेपद-विषयं विहाय अन्येभ्यो धातुभ्यः कर्तरि परस्मैपदम्; १.४.९९ इत्यादौ परस्मैपद-संज्ञा।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.4.100", "to_sutra": "1.3.78"}}, {"sutra_id": "1.4.101", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "cijhi", "form_after": "cijhi", "why_dev": "तिङादेश-अष्टादशानां क्रमेण षड्-त्र्यायाः, प्रथम-मध्यम-उत्तम-संज्ञा (पर-आत्म-नव-नव)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.78", "to_sutra": "1.4.101"}}, {"sutra_id": "1.4.108", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "cijhi", "form_after": "cijhi", "why_dev": "मध्यमोत्तम-निमित्ते १.४.१०५, १.४.१०७ — अन्येभ्यो वाक्येभ्यः कर्तरि / कर्मण्यनुरोधि प्रथम-वचनीयः तिङ् (१.४.१०१- क्रमेण)।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.4.101", "to_sutra": "1.4.108"}}, {"sutra_id": "1.4.102", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "cijhi", "form_after": "cijhi", "why_dev": "प्रत्येक-पुरुष-त्रिके क्रमेण एक-द्वि-बहु-वचन-संज्ञा; अष्टादश-तिङ्-क्रमः ३.४.७८।", "status": "APPLIED", "why_now_dev": "प्रत्येक-पुरुष-त्रिके क्रमेण एकवचन-द्विवचन-बहुवचन-संज्ञाः; विभक्ति-प्रत्ययस्य वचन-संज्ञा अत्र निर्धार्यते। (१.४.१०२)", "chronological_transition": {"from_sutra": "1.4.108", "to_sutra": "1.4.102"}}, {"sutra_id": "1.4.22", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "cijhi", "form_after": "cijhi", "why_dev": "द्वित्व-विवक्षायां द्वि-वचनिय-प्रत्ययः, एकत्व-विवक्षायाम् एक-वचनियः; विवक्षा अभिकल्प्य धातु-मेटा 1_4_22_affix_class इति।", "status": "SKIPPED", "skip_reason": "COND-FALS