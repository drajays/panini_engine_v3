rm_after": "ciSnuJi", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "3.1.73", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.8", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "ciSnuJi", "form_after": "ciSnuJi", "why_dev": "अतद्धिते प्रत्ययादौ ल्-श्-कु-वर्णानाम् इत्-संज्ञा; लोपः १.३.९। सुप्-पङ्क्तिषु ङ्-आदिर् अपि (*N* ∈ *ku*)।", "status": "APPLIED", "why_now_dev": "अतद्धित-प्रत्ययस्य आदौ ल्/श्/कवर्ग-वर्णः 'इत्'-संज्ञां प्राप्नोति; अयं वर्णः अनन्तरं १.३.९ इति लुप्यते (यथा शप् → अ, ङी → ई)। (१.३.८)", "parts": [["ci", "dhatu", "ciY"], ["Snu", "vikarana", "Snu"], ["Ji", "tin", "Ji"]], "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.8"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "ciSnuJi", "form_after": "cinuJi", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः (तस्य लोपः): श्नु — श् → शित् (१.३.८)। (१.३.९)", "parts": [["ci", "dhatu", "ciY"], ["nu", "vikarana", "Snu"], ["Ji", "tin", "Ji"]], "chronological_transition": {"from_sutra": "1.3.8", "to_sutra": "1.3.9"}}, {"sutra_id": "1.3.10", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "cinuJi", "form_after": "cinuJi", "why_dev": "द्वयोः समसङ्ख्यक-गणयोः मध्ये अनुदेशः यदा, तदा सः सदस्येषु क्रमेण — यथा ६.१.७८ (ए→अय्, ऐ→आय्), ३.१.१३४ (ल्यु्-णिनि-अच्), १.१.४६ (टित्-कित्)। असमसङ्ख्ये (८.२.३९) न; अन्तरतमम् १.१.५० आदि।", "status": "VACUOUS", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "1.3.10"}}, {"sutra_id": "7.1.5", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinuJi", "form_after": "cinuJi", "why_dev": "(सूत्रम् 7.1.5) आत्मनेपदेष्वनतः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.10", "to_sutra": "7.1.5"}}, {"sutra_id": "7.1.3", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinuJi", "form_after": "cinuanti", "why_dev": "झि-प्रत्ययस्य झकारस्य अन्तादेशः → अन्ति (परस्मैपद); कर्मणि झ (J) → अन्त → झे (Je) के बाद अन्ते।", "status": "APPLIED", "parts": [["ci", "dhatu", "ciY"], ["nu", "vikarana", "Snu"], ["anti", "tin", "anti"]], "chronological_transition": {"from_sutra": "7.1.5", "to_sutra": "7.1.3"}}, {"sutra_id": "3.4.113", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "cinuanti", "form_after": "cinuanti", "why_dev": "तिङ्-तथा-शित्-प्रत्ययः सार्वधातुक-संज्ञकः, आर्धधातुकानि ३.४.११४-अग्रे।", "status": "APPLIED", "parts": [["ci", "dhatu", "ciY"], ["nu", "vikarana", "Snu"], ["anti", "tin", "anti"]], "chronological_transition": {"from_sutra": "7.1.3", "to_sutra": "3.4.113"}}, {"sutra_id": "1.4.13", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "cinuanti", "form_after": "cinuanti", "why_dev": "प्रत्यय-विधेर् यस्मात् तदादि प्रत्यये यत् तद् अङ्गम्।", "status": "DEFINED", "chronological_transition": {"from_sutra": "3.4.113", "to_sutra": "1.4.13"}}, {"sutra_id": "1.1.5", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinuanti", "form_after": "cinuanti", "why_dev": "क्‍ङ्-परिच्छिन्ने प्रत्यय-क्षेपे, तस्मिन् आङ्ग-कार्ये, यः १.१.३-उत्सर्ग-इक-नियमः, सो न।", "status": "VACUOUS", "chronological_transition": {"from_sutra": "1.4.13", "to_sutra": "1.1.5"}}, {"sutra_id": "1.2.1", "sutra_type": "ATIDESHA", "type_label": "अतिदेश", "form_before": "cinuanti", "form_after": "cinuanti", "why_dev": "गाङ्/कुटादि धातोः परस्य प्रत्ययस्य (अञ्-णित्-भिन्नस्य) ङित्वम् अतिदिश्यते — कुटिता।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.5", "to_sutra": "1.2.1"}}, {"sutra_id": "7.3.84", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinuanti", "form_after": "cinuanti", "why_dev": "अङ्गान्तिकः गुणः — धातोः परतरं सार्वधातुके वा आर्धधातुके वा (तिङ्-शित्-सूची, तृच्-आदि)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.2.1", "to_sutra": "7.3.84"}}, {"sutra_id": "1.1.51", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "cinuanti", "form_after": "cinuanti", "why_dev": "ऋ/ऌ-प्रसङ्गे अण्-आदेशानन्तरं र्/ल्-आगमः (यथासङ्ख्यम्) — उरण् रपरः (कृ→कर्, हृ→हर्)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.3.84", "to_sutra": "1.1.51"}}, {"sutra_id": "6.1.72", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "cinuanti", "form_after": "cinuanti", "why_dev": "संहिताधिकारः (प्रथमः) — ६.१.७२ तः ६.१.१५७ पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.51", "to_sutra": "6.1.72"}}, {"sutra_id": "6.4.87", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinuanti", "form_after": "cinvanti", "why_dev": "असंयोगपूर्वस्य श्नुप्रत्ययस्य उकारस्य यण् अजादौ सार्वधातुके (सुन्वन्ति, चिन्वन्ति)।", "status": "APPLIED", "parts": [["ci", "dhatu", "ciY"], ["nv", "vikarana", "Snu"], ["anti", "tin", "anti"]], "chronological_transition": {"from_sutra": "6.1.72", "to_sutra": "6.4.87"}}, {"sutra_id": "1.4.14", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "cinvanti", "form_after": "cinvanti", "why_dev": "सुप्-अन्तः तिङ्-अन्तः वा शब्दः पद-संज्ञकः (अष्टाध्यायी)।", "status": "APPLIED", "why_now_dev": "सुप्-अन्तः तिङ्-अन्तः वा शब्दः पद-संज्ञकः; अनेन पद-कार्याणि (त्रिपादी-सन्धि-आदि) प्रसजन्ति। (१.४.१४)", "parts": [["ci", "dhatu", "ciY"], ["nv", "vikarana", "Snu"], ["anti", "tin", "anti"]], "chronological_transition": {"from_sutra": "6.4.87", "to_sutra": "1.4.14"}}, {"sutra_id": "__MERGE__", "sutra_type": "STRUCTURAL", "type_label": "पद-मेलनम्", "form_before": "cinvanti", "form_after": "cinvanti", "why_dev": "पद-रचना — सर्व-धातु/सुबन्त/कृदन्त-संयोजनम् (संरचनात्मकं, न सूत्रम्)।", "status": "APPLIED", "event": "MERGE"}, {"sutra_id": "8.2.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "cinvanti", "form_after": "cinvanti", "why_dev": "८.२.१ तः ८.४.६८ पर्यन्तम् (त्रिपादी) पूर्व-सूत्रेभ्यः असिद्धम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.4.14", "to_sutra": "8.2.1"}}, {"sutra_id": "8.2.23", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvanti", "form_after": "cinvanti", "why_dev": "संयोगान्त-पदस्य अन्त्य-हल्-लोपः (चितवान्)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.1", "to_sutra": "8.2.23"}}, {"sutra_id": "8.2.25", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvanti", "form_after": "cinvanti", "why_dev": "(सूत्रम् 8.2.25) धि च।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.23", "to_sutra": "8.2.25"}}, {"sutra_id": "8.2.27", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvanti", "form_after": "cinvanti", "why_dev": "ह्रस्वान्ताद् अङ्गात् परस्य सिचः सस्य लोपो झलि — अकृत।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.25", "to_sutra": "8.2.27"}}, {"sutra_id": "8.2.28", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvanti", "form_after": "cinvanti", "why_dev": "इट्-आगमे सति सिच्-स्थ-सकारस्य लोपः (लुङ्-प्रक्रिया, अलावीत्)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.27", "to_sutra": "8.2.28"}}, {"sutra_id": "8.2.26", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvanti", "form_after": "cinvanti", "why_dev": "झलो झलि परे लोपः — प०३३ (घ्स्-त-)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.28", "to_sutra": "8.2.26"}}, {"sutra_id": "8.2.36", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvanti", "form_after": "cinvanti", "why_dev": "व्रश्चभ्रस्ज…च्छशां षः: a dhātu-final श्/छ् (and सृज्, मृज्, यज्, राज्, भ्राज्) → ष् before a jhal or at the pada end (apavāda of 8.2.30) — दंश्+स्य, सृज्+त → सृष्ट.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.26", "to_sutra": "8.2.36"}}, {"sutra_id": "8.2.30", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvanti", "form_after": "cinvanti", "why_dev": "झलि/पदान्ते परे च-वर्णस्य क-वर्णादेशः (उक्त-उपपत्ति)। प००३-ए: त्रिपादी-प्रवेशात् पूर्वम् अनुमतम्।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.36", "to_sutra": "8.2.30"}}, {"sutra_id": "8.2.32", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvanti", "form_after": "cinvanti", "why_dev": "दादेर्धातोर्घः: the ह् of a द्-initial dhātu → घ् (apavāda of 8.2.31) — दुह् → दुघ्, दह् → दघ्.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.30", "to_sutra": "8.2.32"}}, {"sutra_id": "8.2.34", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvanti", "form_after": "cinvanti", "why_dev": "नहो धः: the ह् of नह् → ध् (apavāda of 8.2.31) — नह्+त → नद्ध.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.32", "to_sutra": "8.2.34"}}, {"sutra_id": "8.2.31", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvanti", "form_after": "cinvanti", "why_dev": "हो ढः: ह् → ढ् before a jhal or at the pada end — लिह्+स्य → लिढ्+स्य.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.34", "to_sutra": "8.2.31"}}, {"sutra_id": "8.2.37", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvanti", "form_after": "cinvanti", "why_dev": "एकाचो बशो भष् झषन्तस्य स्ध्वोः: a one-vowel dhātu beginning with बश् and ending in झष् aspirates its initial before स्/ध्व् or at the end — दुघ्+स्य → धुघ्+स्य (धोक्ष्यति).", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.31", "to_sutra": "8.2.37"}}, {"sutra_id": "8.2.39", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvanti", "form_after": "cinvanti", "why_dev": "पदान्ते झल्-व्यञ्जनस्य स्थाने जश्-व्यञ्जनः (सूत्रम् ८.२.३९ झलां जशोऽन्ते) — त् → द्।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.37", "to_sutra": "8.2.39"}}, {"sutra_id": "8.2.40", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvanti", "form_after": "cinvanti", "why_dev": "झष्-पूर्वे त्/थ् का ध्-आदेशः (डेमो: रुणद्धि; प००१-डि पूर्व-त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.39", "to_sutra": "8.2.40"}}, {"sutra_id": "8.2.41", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvanti", "form_after": "cinvanti", "why_dev": "षढोः कः सि: ष्/ढ् before स् → क् — लेढ्+स्य → लेक्+स्य.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.40", "to_sutra": "8.2.41"}}, {"sutra_id": "8.2.66", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvanti", "form_after": "cinvanti", "why_dev": "पदान्त-सकारस्य सजुषः च रु-आदेशः (त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.41", "to_sutra": "8.2.66"}}, {"sutra_id": "8.2.77", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvanti", "form_after": "cinvanti", "why_dev": "धातोः र्वोः पूर्वस्य इकः दीर्घः हलि परे (दीव्यति)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.66", "to_sutra": "8.2.77"}}, {"sutra_id": "8.2.78", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvanti", "form_after": "cinvanti", "why_dev": "धातोः उपधाभूतयोः र्वोः पूर्वस्य इकः दीर्घः (मूर्वति)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.77", "to_sutra": "8.2.78"}}, {"sutra_id": "8.3.15", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvanti", "form_after": "cinvanti", "why_dev": "खर्-वर्णे परे अवसाने च रु-आदेशस्य विसर्गः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.78", "to_sutra": "8.3.15"}}, {"sutra_id": "8.3.24", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvanti", "form_after": "cinvaMti", "why_dev": "अपदान्तस्य नकारस्य मकारस्य च झलि परे अनुस्वारः (यशांसि, आक्रंस्यते)।", "status": "APPLIED", "parts": [["cinvaMti", "pada", "ciY"]], "chronological_transition": {"from_sutra": "8.3.15", "to_sutra": "8.3.24"}}, {"sutra_id": "8.3.59", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvaMti", "form_after": "cinvaMti", "why_dev": "इन्-कुक्-पूर्वे स-कारस्य (प्रत्ययस्थस्य) 'ष'-आदेशः (त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.24", "to_sutra": "8.3.59"}}, {"sutra_id": "8.3.60", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvaMti", "form_after": "cinvaMti", "why_dev": "वसादौ (सम्प्रसारणोत्तरं) सस्य षत्वं (उषित्वा)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.59", "to_sutra": "8.3.60"}}, {"sutra_id": "8.4.1", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvaMti", "form_after": "cinvaMti", "why_dev": "समानपदे रेफ-ष-वर्णाभ्यां (ऋवर्णाद् अपि) ऋणे परस्य न-कारस्य सन्निहिते णादेशः (१०८ संहितायाम्, त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.60", "to_sutra": "8.4.1"}}, {"sutra_id": "8.4.2", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvaMti", "form_after": "cinvaMti", "why_dev": "र-ष-वर्णात् परस्य न-कारस्य णत्वम् — अट्-कु-पु-आङ्-नुम् व्यवधाने अपि (त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.1", "to_sutra": "8.4.2"}}, {"sutra_id": "8.4.40", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvaMti", "form_after": "cinvaMti", "why_dev": "चवर्गे परे स्तोः श्चुनेन श्चुः (डेमो: दधि+छत्रम्); ष्टुणा-शाखा पुरातन-मार्ज्वि-मार्गे।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.2", "to_sutra": "8.4.40"}}, {"sutra_id": "8.4.41", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvaMti", "form_after": "cinvaMti", "why_dev": "ष्-समीपे तकारस्य टकारादेशः; प०३१ न्→ण्; P001-B पूर्व-त्रिपादी ``z``+``t``।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.40", "to_sutra": "8.4.41"}}, {"sutra_id": "8.3.13", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvaMti", "form_after": "cinvaMti", "why_dev": "ढकारे परे ढकारस्य लोपः — लेढ्+ढा → लेढा।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.41", "to_sutra": "8.3.13"}}, {"sutra_id": "6.3.112", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvaMti", "form_after": "cinvaMti", "why_dev": "ढ्-लोपे सह्-वह्-धात्वोः अवर्णस्य ओकारः — सढ्+ढा → सोढा।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.13", "to_sutra": "6.3.112"}}, {"sutra_id": "6.3.111", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvaMti", "form_after": "cinvaMti", "why_dev": "ढ्-लोपे सति पूर्वस्य अणः दीर्घः — लिढ्+ढ → लीढ।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.3.112", "to_sutra": "6.3.111"}}, {"sutra_id": "8.4.53", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvaMti", "form_after": "cinvaMti", "why_dev": "झशि परे झल्-वर्णस्य जश्-आदेशः (डेमो: ध् → द्; प००१-डि पूर्व-त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.3.111", "to_sutra": "8.4.53"}}, {"sutra_id": "8.4.54", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvaMti", "form_after": "cinvaMti", "why_dev": "अभ्यास-स्थिते झश्-वर्णस्य जश्-आदेशः (भि→बि) — विभिदतुः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.53", "to_sutra": "8.4.54"}}, {"sutra_id": "8.4.55", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvaMti", "form_after": "cinvaMti", "why_dev": "खरि परे झल्-कार्यम् (द्→त्); प०३१—प०३४ ग्लास्-बॉक्स् पूरणम्।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.54", "to_sutra": "8.4.55"}}, {"sutra_id": "8.4.56", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvaMti", "form_after": "cinvaMti", "why_dev": "(सूत्रम् 8.4.56) वाऽवसाने।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.55", "to_sutra": "8.4.56"}}, {"sutra_id": "8.4.58", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "cinvaMti", "form_after": "cinvanti", "why_dev": "ययि परे अनुस्वारस्य परसवर्णः (डेमो: मुञ्चति)।", "status": "APPLIED", "parts": [["cinvanti", "pada", "ciY"]], "chronological_transition": {"from_sutra": "8.4.56", "to_sutra": "8.4.58"}}, {"sutra_id": "8.4.68", "sutra_type": "ANUVADA", "type_label": "अनुवाद", "form_before": "cinvanti", "form_after": "cinvanti", "why_dev": "(सूत्रम् 8.4.68) अ अ इति।", "status": "VACUOUS", "chronological_transition": {"from_sutra": "8.4.58", "to_sutra": "8.4.68"}}]}