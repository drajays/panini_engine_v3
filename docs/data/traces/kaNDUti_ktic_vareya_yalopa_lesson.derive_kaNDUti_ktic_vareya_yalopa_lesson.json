: {"from_sutra": "3.3.174", "to_sutra": "6.4.48"}}, {"sutra_id": "1.1.57", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "kaNDUyktic", "form_after": "kaNDUyktic", "why_dev": "पूर्वविधि-लोपितस्य अचः स्थानिवत्-भावः (P025)।", "status": "AUDIT", "chronological_transition": {"from_sutra": "6.4.48", "to_sutra": "1.1.57"}}, {"sutra_id": "1.1.58", "sutra_type": "NIYAMA", "type_label": "नियम", "form_before": "kaNDUyktic", "form_after": "kaNDUyktic", "why_dev": "पदान्त-द्विर्वचन-वरेयलोप-स्वर-सवर्ण-अनुस्वार-दीर्घ-जश्चर्-विधिषु पूर्वसूत्रस्य अनुवृत्तिः न — एते प्रसङ्गाः असिद्धवत्।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.1.57", "to_sutra": "1.1.58"}}, {"sutra_id": "6.1.66", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "kaNDUyktic", "form_after": "kaNDUktic", "why_dev": "तृच्-पथ: दीर्घात् परस्य अपृक्त हल्-लोपः (सु→स्)। विधि-लिङ्-पथ: यासुट्-अवशेष [i,y] में य्-लोपः हल्-पूर्वे। आशीर्-लिङ्-पथ (२मध्यम-एक): यासुट्-पश्चात् सिप्-जन्य-स्-लोपः। कर्मणि-पथ: ७.२.८१-जन्य इय् में य्-लोपः हल्-पूर्वे (इय्ते→इते)। कर्मणि-विधिलिङ्-पथ: सीयुट्-अवशेष [I,y] में य्-लोपः हल्-पूर्वे। व्योः-वलि-पथ: य्-लोपः व/ल/र/त्-पूर्वम् (**1.1.58**+**6.4.48** पाठ)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.1.58", "to_sutra": "6.1.66"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "kaNDUktic", "form_after": "kaNDUktic", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "6.1.66", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.7", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "kaNDUktic", "form_after": "kaNDUktic", "why_dev": "चवर्ग-टवर्गीयः प्रथमः हल् ‘इत्’ संज्ञकः; लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.7"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "kaNDUktic", "form_after": "kaNDUkti", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.7", "to_sutra": "1.3.9"}}, {"sutra_id": "__KRT_MERGE__", "sutra_type": "STRUCTURAL", "type_label": "क्तिच्-मेलनम्", "form_before": "kaNDUkti", "form_after": "kaNDUti", "why_dev": "कण्डू + ति → कण्डूति (रूपसिद्धि)।", "status": "APPLIED"}]}