{"module": "pipelines.juhoti_hu_lat_tip_Slu", "callable": "derive_juhoti_hu_lat_tip_Slu_P040", "ok": true, "smoke_note": null, "invocation": {"args": [], "kwargs": {}}, "result_kind": "state", "final_flat_slp1": "juhoti", "phase": "angakarya", "tripadi_zone": false, "trace_len": 24, "trace": [{"sutra_id": "1.1.68", "sutra_type": "ANUVADA", "type_label": "अनुवाद", "form_before": "hu", "form_after": "hu", "why_dev": "शब्दः स्व-रूप-पर्यायः (अशब्द-संज्ञा-अपवादः) — डेमो-आडिट्।", "status": "AUDIT", "chronological_transition": {"from_sutra": null, "to_sutra": "1.1.68"}}, {"sutra_id": "3.1.91", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "hu", "form_after": "hu", "why_dev": "धातोः कृत्-तिङ्-प्रत्ययाः — अधिकारः ३.१.९१ तः ३.४.११७ पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.68", "to_sutra": "3.1.91"}}, {"sutra_id": "3.1.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "hu", "form_after": "hu", "why_dev": "अधिकारः प्रत्यय-विधानम् — ३.१.१ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.91", "to_sutra": "3.1.1"}}, {"sutra_id": "3.1.2", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "hu", "form_after": "hu", "why_dev": "प्रत्ययः निमित्तात् परः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.1", "to_sutra": "3.1.2"}}, {"sutra_id": "3.1.3", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "hu", "form_after": "hu", "why_dev": "प्रत्ययस्य आद्युदात्तत्वम् — अधिकारः ३.१.३ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.2", "to_sutra": "3.1.3"}}, {"sutra_id": "3.2.123", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "hu", "form_after": "hu", "why_dev": "वर्तमानाधिकारः — ३.२.१२३ तः ३.३.१ पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.3", "to_sutra": "3.2.123"}}, {"sutra_id": "3.4.77", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "hula", "form_after": "hula", "why_dev": "लाधिकारः — ३.४.७७ तः ३.४.११२ पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.2.123", "to_sutra": "3.4.77"}}, {"sutra_id": "3.4.78", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "hula", "form_after": "hutip", "why_dev": "लकार-प्रत्ययस्य स्थाने तिङ्-आदेश (तिप्-तस्-झि-…-महिङ्) — संज्ञाः १.४.९९ इत्यादि-सूत्रैः पृथक्; सूत्रे अभिकल्पित-तिङ्-लक्ष्यम्, न पुरुष-वचन-परिगणनम् (CONSTITUTION २)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "3.4.77", "to_sutra": "3.4.78"}}, {"sutra_id": "1.4.99", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "hutip", "form_after": "hutip", "why_dev": "लकार-स्थानि तिङादेशादिषु अन्त्यैकादश-प्रकारेषु परस्मैपद-संज्ञा; तङादिषु १.४.१०० इति पृथक् (एकसंज्ञा-सापेक्ष)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "3.4.78", "to_sutra": "1.4.99"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "hutip", "form_after": "hutip", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.4.99", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "hutip", "form_after": "huti", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.9"}}, {"sutra_id": "2.4.75", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "huti", "form_after": "huSluti", "why_dev": "जुहोत्यादि-गणात् शप्-स्थाने श्लुः (२.४.७५) — P040।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "2.4.75"}}, {"sutra_id": "1.1.60", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "huSluti", "form_after": "huSluti", "why_dev": "स्थानिनि वर्णः वा वर्णसमूहः वा अदर्शनं यत्, तत् 'लोप' इति संज्ञा — उपयोगः १.३.९, ८.२.२३, ६.१.६८, … इतिषु; अत्र केवल संज्ञा-निर्णयः।", "status": "APPLIED", "why_now_dev": "स्थाने वर्णस्य वर्णसमूहस्य वा अदर्शनं 'लोप'-संज्ञां प्राप्नोति; अनया संज्ञया उत्तर-विधयः (यथा १.३.९ इत्-लोपः) प्रवर्तन्ते। (१.१.६०)", "chronological_transition": {"from_sutra": "2.4.75", "to_sutra": "1.1.60"}}, {"sutra_id": "1.1.61", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "huSluti", "form_after": "huSluti", "why_dev": "प्रत्ययस्य लोपः यदा 'लुक्' / 'श्लुः' / 'लुप्' इति विशिष्टेन शब्देनोक्तः, तदा स लोपः तथैव संज्ञकः; केवलं 'लोपः' इति शब्देनोक्तस्तु न — १.१.६३ इत्यादौ 'लु' इति सामान्यनिर्देशः; सम्पूर्ण-प्रत्ययलोपे १.१.५२, १.१.५४ न। तिसृणां प्रयोजनम् — श्लौ ६.१.१० इति श्लुः-संज्ञकलोपानन्तरं प्रकृतेः द्वित्वम् (यथा दा+शप्+ति → ददाति); लुक् समूहलोपे, तद्धिते लुकि १.२.४९ लुक्तद्धितलुकि उपसर्जन-स्त्रीप्रत्ययस्यापि लुक् (यथा आमलक्याः फलम् → आमलक+…, ४.३.१६३); १.१.६२–६३ प्रत्ययलक्षणम् / न लुमताङ्गस्य — अनिष्टाङ्गकार्ये लुक्-श्लु-लुप्-संज्ञा (यथा पञ्चन्+जस् → पञ्च, ७.१.२२); लुप्-संज्ञायां १.२.५१ लुपि युक्तवद् व्यक्तिवचने इति लिङ्ग-वचने प्रकृतिम् अनुसरतः (यथा पञ्चालानां निवासः → पञ्चालाः जनपदः, ४.२.८१ इत्यादौ लुप्)।", "status": "APPLIED", "why_now_dev": "प्रत्ययलोपस्य 'लुक्'/'श्लुः'/'लुप्' इति त्रयः विशेष-संज्ञाः अधुना पञ्जीकृताः; लोप-संज्ञा (१.१.६०) पूर्वम् एव सक्रिया। (१.१.६१)", "chronological_transition": {"from_sutra": "1.1.60", "to_sutra": "1.1.61"}}, {"sutra_id": "__MERGE__", "sutra_type": "STRUCTURAL", "type_label": "श्लु-अवशेष-लोपः", "form_before": "huti", "form_after": "huti", "why_dev": "१.१.६१-अनन्तरं श्लु-प्रत्ययस्य संरचनात्मक-अपसारणम् (P040)।", "status": "APPLIED"}, {"sutra_id": "6.1.10", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "huti", "form_after": "huhuti", "why_dev": "श्लौ-प्रसङ्गे धातोः द्वित्वम् (जुहोति) — P040।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.1.61", "to_sutra": "6.1.10"}}, {"sutra_id": "7.4.59", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "huhuti", "form_after": "huhuti", "why_dev": "अभ्यासे दीर्घस्य ह्रस्वः (P०२९/P०३०/P०३५/P०३६) अथवा प०३४ अभ्यास-पदार्थम् तथा प०३७।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.10", "to_sutra": "7.4.59"}}, {"sutra_id": "7.4.62", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "huhuti", "form_after": "juhuti", "why_dev": "अभ्यासे कु-वर्णस्य चु-आदेशः (ग→ज; P014: क→च) — जिघृक्षति।", "status": "APPLIED", "chronological_transition": {"from_sutra": "7.4.59", "to_sutra": "7.4.62"}}, {"sutra_id": "3.4.113", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "juhuti", "form_after": "juhuti", "why_dev": "तिङ्-तथा-शित्-प्रत्ययः सार्वधातुक-संज्ञकः, आर्धधातुकानि ३.४.११४-अग्रे।", "status": "APPLIED", "chronological_transition": {"from_sutra": "7.4.62", "to_sutra": "3.4.113"}}, {"sutra_id": "7.3.84", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "juhuti", "form_after": "juhoti", "why_dev": "अङ्गान्तिकः गुणः — धातोः परतरं सार्वधातुके वा आर्धधातुके वा (तिङ्-शित्-सूची, तृच्-आदि)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "3.4.113", "to_sutra": "7.3.84"}}, {"sutra_id": "1.1.62", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "juhoti", "form_after": "juhoti", "why_dev": "प्रत्ययस्य लोपे कृते अपि प्रत्ययाश्रितं कार्यम् अवश्यं भवति — यथा नदी+सुँ → नदी (६.१.६८) इत्यत्र पदम् १.४.१४; षष्+जस् → षड् (७.१.२२ लुक्); अदस्+सुँ → असौ (७.२.१०६); अग्निचित् (६.१.७१); अधुक् (७.३.८६, ८.२.३२)। अङ्गकार्ये अपवादः १.१.६३।", "status": "AUDIT", "chronological_transition": {"from_sutra": "7.3.84", "to_sutra": "1.1.62"}}, {"sutra_id": "__MERGE__", "sutra_type": "STRUCTURAL", "type_label": "पद-मेलनम्", "form_before": "juhoti", "form_after": "juhoti", "why_dev": "पद-रचना — सर्व-धातु/सुबन्त/कृदन्त-संयोजनम् (संरचनात्मकं, न सूत्रम्)।", "status": "APPLIED", "event": "MERGE"}, {"sutra_id": "6.1.87", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "juhoti", "form_after": "juhoti", "why_dev": "अ-कारात् परे इक् वर्णे एकादेश-रूपेण गुणः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.62", "to_sutra": "6.1.87"}}, {"sutra_id": "1.1.68", "sutra_type": "ANUVADA", "type_label": "अनुवाद", "form_before": "juhoti", "form_after": "juhoti", "why_dev": "शब्दः स्व-रूप-पर्यायः (अशब्द-संज्ञा-अपवादः) — डेमो-आडिट्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "6.1.87", "to_sutra": "1.1.68"}}]}