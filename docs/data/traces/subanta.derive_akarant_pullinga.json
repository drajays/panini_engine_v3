{"module": "pipelines.subanta", "callable": "derive_akarant_pullinga", "ok": true, "smoke_note": "stem_slp1='rAma' (smoke); vibhakti=1 (smoke)", "invocation": {"args": ["rAma", 1, 1], "kwargs": {"strict_stem": true}}, "result_kind": "state", "final_flat_slp1": "rAmaH", "phase": "angakarya", "tripadi_zone": true, "trace_len": 125, "trace": [{"sutra_id": "4.1.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "rAma", "form_after": "rAma", "why_dev": "प्रातिपदिकाधिकारः — ४.१.१ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": null, "to_sutra": "4.1.1"}}, {"sutra_id": "1.1.1", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAma", "form_after": "rAma", "why_dev": "आ-ऐ-औ इति वृद्धि-संज्ञा (अधिकार-बद्धा न, सर्वत्र उपलब्धा)। अनया केवल वर्ण-समूहस्य निर्देशः — पदेषु स्वतः परिवर्तनं न। वृद्धि-प्रयोगः तु यदा विधि-सूत्रेषु (यथा ६.१.८८) प्रसङ्गः, तदा। अष्टाध्याय्यां 'वृद्धि' इयं संज्ञा नवसु सूत्रेषु साक्षात्, अन्यत्र अनुवृत्त्या च।", "status": "APPLIED", "why_now_dev": "आ, ऐ, औ — एते वर्णाः 'वृद्धि'-संज्ञां प्राप्नुवन्ति; इयं संज्ञा वृद्धि-विधिषु (यथा ६.१.८८ वृद्धिरेचि, ७.२.१ सिचि वृद्धिः) उपयुज्यते। (१.१.१)", "chronological_transition": {"from_sutra": "4.1.1", "to_sutra": "1.1.1"}}, {"sutra_id": "1.1.73", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAma", "form_after": "rAma", "why_dev": "प्रथमः स्वर आ-ऐ-औ-संज्ञकः चेत् पदं वृद्धम्; नामधेये विकल्पेन वृद्ध-संज्ञा (वा नामधेयस्य…); जिह्वाकात्य-हरितकात्य-वर्जम् इति निषेधः। तद्धितादौ प्रयोजनम् — ४.२.११४ इत्यादिषु।", "status": "APPLIED", "why_now_dev": "पदस्य प्रथमः अच् वृद्धि-संज्ञकः (आ/ऐ/औ) इति तत् पदं वृद्ध-संज्ञकम्; अनेन वृद्धात् छ-आदि-कार्याणि (४.२.११४ आदि) प्रसजन्ति। (१.१.७३)", "chronological_transition": {"from_sutra": "1.1.1", "to_sutra": "1.1.73"}}, {"sutra_id": "1.1.2", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAma", "form_after": "rAma", "why_dev": "अ, ए, ओ इति गुण-संज्ञाः भवन्ति।", "status": "APPLIED", "why_now_dev": "अ, ए, ओ — एते वर्णाः 'गुण'-संज्ञां प्राप्नुवन्ति; इयं संज्ञा गुण-वृद्धि-विधिषु (यथा ७.३.८४ सार्वधातुकार्धधातुकयोः) उपयुज्यते। (१.१.२)", "chronological_transition": {"from_sutra": "1.1.73", "to_sutra": "1.1.2"}}, {"sutra_id": "1.1.3", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "rAma", "form_after": "rAma", "why_dev": "यत्र गुण-वृद्धी उत्सर्गतः, न च स्थानी षष्ठ्यन्तं निर्दिष्टः, तत्र स्थानी इक्-वर्ण एव; अत्र तत्-परिभाषा-द्वारा निश्चयः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.2", "to_sutra": "1.1.3"}}, {"sutra_id": "1.1.7", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAma", "form_after": "rAma", "why_dev": "ये हल्-वर्णाः अनन्तराः, न च अच्-अन्तरः, ते 'संयोग' इति संज्ञинः।", "status": "APPLIED", "why_now_dev": "अनन्तराः (मध्ये अच्-रहिताः) हल्-वर्णाः 'संयोग'-संज्ञां प्राप्नुवन्ति; इयं संज्ञा संयोगाश्रित-विधिषु (यथा ८.२.२३, ६.१.६८) उपयुज्यते। (१.१.७)", "chronological_transition": {"from_sutra": "1.1.3", "to_sutra": "1.1.7"}}, {"sutra_id": "1.1.60", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAma", "form_after": "rAma", "why_dev": "स्थानिनि वर्णः वा वर्णसमूहः वा अदर्शनं यत्, तत् 'लोप' इति संज्ञा — उपयोगः १.३.९, ८.२.२३, ६.१.६८, … इतिषु; अत्र केवल संज्ञा-निर्णयः।", "status": "APPLIED", "why_now_dev": "स्थाने वर्णस्य वर्णसमूहस्य वा अदर्शनं 'लोप'-संज्ञां प्राप्नोति; अनया संज्ञया उत्तर-विधयः (यथा १.३.९ इत्-लोपः) प्रवर्तन्ते। (१.१.६०)", "chronological_transition": {"from_sutra": "1.1.7", "to_sutra": "1.1.60"}}, {"sutra_id": "1.1.61", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAma", "form_after": "rAma", "why_dev": "प्रत्ययस्य लोपः यदा 'लुक्' / 'श्लुः' / 'लुप्' इति विशिष्टेन शब्देनोक्तः, तदा स लोपः तथैव संज्ञकः; केवलं 'लोपः' इति शब्देनोक्तस्तु न — १.१.६३ इत्यादौ 'लु' इति सामान्यनिर्देशः; सम्पूर्ण-प्रत्ययलोपे १.१.५२, १.१.५४ न। तिसृणां प्रयोजनम् — श्लौ ६.१.१० इति श्लुः-संज्ञकलोपानन्तरं प्रकृतेः द्वित्वम् (यथा दा+शप्+ति → ददाति); लुक् समूहलोपे, तद्धिते लुकि १.२.४९ लुक्तद्धितलुकि उपसर्जन-स्त्रीप्रत्ययस्यापि लुक् (यथा आमलक्याः फलम् → आमलक+…, ४.३.१६३); १.१.६२–६३ प्रत्ययलक्षणम् / न लुमताङ्गस्य — अनिष्टाङ्गकार्ये लुक्-श्लु-लुप्-संज्ञा (यथा पञ्चन्+जस् → पञ्च, ७.१.२२); लुप्-संज्ञायां १.२.५१ लुपि युक्तवद् व्यक्तिवचने इति लिङ्ग-वचने प्रकृतिम् अनुसरतः (यथा पञ्चालानां निवासः → पञ्चालाः जनपदः, ४.२.८१ इत्यादौ लुप्)।", "status": "APPLIED", "why_now_dev": "प्रत्ययलोपस्य 'लुक्'/'श्लुः'/'लुप्' इति त्रयः विशेष-संज्ञाः अधुना पञ्जीकृताः; लोप-संज्ञा (१.१.६०) पूर्वम् एव सक्रिया। (१.१.६१)", "chronological_transition": {"from_sutra": "1.1.60", "to_sutra": "1.1.61"}}, {"sutra_id": "1.1.62", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "rAma", "form_after": "rAma", "why_dev": "प्रत्ययस्य लोपे कृते अपि प्रत्ययाश्रितं कार्यम् अवश्यं भवति — यथा नदी+सुँ → नदी (६.१.६८) इत्यत्र पदम् १.४.१४; षष्+जस् → षड् (७.१.२२ लुक्); अदस्+सुँ → असौ (७.२.१०६); अग्निचित् (६.१.७१); अधुक् (७.३.८६, ८.२.३२)। अङ्गकार्ये अपवादः १.१.६३।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.61", "to_sutra": "1.1.62"}}, {"sutra_id": "1.1.63", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "rAma", "form_after": "rAma", "why_dev": "लुक्-श्लु-लुप्-संज्ञकेन प्रत्ययलोपे लुप्तप्रत्ययनिमित्तकम् अङ्गकार्यम् न — यथा इदम्+सुँ → इदम् (७.१.२३ लुक्, ७.२.११० यः सौ न); हु+शप् → झुहुतः (२.४.७५ श्लुः, ७.३.८४ गुणो न); पञ्चाल+अण् (४.२.८१ लुप्, ७.२.११७ आदिवृद्धिर्न)। केवल-लोपे (६.१.६८) १.१.६३ न, यथा शशिन्+सुँ → शशी (६.४.१३)। अङ्गस्यैव निषेधः — पदम्, नलोपः (८.२.७) आदयः अङ्गकार्यं विना १.१.६२-अनुसारेण (यथा पञ्चन्+जस् → पञ्च)।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.62", "to_sutra": "1.1.63"}}, {"sutra_id": "1.1.8", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAma", "form_after": "rAma", "why_dev": "यस्य वर्णस्य उच्चारणार्थं मुखेन सह नासिकायाः अपि प्रयोगः भवति, सः वर्णः 'अनुनासिक' इति संज्ञां प्राप्नोति।", "status": "APPLIED", "why_now_dev": "मुखेन नासिकया च उच्चार्यमाणः वर्णः अनुनासिक-संज्ञकः; अनेन उपदेशेऽजनुनासिक इत् (१.३.२) आदि कार्याणि प्रसजन्ति। (१.१.८)", "chronological_transition": {"from_sutra": "1.1.63", "to_sutra": "1.1.8"}}, {"sutra_id": "1.1.9", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAma", "form_after": "rAma", "why_dev": "ययोः वर्णयोः मुखस्थितम् उच्चारणस्थानम् आभ्यन्तरप्रयत्नश्च समानौ, तौ 'सवर्ण' इति संज्ञां प्राप्नुतः।", "status": "APPLIED", "why_now_dev": "समान-आस्य-प्रयत्नौ वर्णौ परस्परं सवर्ण-संज्ञकौ; अनेन सवर्ण-दीर्घ-आदि (६.१.१०१ आदि) कार्याणि प्रसजन्ति। (१.१.९)", "chronological_transition": {"from_sutra": "1.1.8", "to_sutra": "1.1.9"}}, {"sutra_id": "1.1.10", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "rAma", "form_after": "rAma", "why_dev": "उपदेशे 'अश् इत्' पाठ-विषये अज्-झलः न, इति परिभाषा; इत्प्रकरण-पद्धतेः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.9", "to_sutra": "1.1.10"}}, {"sutra_id": "1.1.11", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAma", "form_after": "rAma", "why_dev": "द्विवचनान्ते ई-कार-ऊ-कार-ए-ऐ-ओ-औ, ते 'प्रगृह्य' संज्ञिनः; सन्धौ न लोप-ग्रहः (उत्सर्ग-नियमः)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.10", "to_sutra": "1.1.11"}}, {"sutra_id": "1.1.12", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "rAma", "form_after": "rAma", "why_dev": "अदस्-कृताव् अश्-इत्पथे मात्-सम्बन्धः, द्विवचन-प्रगृह्य-काले च; उपदेश-वृत्ताव् इति परिभाषा।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.11", "to_sutra": "1.1.12"}}, {"sutra_id": "1.1.13", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "rAma", "form_after": "rAma", "why_dev": "प्रगृह्य-परिच्छेदे 'श' इत्यादौ न प्रयोगः, समास-सुप्-काले; उपदेश-वृत्ताव् इति।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.12", "to_sutra": "1.1.13"}}, {"sutra_id": "1.1.14", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAma", "form_after": "rAma", "why_dev": "आङ्-व्यतिरेक-एकस्वर-निर्व्यञ्जन-निपातानां प्रगृह्य-संज्ञा; अच्-सन्धि-नित्य-प्रकृतिभावे च (यथा ६.१.१२५)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.13", "to_sutra": "1.1.14"}}, {"sutra_id": "1.1.100", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "rAma", "form_after": "rAma", "why_dev": "प्रगृह्यं मात्रा-समासे न, द्वि-तृ-तुर्यादि-नामानि, उत्सर्ग-बाधः (काशिका-वृत्ति)।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.14", "to_sutra": "1.1.100"}}, {"sutra_id": "1.1.15", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAma", "form_after": "rAma", "why_dev": "ओ-कार-निपात-काले, प्रगृह्य-संज्ञा (१.१.११+१.१.१४)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.100", "to_sutra": "1.1.15"}}, {"sutra_id": "1.1.16", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAma", "form_after": "rAma", "why_dev": "सम्बुद्ध-औ-त-चर्चा, शाकल्य-मत-नियम, अनार्ष-काले, प्रगृह्य-संज्ञा, इति।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.15", "to_sutra": "1.1.16"}}, {"sutra_id": "1.1.17", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "rAma", "form_after": "rAma", "why_dev": "उञ-कृत-प्रगृह्य-नियमः, ष्-छ-प्रकृतौ, इति।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.16", "to_sutra": "1.1.17"}}, {"sutra_id": "1.1.18", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAma", "form_after": "rAma", "why_dev": "अनार्षे इति-परे उञः शाकल्यस्य मतेन वैकल्पिकः ऊँ-आदेशः, प्रगृह्यश्च; छान्दसे न।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.17", "to_sutra": "1.1.18"}}, {"sutra_id": "1.1.19", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAma", "form_after": "rAma", "why_dev": "द्विवचन-ईदू-काले सप्तमी-तात्पर्ये, प्रगृह्य-संज्ञा-विस्तारः, इति।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.18", "to_sutra": "1.1.19"}}, {"sutra_id": "1.1.20", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAma", "form_after": "rAma", "why_dev": "दा-धाव् अद-आप् च, घु-संज्ञा — इति धातु-तात्पर्यं।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.19", "to_sutra": "1.1.20"}}, {"sutra_id": "1.1.21", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "rAma", "form_after": "rAma", "why_dev": "एक-व्यपदेश-स्थाने आदि-ऽन्त-वद्-भावः, अतिदेश-तात्पर्यम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.20", "to_sutra": "1.1.21"}}, {"sutra_id": "1.1.46", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "rAma", "form_after": "rAma", "why_dev": "टित्-आगमः आगमिनः पूर्वम्, कित्-आगमः आगमिनः अनन्तरम् इति स्थाननिर्णयः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.21", "to_sutra": "1.1.46"}}, {"sutra_id": "1.1.22", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAma", "form_after": "rAma", "why_dev": "तरप्-तमप्-औ, घ-संज्ञा — ईषद्-अतिशय-तम-प्रत्ययौ।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.46", "to_sutra": "1.1.22"}}, {"sutra_id": "1.1.23", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAma", "form_after": "rAma", "why_dev": "बहु-गण-वतु-डति, संख्येयाः — ईदादि-तदन्त-तात्पर्यम्, इति।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.22", "to_sutra": "1.1.23"}}, {"sutra_id": "1.1.24", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAma", "form_after": "rAma", "why_dev": "संख्या-शब्देषु ष-ण-अन्तेषु, 'षट्' इति संज्ञा (१.१.२३-अनुवृत्त्या)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.23", "to_sutra": "1.1.24"}}, {"sutra_id": "1.2.72", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAma", "form_after": "rAma", "why_dev": "त्यदादि-गण-पठित-शब्दाः ‘त्यदादि’ संज्ञकाः (तद्-प्रकारे)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.24", "to_sutra": "1.2.72"}}, {"sutra_id": "1.2.45", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAma", "form_after": "rAma", "why_dev": "धातु-प्रत्यय-प्रत्ययान्त-वर्जितम् अर्थवच्छब्दरूपं प्रातिपदिकसंज्ञकम्।", "status": "APPLIED", "why_now_dev": "अर्थवत्-शब्दरूपं धातु-प्रत्यय-प्रत्ययान्त-वर्जितम् इति प्रातिपदिक-संज्ञां लभते (अव्युत्पन्न-प्रातिपदिकम्)। (१.२.४५)", "chronological_transition": {"from_sutra": "1.2.72", "to_sutra": "1.2.45"}}, {"sutra_id": "1.1.27", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAma", "form_after": "rAma", "why_dev": "सर्वादि-गण-पठित-शब्दाः सर्वनाम-संज्ञकाः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.2.45", "to_sutra": "1.1.27"}}, {"sutra_id": "1.1.29", "sutra_type": "NIYAMA", "type_label": "नियम", "form_before": "rAma", "form_after": "rAma", "why_dev": "बहुव्रीहि-समासे सर्वादि-सर्वनाम-संज्ञा न (अपवादः) — अतः ७.१.१४ादयः प्रबद्धा न।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.27", "to_sutra": "1.1.29"}}, {"sutra_id": "1.1.30", "sutra_type": "NIYAMA", "type_label": "नियम", "form_before": "rAma", "form_after": "rAma", "why_dev": "तृतीया-तत्पुरुष-समासे *सर्वनाम*-*सञ्ज्ञा* न, अतः ७.१.१४ *स्मै* *प्रसङ्गो* *न* — ७.१.१३ *य* *पथः*।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.29", "to_sutra": "1.1.30"}}, {"sutra_id": "4.1.2", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "rAma", "form_after": "rAmasu", "why_dev": "एकविंशति सुप्-प्रत्ययाः क्रमेण प्रातिपदिकात् विधीयन्ते; अधिकारः ४.१.२ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.30", "to_sutra": "4.1.2"}}, {"sutra_id": "3.1.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "rAmasu", "form_after": "rAmasu", "why_dev": "अधिकारः प्रत्यय-विधानम् — ३.१.१ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "4.1.2", "to_sutra": "3.1.1"}}, {"sutra_id": "3.1.2", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "rAmasu", "form_after": "rAmasu", "why_dev": "प्रत्ययः निमित्तात् परः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.1", "to_sutra": "3.1.2"}}, {"sutra_id": "1.4.102", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAmasu", "form_after": "rAmasu", "why_dev": "प्रत्येक-पुरुष-त्रिके क्रमेण एक-द्वि-बहु-वचन-संज्ञा; अष्टादश-तिङ्-क्रमः ३.४.७८।", "status": "APPLIED", "why_now_dev": "प्रत्येक-पुरुष-त्रिके क्रमेण एकवचन-द्विवचन-बहुवचन-संज्ञाः; विभक्ति-प्रत्ययस्य वचन-संज्ञा अत्र निर्धार्यते। (१.४.१०२)", "chronological_transition": {"from_sutra": "3.1.2", "to_sutra": "1.4.102"}}, {"sutra_id": "1.1.43", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAmasu", "form_after": "rAmasu", "why_dev": "सु-प्रत्ययः (नपुंसकाद् भिन्नः) सर्वनामस्थान-संज्ञकः।", "status": "APPLIED", "why_now_dev": "अनपुंसक (पुं/स्त्री) प्रातिपदिकस्य सुँ-आदिः सर्वनामस्थान-सुप् 'सर्वनामस्थान'-संज्ञां प्राप्नोति; अनया संज्ञया अङ्ग-कार्याणि (यथा ७.१.७० नुम्) प्रवर्तन्ते। (१.१.४३)", "chronological_transition": {"from_sutra": "1.4.102", "to_sutra": "1.1.43"}}, {"sutra_id": "1.4.103", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "rAmasu", "form_after": "rAmasu", "why_dev": "एकविंशति-सुप्-प्रत्ययानाम् 'सुप्' संज्ञा; अनेन १.४.१०४ 'विभक्ति'-संज्ञा-विधाने सुप्-समुच्चयः साधु।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.43", "to_sutra": "1.4.103"}}, {"sutra_id": "1.4.13", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAmasu", "form_after": "rAmasu", "why_dev": "प्रत्यय-विधेर् यस्मात् तदादि प्रत्यये यत् तद् अङ्गम्।", "status": "APPLIED", "why_now_dev": "प्रत्ययात् पूर्वं स्थितः अवयवः अङ्ग-संज्ञकः (प्रत्यये परतः अङ्गम्); अनेन अङ्ग-अधिकार-कार्याणि (६.४.१ आदि) प्रसजन्ति। (१.४.१३)", "chronological_transition": {"from_sutra": "1.4.103", "to_sutra": "1.4.13"}}, {"sutra_id": "1.4.14", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAmasu", "form_after": "rAmasu", "why_dev": "सुप्-अन्तः तिङ्-अन्तः वा शब्दः पद-संज्ञकः (अष्टाध्यायी)।", "status": "APPLIED", "why_now_dev": "सुप्-अन्तः तिङ्-अन्तः वा शब्दः पद-संज्ञकः; अनेन पद-कार्याणि (त्रिपादी-सन्धि-आदि) प्रसजन्ति। (१.४.१४)", "chronological_transition": {"from_sutra": "1.4.13", "to_sutra": "1.4.14"}}, {"sutra_id": "1.3.2", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAmasu", "form_after": "rAmasu", "why_dev": "उपदेशावस्थायाम् अज् वर्णः अनुनासिकः चेद् इत्-संज्ञकः; इँर्-वार्तिके पुनः द्वयोः संयुक्तः इत्। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.4.14", "to_sutra": "1.3.2"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAmasu", "form_after": "rAmasu", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.2", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.4", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAmasu", "form_after": "rAmasu", "why_dev": "विभक्ति-प्रत्यये अन्त्यौ तु-स्म-वर्णौ हलन्त्य-इत् संज्ञां न लभेते; विधिः १.३.३ एव न प्रवर्तते (तुस्मान्त-निषेधः)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.4"}}, {"sutra_id": "1.3.5", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAmasu", "form_after": "rAmasu", "why_dev": "ञ्-इट्-डु-वर्णेषु प्रथमः हल् ‘इत्’ संज्ञकः; लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.4", "to_sutra": "1.3.5"}}, {"sutra_id": "1.3.6", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAmasu", "form_after": "rAmasu", "why_dev": "प्रत्ययस्य आदौ ष्-वर्णः ‘इत्’ संज्ञकः; लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.5", "to_sutra": "1.3.6"}}, {"sutra_id": "1.3.7", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAmasu", "form_after": "rAmasu", "why_dev": "चवर्ग-टवर्गीयः प्रथमः हल् ‘इत्’ संज्ञकः; लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.6", "to_sutra": "1.3.7"}}, {"sutra_id": "1.3.8", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAmasu", "form_after": "rAmasu", "why_dev": "अतद्धिते प्रत्ययादौ ल्-श्-कु-वर्णानाम् इत्-संज्ञा; लोपः १.३.९। सुप्-पङ्क्तिषु ङ्-आदिर् अपि (*N* ∈ *ku*)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.7", "to_sutra": "1.3.8"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmasu", "form_after": "rAmas", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.8", "to_sutra": "1.3.9"}}, {"sutra_id": "1.3.10", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "द्वयोः समसङ्ख्यक-गणयोः मध्ये अनुदेशः यदा, तदा सः सदस्येषु क्रमेण — यथा ६.१.७८ (ए→अय्, ऐ→आय्), ३.१.१३४ (ल्यु्-णिनि-अच्), १.१.४६ (टित्-कित्)। असमसङ्ख्ये (८.२.३९) न; अन्तरतमम् १.१.५० आदि।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "1.3.10"}}, {"sutra_id": "7.1.93", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "सखि-शब्दस्य सौ-प्रत्यये परे 'अनङ्'-आदेशः — अन्त्य-इकारस्य स्थाने [अ,न्] (ṅकार-लोपानन्तरम्): सखि → सखन् → सखान् → सखा।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.10", "to_sutra": "7.1.93"}}, {"sutra_id": "6.4.8", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "असम्बुद्धि-सर्वनामस्थाने परे नपुंसक-अङ्गस्य उपधा-अकारस्य दीर्घः (ज्ञानानि)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.93", "to_sutra": "6.4.8"}}, {"sutra_id": "1.4.7", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "ह्रस्व-इक्-अन्तस्य अङ्गस्य घि-संज्ञा (हरि-प्रकारे प्रयोगाय)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.4.8", "to_sutra": "1.4.7"}}, {"sutra_id": "1.2.41", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "एक-हल्-प्रत्ययः अपृक्त-संज्ञकः (ईट्-आगम ७.३.९६ इत्यादि-प्रसङ्गे)।", "status": "APPLIED", "why_now_dev": "एक-अल् (एक-वर्ण) प्रत्ययः 'अपृक्त'-संज्ञां प्राप्नोति; अनया संज्ञया ईट्-आगम-आदि-विधयः (यथा ७.३.९६) प्रवर्तन्ते। (१.२.४१)", "chronological_transition": {"from_sutra": "1.4.7", "to_sutra": "1.2.41"}}, {"sutra_id": "7.2.106", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "तद्/त्यद्-शब्दयोः सुँ-प्रत्यये परे आद्य-तकारस्य सकारादेशः (सः)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.2.41", "to_sutra": "7.2.106"}}, {"sutra_id": "7.2.102", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "त्यदादि-गण-शब्दानां विभक्ति-प्रत्यये परे अन्त्य-हल्-स्थानि अकार-आदेशः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.2.106", "to_sutra": "7.2.102"}}, {"sutra_id": "6.1.68", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "हल्-अन्तात् / ङी-आभ्-अन्तात् दीर्घात् अङ्गात् परस्य अपृक्त-सु-हल्-लोपः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.2.102", "to_sutra": "6.1.68"}}, {"sutra_id": "6.4.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "६.४.१ तः ७.४.९७ पर्यन्तानि सूत्राणि अङ्गस्य विधयः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "6.1.68", "to_sutra": "6.4.1"}}, {"sutra_id": "7.1.94", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "ऋकारान्ते अनङ्-आदेशः (तृच् + सु)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.4.1", "to_sutra": "7.1.94"}}, {"sutra_id": "6.4.11", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "तृण्-विषये उपधा-दीर्घः सर्वनामस्थाने (चेता-पथ)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.94", "to_sutra": "6.4.11"}}, {"sutra_id": "6.1.66", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "तृच्-पथ: दीर्घात् परस्य अपृक्त हल्-लोपः (सु→स्)। विधि-लिङ्-पथ: यासुट्-अवशेष [i,y] में य्-लोपः हल्-पूर्वे। आशीर्-लिङ्-पथ (२मध्यम-एक): यासुट्-पश्चात् सिप्-जन्य-स्-लोपः। कर्मणि-पथ: ७.२.८१-जन्य इय् में य्-लोपः हल्-पूर्वे (इय्ते→इते)। कर्मणि-विधिलिङ्-पथ: सीयुट्-अवशेष [I,y] में य्-लोपः हल्-पूर्वे। व्योः-वलि-पथ: य्-लोपः व/ल/र/त्-पूर्वम् (**1.1.58**+**6.4.48** पाठ)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.4.11", "to_sutra": "6.1.66"}}, {"sutra_id": "7.1.2", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "तद्धित-प्रत्ययस्य आदौ फ्-ढ्-ख्-छ्-घ्-क्रमेण आयन्-एय्-ईन्-ईय्-इय्-आदेशाः (१.३.१० यथासङ्ख्यम्)। कृत्-सुप्-तिङ्-प्रत्ययेषु न।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.66", "to_sutra": "7.1.2"}}, {"sutra_id": "6.1.97", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "गुणे पररूप-एकादेशः — अकार-द्वय-संयोगे प्रथमम् अकारं लोपयति।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.2", "to_sutra": "6.1.97"}}, {"sutra_id": "7.2.113", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "इदम्-एतद्-शब्दयोर् हल्-वर्णादौ सुपि परे 'इद्'-'एत्'-भागस्य लोपः, ततः 'अ' मात्रेण अदन्त-अङ्गं *सुपि* दीर्घ-योग्यम् (७.३.१०२, १.१.२१)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.97", "to_sutra": "7.2.113"}}, {"sutra_id": "7.3.106", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "(सूत्रम् ७.३.१०६) सम्बुद्धौ च — आबन्त-स्त्रीलिङ्ग-अङ्गस्यान्त्य-आ-कारस्य 'ए'-आदेशः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.2.113", "to_sutra": "7.3.106"}}, {"sutra_id": "6.1.69", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "एङ्-अन्त / ह्रस्व-अन्त अङ्गात् परस्य सम्बुद्धि-एकवचन-सु-प्रत्ययस्य हल्-वर्णस्य लोपः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.3.106", "to_sutra": "6.1.69"}}, {"sutra_id": "7.1.15", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "अदन्त-सर्वनाम-अङ्गात् परयोः ङसि/ङि-प्रत्यययोः क्रमशः ‘स्मात्’/‘स्मिन्’ आदेशौ।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.69", "to_sutra": "7.1.15"}}, {"sutra_id": "7.1.12", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "अदन्त-अङ्गात् परेषां टा/ङसि/ङसाम् क्रमेण इन/आत्/स्य-आदेशाः भवन्ति।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.15", "to_sutra": "7.1.12"}}, {"sutra_id": "7.1.14", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "अदन्त-सर्वनाम-अङ्गात् परस्य ङे-प्रत्ययस्य ‘स्मै’ आदेशः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.12", "to_sutra": "7.1.14"}}, {"sutra_id": "7.3.113", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "आबन्तात् न-सर्वनाम्नः परे ङिति ङे याट्-आगमः; अङ्गे ह्रस्वो न भवति।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.14", "to_sutra": "7.3.113"}}, {"sutra_id": "7.3.114", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "आबन्तात् सर्वनाम्नः परे ङिति सुपि स्याट्-आगमः, अङ्गस्य च ह्रस्वः; ततः वृद्धिः (६.१.८८) इति क्रमः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.3.113", "to_sutra": "7.3.114"}}, {"sutra_id": "7.1.13", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "अदन्त-अङ्गात् परस्य ङे-प्रत्ययस्य 'य'-आदेशः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.3.114", "to_sutra": "7.1.13"}}, {"sutra_id": "7.1.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "अदन्त-अङ्गात् परस्य 'भिस्'-प्रत्ययस्य 'ऐस्'-आदेशः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.13", "to_sutra": "7.1.9"}}, {"sutra_id": "7.1.17", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "अदन्त-सर्वनाम-अङ्गात् परस्य जस्-प्रत्ययस्य ‘शी’-आदेशः (सर्वे)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.9", "to_sutra": "7.1.17"}}, {"sutra_id": "7.1.24", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "अकारान्त-नपुंसक-अङ्गात् परस्य सुँ/अम्-प्रत्ययस्य ‘अम्’-आदेशः (ज्ञानम्)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.17", "to_sutra": "7.1.24"}}, {"sutra_id": "7.1.19", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "नपुंसक-अङ्गात् परस्य औ/औट्-प्रत्ययस्य ‘शी’-आदेशः (ज्ञाने)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.24", "to_sutra": "7.1.19"}}, {"sutra_id": "7.1.20", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "नपुंसक-अङ्गात् परयोः जस्/शस्-प्रत्यययोः ‘शि’-आदेशः (ज्ञानानि)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.19", "to_sutra": "7.1.20"}}, {"sutra_id": "7.1.23", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "नपुंसक-अङ्गात् परयोः सु/अम्-प्रत्यययोः लुक्।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.20", "to_sutra": "7.1.23"}}, {"sutra_id": "1.1.42", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "शि-प्रत्ययः सर्वनामस्थान-संज्ञकः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.23", "to_sutra": "1.1.42"}}, {"sutra_id": "1.4.17", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "असर्वनामस्थान-स्वादि-प्रत्यये परे प्रातिपदिकस्य पदसंज्ञा।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.42", "to_sutra": "1.4.17"}}, {"sutra_id": "1.4.16", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "सिति परे प्रातिपदिकस्य पदसंज्ञा; भसंज्ञां बाधते।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.4.17", "to_sutra": "1.4.16"}}, {"sutra_id": "1.4.18", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "स्वादि-प्रत्यये असर्वनामस्थानके यकारादौ वा अजादौ आदौ च परे प्रकृतेः भ-संज्ञा; पद-संज्ञां (१.४.१७) बाधते।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.4.16", "to_sutra": "1.4.18"}}, {"sutra_id": "7.1.54", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "ह्रस्वान्त-अङ्ग / नदी-आप्-अङ्गात् परस्य आम्-प्रत्ययस्य पराद्यौ 'नुट्' आगमः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.4.18", "to_sutra": "7.1.54"}}, {"sutra_id": "7.1.52", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "अदन्त-सर्वनाम-अङ्गात् परस्य आम्-प्रत्ययस्य आदौ सुट्-आगमः (सर्वेषाम्)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.54", "to_sutra": "7.1.52"}}, {"sutra_id": "1.3.5", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "ञ्-इट्-डु-वर्णेषु प्रथमः हल् ‘इत्’ संज्ञकः; लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.52", "to_sutra": "1.3.5"}}, {"sutra_id": "1.3.7", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "चवर्ग-टवर्गीयः प्रथमः हल् ‘इत्’ संज्ञकः; लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.5", "to_sutra": "1.3.7"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "इत्-संज्ञक-वर्णाः न सन्ति, अतः लोपः शून्यः; तथापि नियम-परीक्षा अनिवार्या (१.३.९)।", "status": "APPLIED_VACUOUS", "lopa_count": 0, "chronological_transition": {"from_sutra": "1.3.7", "to_sutra": "1.3.9"}}, {"sutra_id": "7.1.72", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "नपुंसक-अङ्गस्य सर्वनामस्थाने परे नुम्-आगमः (ज्ञानानि)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "7.1.72"}}, {"sutra_id": "6.4.10", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "सकारान्त-संयोगे (न्+स्) सर्वनामस्थाने परे उपधा-ह्रस्वस्य दीर्घः (धनूंषि, यशांसि)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.72", "to_sutra": "6.4.10"}}, {"sutra_id": "6.4.8", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "असम्बुद्धि-सर्वनामस्थाने परे नपुंसक-अङ्गस्य उपधा-अकारस्य दीर्घः (ज्ञानानि)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.4.10", "to_sutra": "6.4.8"}}, {"sutra_id": "6.4.3", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "नुट्-आगमेन नामि-पर्याये अङ्गस्य अन्त्य-स्वरस्य दीर्घः (हरि → हरी; हरिणाम् → हरीणाम्)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.4.8", "to_sutra": "6.4.3"}}, {"sutra_id": "7.3.103", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "झल्-आदि-बहुवचन-सुप्-प्रत्यये परे अदन्त-अङ्गस्य अन्त्य-अ-कारस्य 'ए'-आदेशः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.4.3", "to_sutra": "7.3.103"}}, {"sutra_id": "7.3.102", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "यञादि-सुप्-प्रत्यये परे अदन्त-अङ्गस्य अन्त्य-अ-कारस्य दीर्घः आ-कारः भवति।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.3.103", "to_sutra": "7.3.102"}}, {"sutra_id": "6.4.129", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "भाधिकारः — ६.४.१२९ तः ६.४.१७५ पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "7.3.102", "to_sutra": "6.4.129"}}, {"sutra_id": "6.4.130", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "भस्य अङ्गे पाद्-अंशस्य पद्-आदेशः (उदा. सुपाद् + टा)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.4.129", "to_sutra": "6.4.130"}}, {"sutra_id": "6.4.134", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "भसंज्ञके नान्ते उपधायाः अकारस्य लोपः (उदा. राजन् + शस्)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.4.130", "to_sutra": "6.4.134"}}, {"sutra_id": "6.4.146", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "भस्य अङ्गस्य अन्त्यस्य ओकारस्य यकारादौ परे गुण आदेशः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.4.134", "to_sutra": "6.4.146"}}, {"sutra_id": "6.4.148", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "भाधिकारे इत्यादौ परे अङ्गान्त्यस्य अ/इ-वर्णस्य लोपः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.4.146", "to_sutra": "6.4.148"}}, {"sutra_id": "7.3.108", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "सम्बुद्धौ (८-१) ह्रस्व-घि-अङ्गस्य गुणः (हरि → हरे)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.4.148", "to_sutra": "7.3.108"}}, {"sutra_id": "7.3.109", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "जस्-प्रत्यये परे ह्रस्व-इक्-अन्त-अङ्गस्य गुणः (हरि → हरे)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.3.108", "to_sutra": "7.3.109"}}, {"sutra_id": "7.3.111", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "घि-संज्ञक-अङ्गात् परे ङिति-सुप्-प्रत्यये गुणः (हरि → हरे ...)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.3.109", "to_sutra": "7.3.111"}}, {"sutra_id": "7.3.119", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "घि-अङ्गात् ङि-प्रत्यये परे ‘हरौ’ इत्यादि-रूपसिद्ध्यर्थम् (अन्तिम-इक् → अ, ङि → औ)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.3.111", "to_sutra": "7.3.119"}}, {"sutra_id": "7.3.120", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "घि-संज्ञक-अङ्गात् परे टा-प्रत्यये ‘ना’ आदेशः (हरि-इत्यादौ हरिणा)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.3.119", "to_sutra": "7.3.120"}}, {"sutra_id": "6.1.102", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "प्रथमा/द्वितीया-बहुवचन-सीमायां अ+अच्-योः पूर्व-सवर्ण-दीर्घः (जस्-प्रत्यये परे 'ज'-वर्णोऽपि पूर्वयोगेन अन्तर्भवति)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.3.120", "to_sutra": "6.1.102"}}, {"sutra_id": "1.1.11", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "द्विवचनान्ते ई-कार-ऊ-कार-ए-ऐ-ओ-औ, ते 'प्रगृह्य' संज्ञिनः; सन्धौ न लोप-ग्रहः (उत्सर्ग-नियमः)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.102", "to_sutra": "1.1.11"}}, {"sutra_id": "6.1.103", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "पुंलिङ्ग-अदन्त-प्रातिपदिकात् परस्य 'शस्'-प्रत्ययस्य पूर्वसवर्ण-दीर्घानन्तरं स-कारस्य न-कारादेशः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.11", "to_sutra": "6.1.103"}}, {"sutra_id": "7.1.92", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "सखि-शब्दात् सर्वनामस्थान-प्रत्यये (सम्बोधनेतर) ṇिद्वद्भावः → अचो ञ्णिति (७.२.११५) वृद्धिः: अन्त्य-इकारस्य ऐकारः → एचोऽयवायावः (६.१.७८): ऐ → आय् → सखाय् + प्रत्ययः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.103", "to_sutra": "7.1.92"}}, {"sutra_id": "6.1.78", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "एचः (ए, ऐ, ओ, औ) स्थाने परे अचि क्रमेण अय्, अव्, आय्, आव् आदेशः (एचोऽयवायावः) — ओस्-विषयकः पूर्वे य्-आगम-वर्णनम् अत्रानुपयुक्तम्। अत्र यथा अङ्गान्ते एच्-वर्णः \"e\" (गुणात्) + परे अच् \"a\" (विकरणादादौ) → \"e\"+\"a\" → \"a\"+\"y\"+\"a\" (अय्) → je+a+… → jay+a+… → jayati। अपरः प्रसङ्गः: अदन्त-अङ्ग + \"ओस्\"-प्रत्यय (a+o) पूर्वे \"य्\"-आगमः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.92", "to_sutra": "6.1.78"}}, {"sutra_id": "6.1.107", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "अम्-प्रत्यये परे पूर्व-रूपम् एकादेशः (अ+अ → अ, दीर्घ-निषेधः)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.78", "to_sutra": "6.1.107"}}, {"sutra_id": "6.1.125", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "प्रगृह्यान्तात् परस्य अच्-आदौ प्रकृतिभावो नित्यः; अत्र संज्ञा-प्रयोगः (सन्धि-विधयः ६.१.१०१/७७ इतरत्र निरुद्धाः)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.107", "to_sutra": "6.1.125"}}, {"sutra_id": "6.1.77", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "इक्-समाप्तेः परे अच्-आदौ यण्-आदेशः — सार्वत्रिकः उत्सर्गः; प्राग्र्ह्य-वर्ज्यम् (१.१.११); अपवादाः यथायोग्यम् (६.१.१०१ इत्यादि)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.125", "to_sutra": "6.1.77"}}, {"sutra_id": "6.1.87", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "अ-कारात् परे इक् वर्णे एकादेश-रूपेण गुणः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.77", "to_sutra": "6.1.87"}}, {"sutra_id": "6.1.88", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "अ-वर्णात् परस्मिन् एच्-वर्णे (ए/ऐ/ओ/औ) एकादेश-रूपेण वृद्धिः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.87", "to_sutra": "6.1.88"}}, {"sutra_id": "6.1.110", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "एङन्त-अङ्गात् परे ङसि/ङस्-प्रत्यययोः आद्य-अकारस्य लोपः (हरेऽसि/हरेऽस् → हरेसि/हरेस् → हरेः)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.88", "to_sutra": "6.1.110"}}, {"sutra_id": "6.1.101", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "अक् वर्णस्य परस्मिन् सवर्णे एकादेशः सवर्ण-दीर्घः भवति; प०३६ ``ninaya``→``ninAya`` (णल्-परिणाम)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.110", "to_sutra": "6.1.101"}}, {"sutra_id": "__MERGE__", "sutra_type": "STRUCTURAL", "type_label": "पद-मेलनम्", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "पद-रचना — सर्व-धातु/सुबन्त/कृदन्त-संयोजनम् (संरचनात्मकं, न सूत्रम्)।", "status": "APPLIED", "event": "MERGE"}, {"sutra_id": "1.4.110", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "विरामः अवसान-संज्ञकः — खर्-अवसानयोः विसर्जनीये प्रसङ्गः।", "status": "APPLIED", "why_now_dev": "पद-समाप्तौ विरामः अवसान-संज्ञकः; अनेन खर्-अवसानयोः विसर्जनीय-प्रसङ्गः सिध्यति। (१.४.११०)", "chronological_transition": {"from_sutra": "6.1.101", "to_sutra": "1.4.110"}}, {"sutra_id": "8.2.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "८.२.१ तः ८.४.६८ पर्यन्तम् (त्रिपादी) पूर्व-सूत्रेभ्यः असिद्धम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.4.110", "to_sutra": "8.2.1"}}, {"sutra_id": "8.2.7", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmas", "why_dev": "प्रातिपदिकान्त्यवर्णे नकारस्य लोपः (चेता-पथ)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.1", "to_sutra": "8.2.7"}}, {"sutra_id": "8.2.66", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmas", "form_after": "rAmar", "why_dev": "पदान्त-सकारस्य सजुषः च रु-आदेशः (त्रिपादी)।", "status": "APPLIED", "why_now_dev": "पदान्त-सकारस्य 'रु'-आदेशः (त्रिपादी); अयं रु पुनः ८.३.१५ इति खर्/अवसाने विसर्गः, अन्यत्र (घोष-हलि) रेफः अवशिष्यते। (८.२.६६)", "chronological_transition": {"from_sutra": "8.2.7", "to_sutra": "8.2.66"}}, {"sutra_id": "8.3.15", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmar", "form_after": "rAmaH", "why_dev": "खर्-वर्णे परे अवसाने च रु-आदेशस्य विसर्गः।", "status": "APPLIED", "why_now_dev": "खर्-वर्णे परे अवसाने च 'रु' (८.२.६६) इत्यस्य विसर्गः (ः); एवं रामः, धनुः इति विसर्गान्त-रूपं सिध्यति। (८.३.१५)", "chronological_transition": {"from_sutra": "8.2.66", "to_sutra": "8.3.15"}}, {"sutra_id": "8.3.59", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmaH", "form_after": "rAmaH", "why_dev": "इन्-कुक्-पूर्वे स-कारस्य (प्रत्ययस्थस्य) 'ष'-आदेशः (त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.15", "to_sutra": "8.3.59"}}, {"sutra_id": "8.4.1", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmaH", "form_after": "rAmaH", "why_dev": "समानपदे रेफ-ष-वर्णाभ्यां (ऋवर्णाद् अपि) ऋणे परस्य न-कारस्य सन्निहिते णादेशः (१०८ संहितायाम्, त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.59", "to_sutra": "8.4.1"}}, {"sutra_id": "8.4.2", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "rAmaH", "form_after": "rAmaH", "why_dev": "र-ष-वर्णात् परस्य न-कारस्य णत्वम् — अट्-कु-पु-आङ्-नुम् व्यवधाने अपि (त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.1", "to_sutra": "8.4.2"}}]}