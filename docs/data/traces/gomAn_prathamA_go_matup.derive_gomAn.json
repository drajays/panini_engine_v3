HIKARA", "type_label": "अधिकार", "form_before": "gomants", "form_after": "gomants", "why_dev": "६.४.१ तः ७.४.९७ पर्यन्तानि सूत्राणि अङ्गस्य विधयः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "7.1.70", "to_sutra": "6.4.1"}}, {"sutra_id": "6.4.14", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomants", "form_after": "gomAnts", "why_dev": "अत्वन्त-अङ्गस्य उपधा-अचः दीर्घः सर्वनामस्थाने परि।", "status": "APPLIED", "chronological_transition": {"from_sutra": "6.4.1", "to_sutra": "6.4.14"}}, {"sutra_id": "1.2.41", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "gomAnts", "form_after": "gomAnts", "why_dev": "एक-हल्-प्रत्ययः अपृक्त-संज्ञकः (ईट्-आगम ७.३.९६ इत्यादि-प्रसङ्गे)।", "status": "APPLIED", "why_now_dev": "एक-अल् (एक-वर्ण) प्रत्ययः 'अपृक्त'-संज्ञां प्राप्नोति; अनया संज्ञया ईट्-आगम-आदि-विधयः (यथा ७.३.९६) प्रवर्तन्ते। (१.२.४१)", "chronological_transition": {"from_sutra": "6.4.14", "to_sutra": "1.2.41"}}, {"sutra_id": "6.1.68", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAnts", "form_after": "gomAnt", "why_dev": "हल्-अन्तात् / ङी-आभ्-अन्तात् दीर्घात् अङ्गात् परस्य अपृक्त-सु-हल्-लोपः।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.2.41", "to_sutra": "6.1.68"}}, {"sutra_id": "1.4.14", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "gomAnt", "form_after": "gomAnt", "why_dev": "सुप्-अन्तः तिङ्-अन्तः वा शब्दः पद-संज्ञकः (अष्टाध्यायी)।", "status": "APPLIED", "why_now_dev": "सुप्-अन्तः तिङ्-अन्तः वा शब्दः पद-संज्ञकः; अनेन पद-कार्याणि (त्रिपादी-सन्धि-आदि) प्रसजन्ति। (१.४.१४)", "chronological_transition": {"from_sutra": "6.1.68", "to_sutra": "1.4.14"}}, {"sutra_id": "1.1.7", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "gomAnt", "form_after": "gomAnt", "why_dev": "ये हल्-वर्णाः अनन्तराः, न च अच्-अन्तरः, ते 'संयोग' इति संज्ञинः।", "status": "APPLIED", "why_now_dev": "अनन्तराः (मध्ये अच्-रहिताः) हल्-वर्णाः 'संयोग'-संज्ञां प्राप्नुवन्ति; इयं संज्ञा संयोगाश्रित-विधिषु (यथा ८.२.२३, ६.१.६८) उपयुज्यते। (१.१.७)", "chronological_transition": {"from_sutra": "1.4.14", "to_sutra": "1.1.7"}}, {"sutra_id": "__MERGE__", "sutra_type": "STRUCTURAL", "type_label": "पद-मेलनम्", "form_before": "gomAnt", "form_after": "gomAnt", "why_dev": "पद-रचना — सर्व-धातु/सुबन्त/कृदन्त-संयोजनम् (संरचनात्मकं, न सूत्रम्)।", "status": "APPLIED", "event": "MERGE"}, {"sutra_id": "8.2.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "gomAnt", "form_after": "gomAnt", "why_dev": "८.२.१ तः ८.४.६८ पर्यन्तम् (त्रिपादी) पूर्व-सूत्रेभ्यः असिद्धम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.7", "to_sutra": "8.2.1"}}, {"sutra_id": "8.2.23", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAnt", "form_after": "gomAn", "why_dev": "संयोगान्त-पदस्य अन्त्य-हल्-लोपः (चितवान्)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "8.2.1", "to_sutra": "8.2.23"}}]}