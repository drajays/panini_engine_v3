{"module": "pipelines.gomAn_prathamA_go_matup", "callable": "derive_gomAn", "ok": true, "smoke_note": null, "invocation": {"args": [], "kwargs": {}}, "result_kind": "state", "final_flat_slp1": "gomAn", "phase": "angakarya", "tripadi_zone": true, "trace_len": 25, "trace": [{"sutra_id": "5.2.94", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gojas", "form_after": "gojasmatup", "why_dev": "‘तदस्य अस्ति’ इत्यर्थे मतुप्-प्रत्ययः (गोमान्-प्रक्रिया)।", "status": "APPLIED", "chronological_transition": {"from_sutra": null, "to_sutra": "5.2.94"}}, {"sutra_id": "1.2.46", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "gojasmatup", "form_after": "gojasmatup", "why_dev": "कृत्-तद्धित-समासान्ताः शब्दाः प्रातिपदिक-संज्ञकाः।", "status": "APPLIED", "chronological_transition": {"from_sutra": "5.2.94", "to_sutra": "1.2.46"}}, {"sutra_id": "2.4.71", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gojasmatup", "form_after": "gomatup", "why_dev": "धातु/प्रातिपदिक-अवयवे विद्यमानस्य सुपः लुक् (आर्म्ड-मेटा)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.2.46", "to_sutra": "2.4.71"}}, {"sutra_id": "1.1.62", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "gomatup", "form_after": "gomatup", "why_dev": "प्रत्ययस्य लोपे कृते अपि प्रत्ययाश्रितं कार्यम् अवश्यं भवति — यथा नदी+सुँ → नदी (६.१.६८) इत्यत्र पदम् १.४.१४; षष्+जस् → षड् (७.१.२२ लुक्); अदस्+सुँ → असौ (७.२.१०६); अग्निचित् (६.१.७१); अधुक् (७.३.८६, ८.२.३२)। अङ्गकार्ये अपवादः १.१.६३।", "status": "AUDIT", "chronological_transition": {"from_sutra": "2.4.71", "to_sutra": "1.1.62"}}, {"sutra_id": "1.4.13", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "gomatup", "form_after": "gomatup", "why_dev": "प्रत्यय-विधेर् यस्मात् तदादि प्रत्यये यत् तद् अङ्गम्।", "status": "APPLIED", "why_now_dev": "प्रत्ययात् पूर्वं स्थितः अवयवः अङ्ग-संज्ञकः (प्रत्यये परतः अङ्गम्); अनेन अङ्ग-अधिकार-कार्याणि (६.४.१ आदि) प्रसजन्ति। (१.४.१३)", "chronological_transition": {"from_sutra": "1.1.62", "to_sutra": "1.4.13"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "gomatup", "form_after": "gomatup", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.4.13", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.2", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "gomatup", "form_after": "gomatup", "why_dev": "उपदेशावस्थायाम् अज् वर्णः अनुनासिकः चेद् इत्-संज्ञकः; इँर्-वार्तिके पुनः द्वयोः संयुक्तः इत्। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.2"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomatup", "form_after": "gomat", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.2", "to_sutra": "1.3.9"}}, {"sutra_id": "1.3.10", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "gomat", "form_after": "gomat", "why_dev": "द्वयोः समसङ्ख्यक-गणयोः मध्ये अनुदेशः यदा, तदा सः सदस्येषु क्रमेण — यथा ६.१.७८ (ए→अय्, ऐ→आय्), ३.१.१३४ (ल्यु्-णिनि-अच्), १.१.४६ (टित्-कित्)। असमसङ्ख्ये (८.२.३९) न; अन्तरतमम् १.१.५० आदि।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "1.3.10"}}, {"sutra_id": "__GOMAN_MERGE__", "sutra_type": "STRUCTURAL", "type_label": "गोमत्-मेलनम्", "form_before": "gomat", "form_after": "gomat", "why_dev": "अङ्ग+मतुप्-शेषयोः संयोजनम् (संरचनात्मकं, न सूत्रम्)।", "status": "APPLIED"}, {"sutra_id": "4.1.2", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "gomat", "form_after": "gomatsu", "why_dev": "एकविंशति सुप्-प्रत्ययाः क्रमेण प्रातिपदिकात् विधीयन्ते; अधि