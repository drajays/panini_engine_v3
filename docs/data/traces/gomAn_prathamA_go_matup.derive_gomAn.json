{"module": "pipelines.gomAn_prathamA_go_matup", "callable": "derive_gomAn", "ok": true, "smoke_note": null, "invocation": {"args": [], "kwargs": {}}, "result_kind": "state", "final_flat_slp1": "gomAn", "phase": "angakarya", "tripadi_zone": true, "trace_len": 54, "trace": [{"sutra_id": "5.2.94", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gojas", "form_after": "gojasmatup", "why_dev": "‘तदस्य अस्ति’ इत्यर्थे मतुप्-प्रत्ययः (गोमान्-प्रक्रिया)।", "status": "APPLIED", "chronological_transition": {"from_sutra": null, "to_sutra": "5.2.94"}}, {"sutra_id": "1.2.46", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "gojasmatup", "form_after": "gojasmatup", "why_dev": "कृत्-तद्धित-समासान्ताः शब्दाः प्रातिपदिक-संज्ञकाः।", "status": "APPLIED", "chronological_transition": {"from_sutra": "5.2.94", "to_sutra": "1.2.46"}}, {"sutra_id": "2.4.71", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gojasmatup", "form_after": "gomatup", "why_dev": "धातु/प्रातिपदिक-अवयवे विद्यमानस्य सुपः लुक् (आर्म्ड-मेटा)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.2.46", "to_sutra": "2.4.71"}}, {"sutra_id": "1.1.62", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "gomatup", "form_after": "gomatup", "why_dev": "प्रत्ययस्य लोपे कृते अपि प्रत्ययाश्रितं कार्यम् अवश्यं भवति — यथा नदी+सुँ → नदी (६.१.६८) इत्यत्र पदम् १.४.१४; षष्+जस् → षड् (७.१.२२ लुक्); अदस्+सुँ → असौ (७.२.१०६); अग्निचित् (६.१.७१); अधुक् (७.३.८६, ८.२.३२)। अङ्गकार्ये अपवादः १.१.६३।", "status": "VACUOUS", "chronological_transition": {"from_sutra": "2.4.71", "to_sutra": "1.1.62"}}, {"sutra_id": "1.4.13", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "gomatup", "form_after": "gomatup", "why_dev": "प्रत्यय-विधेर् यस्मात् तदादि प्रत्यये यत् तद् अङ्गम्।", "status": "DEFINED", "chronological_transition": {"from_sutra": "1.1.62", "to_sutra": "1.4.13"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "gomatup", "form_after": "gomatup", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.4.13", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.2", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "gomatup", "form_after": "gomatup", "why_dev": "उपदेशावस्थायाम् अज् वर्णः अनुनासिकः चेद् इत्-संज्ञकः; इँर्-वार्तिके पुनः द्वयोः संयुक्तः इत्। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.2"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomatup", "form_after": "gomat", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.2", "to_sutra": "1.3.9"}}, {"sutra_id": "1.3.10", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "gomat", "form_after": "gomat", "why_dev": "द्वयोः समसङ्ख्यक-गणयोः मध्ये अनुदेशः यदा, तदा सः सदस्येषु क्रमेण — यथा ६.१.७८ (ए→अय्, ऐ→आय्), ३.१.१३४ (ल्यु्-णिनि-अच्), १.१.४६ (टित्-कित्)। असमसङ्ख्ये (८.२.३९) न; अन्तरतमम् १.१.५० आदि।", "status": "VACUOUS", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "1.3.10"}}, {"sutra_id": "__GOMAN_MERGE__", "sutra_type": "STRUCTURAL", "type_label": "गोमत्-मेलनम्", "form_before": "gomat", "form_after": "gomat", "why_dev": "अङ्ग+मतुप्-शेषयोः संयोजनम् (संरचनात्मकं, न सूत्रम्)।", "status": "APPLIED"}, {"sutra_id": "4.1.2", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomat", "form_after": "gomatsu", "why_dev": "एकविंशति सुप्-प्रत्ययाः क्रमेण प्रातिपदिकात् विधीयन्ते; अधिकारः ४.१.२ तः ५.४.१६० पर्यन्तम्।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.10", "to_sutra": "4.1.2"}}, {"sutra_id": "1.3.2", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "gomatsu", "form_after": "gomatsu", "why_dev": "उपदेशावस्थायाम् अज् वर्णः अनुनासिकः चेद् इत्-संज्ञकः; इँर्-वार्तिके पुनः द्वयोः संयुक्तः इत्। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "4.1.2", "to_sutra": "1.3.2"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomatsu", "form_after": "gomats", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.2", "to_sutra": "1.3.9"}}, {"sutra_id": "1.1.43", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "gomats", "form_after": "gomats", "why_dev": "सु-प्रत्ययः (नपुंसकाद् भिन्नः) सर्वनामस्थान-संज्ञकः।", "status": "APPLIED", "why_now_dev": "अनपुंसक (पुं/स्त्री) प्रातिपदिकस्य सुँ-आदिः सर्वनामस्थान-सुप् 'सर्वनामस्थान'-संज्ञां प्राप्नोति; अनया संज्ञया अङ्ग-कार्याणि (यथा ७.१.७० नुम्) प्रवर्तन्ते। (१.१.४३)", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "1.1.43"}}, {"sutra_id": "1.1.47", "sutra_type": "NIYAMA", "type_label": "नियम", "form_before": "gomats", "form_after": "gomats", "why_dev": "मित्-आदेशः अङ्गस्य अन्त्य-अच् वर्णात् परः स्थाप्यते।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.1.43", "to_sutra": "1.1.47"}}, {"sutra_id": "7.1.70", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomats", "form_after": "gomants", "why_dev": "उगित्-अङ्गस्य सर्वनामस्थाने परे नुम्-आगमः (चितवन्त्)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.1.47", "to_sutra": "7.1.70"}}, {"sutra_id": "6.4.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "gomants", "form_after": "gomants", "why_dev": "६.४.१ तः ७.४.९७ पर्यन्तानि सूत्राणि अङ्गस्य विधयः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "7.1.70", "to_sutra": "6.4.1"}}, {"sutra_id": "6.4.14", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomants", "form_after": "gomAnts", "why_dev": "अत्वन्त-अङ्गस्य उपधा-अचः दीर्घः सर्वनामस्थाने परि।", "status": "APPLIED", "chronological_transition": {"from_sutra": "6.4.1", "to_sutra": "6.4.14"}}, {"sutra_id": "1.2.41", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "gomAnts", "form_after": "gomAnts", "why_dev": "एक-हल्-प्रत्ययः अपृक्त-संज्ञकः (ईट्-आगम ७.३.९६ इत्यादि-प्रसङ्गे)।", "status": "APPLIED", "why_now_dev": "एक-अल् (एक-वर्ण) प्रत्ययः 'अपृक्त'-संज्ञां प्राप्नोति; अनया संज्ञया ईट्-आगम-आदि-विधयः (यथा ७.३.९६) प्रवर्तन्ते। (१.२.४१)", "chronological_transition": {"from_sutra": "6.4.14", "to_sutra": "1.2.41"}}, {"sutra_id": "6.1.68", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAnts", "form_after": "gomAnt", "why_dev": "हल्-अन्तात् / ङी-आभ्-अन्तात् दीर्घात् अङ्गात् परस्य अपृक्त-सु-हल्-लोपः।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.2.41", "to_sutra": "6.1.68"}}, {"sutra_id": "1.4.14", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "gomAnt", "form_after": "gomAnt", "why_dev": "सुप्-अन्तः तिङ्-अन्तः वा शब्दः पद-संज्ञकः (अष्टाध्यायी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.68", "to_sutra": "1.4.14"}}, {"sutra_id": "1.1.7", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "gomAnt", "form_after": "gomAnt", "why_dev": "ये हल्-वर्णाः अनन्तराः, न च अच्-अन्तरः, ते 'संयोग' इति संज्ञинः।", "status": "DEFINED", "chronological_transition": {"from_sutra": "1.4.14", "to_sutra": "1.1.7"}}, {"sutra_id": "__MERGE__", "sutra_type": "STRUCTURAL", "type_label": "पद-मेलनम्", "form_before": "gomAnt", "form_after": "gomAnt", "why_dev": "पद-रचना — सर्व-धातु/सुबन्त/कृदन्त-संयोजनम् (संरचनात्मकं, न सूत्रम्)।", "status": "APPLIED", "event": "MERGE"}, {"sutra_id": "8.2.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "gomAnt", "form_after": "gomAnt", "why_dev": "८.२.१ तः ८.४.६८ पर्यन्तम् (त्रिपादी) पूर्व-सूत्रेभ्यः असिद्धम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.7", "to_sutra": "8.2.1"}}, {"sutra_id": "8.2.23", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAnt", "form_after": "gomAn", "why_dev": "संयोगान्त-पदस्य अन्त्य-हल्-लोपः (चितवान्)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "8.2.1", "to_sutra": "8.2.23"}}, {"sutra_id": "8.2.25", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "(सूत्रम् 8.2.25) धि च।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.23", "to_sutra": "8.2.25"}}, {"sutra_id": "8.2.27", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "ह्रस्वान्ताद् अङ्गात् परस्य सिचः सस्य लोपो झलि — अकृत।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.25", "to_sutra": "8.2.27"}}, {"sutra_id": "8.2.26", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "झलो झलि परे लोपः — प०३३ (घ्स्-त-)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.27", "to_sutra": "8.2.26"}}, {"sutra_id": "8.2.36", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "व्रश्चभ्रस्ज…च्छशां षः: a dhātu-final श्/छ् (and सृज्, मृज्, यज्, राज्, भ्राज्) → ष् before a jhal or at the pada end (apavāda of 8.2.30) — दंश्+स्य, सृज्+त → सृष्ट.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.26", "to_sutra": "8.2.36"}}, {"sutra_id": "8.2.30", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "झलि/पदान्ते परे च-वर्णस्य क-वर्णादेशः (उक्त-उपपत्ति)। प००३-ए: त्रिपादी-प्रवेशात् पूर्वम् अनुमतम्।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.36", "to_sutra": "8.2.30"}}, {"sutra_id": "8.2.32", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "दादेर्धातोर्घः: the ह् of a द्-initial dhātu → घ् (apavāda of 8.2.31) — दुह् → दुघ्, दह् → दघ्.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.30", "to_sutra": "8.2.32"}}, {"sutra_id": "8.2.34", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "नहो धः: the ह् of नह् → ध् (apavāda of 8.2.31) — नह्+त → नद्ध.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.32", "to_sutra": "8.2.34"}}, {"sutra_id": "8.2.31", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "हो ढः: ह् → ढ् before a jhal or at the pada end — लिह्+स्य → लिढ्+स्य.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.34", "to_sutra": "8.2.31"}}, {"sutra_id": "8.2.37", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "एकाचो बशो भष् झषन्तस्य स्ध्वोः: a one-vowel dhātu beginning with बश् and ending in झष् aspirates its initial before स्/ध्व् or at the end — दुघ्+स्य → धुघ्+स्य (धोक्ष्यति).", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.31", "to_sutra": "8.2.37"}}, {"sutra_id": "8.2.39", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "पदान्ते झल्-व्यञ्जनस्य स्थाने जश्-व्यञ्जनः (सूत्रम् ८.२.३९ झलां जशोऽन्ते) — त् → द्।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.37", "to_sutra": "8.2.39"}}, {"sutra_id": "8.2.40", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "झष्-पूर्वे त्/थ् का ध्-आदेशः (डेमो: रुणद्धि; प००१-डि पूर्व-त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.39", "to_sutra": "8.2.40"}}, {"sutra_id": "8.2.41", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "षढोः कः सि: ष्/ढ् before स् → क् — लेढ्+स्य → लेक्+स्य.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.40", "to_sutra": "8.2.41"}}, {"sutra_id": "8.2.66", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "पदान्त-सकारस्य सजुषः च रु-आदेशः (त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.41", "to_sutra": "8.2.66"}}, {"sutra_id": "8.2.77", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "धातोः र्वोः पूर्वस्य इकः दीर्घः हलि परे (दीव्यति)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.66", "to_sutra": "8.2.77"}}, {"sutra_id": "8.2.78", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "धातोः उपधाभूतयोः र्वोः पूर्वस्य इकः दीर्घः (मूर्वति)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.77", "to_sutra": "8.2.78"}}, {"sutra_id": "8.3.15", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "खर्-वर्णे परे अवसाने च रु-आदेशस्य विसर्गः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.78", "to_sutra": "8.3.15"}}, {"sutra_id": "8.3.24", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "अपदान्त-नकारस्य झलि परे अनुस्वारः (डेमो: मुञ्चति)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.15", "to_sutra": "8.3.24"}}, {"sutra_id": "8.3.59", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "इन्-कुक्-पूर्वे स-कारस्य (प्रत्ययस्थस्य) 'ष'-आदेशः (त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.24", "to_sutra": "8.3.59"}}, {"sutra_id": "8.3.60", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "वसादौ (सम्प्रसारणोत्तरं) सस्य षत्वं (उषित्वा)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.59", "to_sutra": "8.3.60"}}, {"sutra_id": "8.4.1", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "समानपदे रेफ-ष-वर्णाभ्यां (ऋवर्णाद् अपि) ऋणे परस्य न-कारस्य सन्निहिते णादेशः (१०८ संहितायाम्, त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.60", "to_sutra": "8.4.1"}}, {"sutra_id": "8.4.2", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "र-ष-वर्णात् परस्य न-कारस्य णत्वम् — अट्-कु-पु-आङ्-नुम् व्यवधाने अपि (त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.1", "to_sutra": "8.4.2"}}, {"sutra_id": "8.4.40", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "चवर्गे परे स्तोः श्चुनेन श्चुः (डेमो: दधि+छत्रम्); ष्टुणा-शाखा पुरातन-मार्ज्वि-मार्गे।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.2", "to_sutra": "8.4.40"}}, {"sutra_id": "8.4.41", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "ष्-समीपे तकारस्य टकारादेशः; प०३१ न्→ण्; P001-B पूर्व-त्रिपादी ``z``+``t``।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.40", "to_sutra": "8.4.41"}}, {"sutra_id": "8.4.53", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "झशि परे झल्-वर्णस्य जश्-आदेशः (डेमो: ध् → द्; प००१-डि पूर्व-त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.41", "to_sutra": "8.4.53"}}, {"sutra_id": "8.4.54", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "अभ्यास-स्थिते झश्-वर्णस्य जश्-आदेशः (भि→बि) — विभिदतुः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.53", "to_sutra": "8.4.54"}}, {"sutra_id": "8.4.55", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "खरि परे झल्-कार्यम् (द्→त्); प०३१—प०३४ ग्लास्-बॉक्स् पूरणम्।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.54", "to_sutra": "8.4.55"}}, {"sutra_id": "8.4.56", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "(सूत्रम् 8.4.56) वाऽवसाने।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.55", "to_sutra": "8.4.56"}}, {"sutra_id": "8.4.58", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "ययि परे अनुस्वारस्य परसवर्णः (डेमो: मुञ्चति)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.56", "to_sutra": "8.4.58"}}, {"sutra_id": "8.4.68", "sutra_type": "ANUVADA", "type_label": "अनुवाद", "form_before": "gomAn", "form_after": "gomAn", "why_dev": "(सूत्रम् 8.4.68) अ अ इति।", "status": "VACUOUS", "chronological_transition": {"from_sutra": "8.4.58", "to_sutra": "8.4.68"}}]}