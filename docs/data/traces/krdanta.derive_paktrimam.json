ore": "pactrim", "form_after": "paktrim", "why_dev": "झलि/पदान्ते परे च-वर्णस्य क-वर्णादेशः (उक्त-उपपत्ति)। प००३-ए: त्रिपादी-प्रवेशात् पूर्वम् अनुमतम्।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.10", "to_sutra": "8.2.30"}}, {"sutra_id": "__MERGE__", "sutra_type": "STRUCTURAL", "type_label": "पद-मेलनम्", "form_before": "paktrim", "form_after": "paktrim", "why_dev": "पद-रचना — सर्व-धातु/सुबन्त/कृदन्त-संयोजनम् (संरचनात्मकं, न सूत्रम्)।", "status": "APPLIED", "event": "MERGE"}, {"sutra_id": "1.2.46", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "paktrim", "form_after": "paktrim", "why_dev": "कृत्-तद्धित-समासान्ताः शब्दाः प्रातिपदिक-संज्ञकाः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.30", "to_sutra": "1.2.46"}}, {"sutra_id": "4.1.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "paktrim", "form_after": "paktrim", "why_dev": "प्रातिपदिकाधिकारः — ४.१.१ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.2.46", "to_sutra": "4.1.1"}}, {"sutra_id": "1.2.45", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "paktrim", "form_after": "paktrim", "why_dev": "धातु-प्रत्यय-प्रत्ययान्त-वर्जितम् अर्थवच्छब्दरूपं प्रातिपदिकसंज्ञकम्।", "status": "APPLIED", "why_now_dev": "अर्थवत्-शब्दरूपं धातु-प्रत्यय-प्रत्ययान्त-वर्जितम् इति प्रातिपदिक-संज्ञां लभते (अव्युत्पन्न-प्रातिपदिकम्)। (१.२.४५)", "chronological_transition": {"from_sutra": "4.1.1", "to_sutra": "1.2.45"}}, {"sutra_id": "4.1.2", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "paktrim", "form_after": "paktrimsu", "why_dev": "एकविंशति सुप्-प्रत्ययाः क्रमेण प्रातिपदिकात् विधीयन्ते; अधिकारः ४.१.२ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.2.45", "to_sutra": "4.1.2"}}, {"sutra_id": "7.1.24", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "paktrimsu", "form_after": "paktrimam", "why_dev": "अ