jas", "form_after": "yaSI", "why_dev": "अदन्त-सर्वनाम-अङ्गात् परस्य जस्-प्रत्ययस्य ‘शी’-आदेशः (सर्वे)।", "status": "APPLIED", "parts": [["ya", "prakriti", "yad"], ["SI", "sup", "SI"]], "chronological_transition": {"from_sutra": "6.1.97", "to_sutra": "7.1.17"}}, {"sutra_id": "1.3.2", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "yaSI", "form_after": "yaSI", "why_dev": "उपदेशावस्थायाम् अज् वर्णः अनुनासिकः चेद् इत्-संज्ञकः; इँर्-वार्तिके पुनः द्वयोः संयुक्तः इत्। लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.17", "to_sutra": "1.3.2"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "yaSI", "form_after": "yaSI", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.2", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.4", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "yaSI", "form_after": "yaSI", "why_dev": "विभक्ति-प्रत्यये अन्त्यौ तु-स्म-वर्णौ हलन्त्य-इत् संज्ञां न लभेते; विधिः १.३.३ एव न प्रवर्तते (तुस्मान्त-निषेधः)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.4"}}, {"sutra_id": "1.3.5", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "yaSI", "form_after": "yaSI", "why_dev": "धातोः आदौ ञि-टु-डु इति समुदायः ‘इत्’ संज्ञकः; लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.4", "to_sutra": "1.3.5"}}, {"sutra_id": "1.3.6", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "yaSI", "form_after": "yaSI", "why_dev": "प्रत्ययस्य आदौ ष्-वर्णः ‘इत्’ संज्ञकः; लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.5", "to_sutra": "1.3.6"}}, {"sutra_id": "1.3.7", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "yaSI", "form_after": "yaSI", "why_dev": "प्रत्ययस्य आदौ चवर्ग-टवर्गीयः वर्णः ‘इत्’ संज्ञकः; लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.6", "to_sutra": "1.3.7"}}, {"sutra_id": "1.3.8", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "yaSI", "form_after": "yaSI", "why_dev": "अतद्धिते प्रत्ययादौ ल्-श्-कु-वर्णानाम् इत्-संज्ञा; लोपः १.३.९। सुप्-पङ्क्तिषु ङ्-आदिर् अपि (*N* ∈ *ku*)।", "status": "APPLIED", "why_now_dev": "अतद्धित-प्रत्ययस्य आदौ ल्/श्/कवर्ग-वर्णः 'इत्'-संज्ञां प्राप्नोति; अयं वर्णः अनन्तरं १.३.९ इति लुप्यते (यथा शप् → अ, ङी → ई)। (१.३.८)", "parts": [["ya", "prakriti", "yad"], ["SI", "sup", "SI"]], "chronological_transition": {"from_sutra": "1.3.7", "to_sutra": "1.3.8"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "yaSI", "form_after": "yaI", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः (तस्य लोपः): शी — श् → शित् (१.३.८)। (१.३.९)", "parts": [["ya", "prakriti", "yad"], ["I", "sup", "SI"]], "chronological_transition": {"from_sutra": "1.3.8", "to_sutra": "1.3.9"}}, {"sutra_id": "6.1.87", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "yaI", "form_after": "ye", "why_dev": "अ-कारात् परे इक् वर्णे एकादेश-रूपेण गुणः।", "status": "APPLIED", "why_now_dev": "अ/आ-कारात् परे इक्-वर्णे (इ/उ/ऋ/ऌ) सति उभयोः स्थाने एकः गुण-वर्णः आदिश्यते; यथा अ+इ → ए, अ+उ → ओ (एकादेश-गुण-सन्धिः)। (६.१.८७)", "parts": [["ye", "prakriti", "yad"], ["", "sup", "SI"]], "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "6.1.87"}}, {"sutra_id": "8.2.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "ye", "form_after": "ye", "why_dev": "८.२.१ तः ८.४.६८ पर्यन्तम् (त्रिपादी) पूर्व-सूत्रेभ्यः असिद्धम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "6.1.87", "to