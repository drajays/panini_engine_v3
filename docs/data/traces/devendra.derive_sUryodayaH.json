{"module": "pipelines.devendra", "callable": "derive_sUryodayaH", "ok": true, "smoke_note": null, "invocation": {"args": [], "kwargs": {}}, "result_kind": "state", "final_flat_slp1": "sUryodayaH", "phase": "angakarya", "tripadi_zone": true, "trace_len": 41, "trace": [{"sutra_id": "2.1.3", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "sUryaAmudayasu", "form_after": "sUryaAmudayasu", "why_dev": "२.१.३ इत्यतः २.२.३८ पर्यन्तं 'समास' अधिकारः प्रवर्तते।", "status": "AUDIT", "chronological_transition": {"from_sutra": null, "to_sutra": "2.1.3"}}, {"sutra_id": "2.4.71", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sUryaAmudayasu", "form_after": "sUryaudaya", "why_dev": "धातु/प्रातिपदिक-अवयवे विद्यमानस्य सुपः लुक् (आर्म्ड-मेटा)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "2.1.3", "to_sutra": "2.4.71"}}, {"sutra_id": "1.1.2", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sUryaudaya", "form_after": "sUryaudaya", "why_dev": "अ, ए, ओ इति गुण-संज्ञाः भवन्ति।", "status": "APPLIED", "why_now_dev": "अ, ए, ओ — एते वर्णाः 'गुण'-संज्ञां प्राप्नुवन्ति; इयं संज्ञा गुण-वृद्धि-विधिषु (यथा ७.३.८४ सार्वधातुकार्धधातुकयोः) उपयुज्यते। (१.१.२)", "chronological_transition": {"from_sutra": "2.4.71", "to_sutra": "1.1.2"}}, {"sutra_id": "1.1.3", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "sUryaudaya", "form_after": "sUryaudaya", "why_dev": "यत्र गुण-वृद्धी उत्सर्गतः, न च स्थानी षष्ठ्यन्तं निर्दिष्टः, तत्र स्थानी इक्-वर्ण एव; अत्र तत्-परिभाषा-द्वारा निश्चयः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.2", "to_sutra": "1.1.3"}}, {"sutra_id": "1.1.4", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "sUryaudaya", "form_after": "sUryaudaya", "why_dev": "आर्धधातुके क्षेपे सति यदि धातु-लोपः, तदा १.१.३-वर्णितः इक-स्थानिन्-नियमो गुण-वृद्धि-क्रियायै न प्रवर्तते।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.3", "to_sutra": "1.1.4"}}, {"sutra_id": "1.1.5", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "sUryaudaya", "form_after": "sUryaudaya", "why_dev": "क्‍ङ्-परिच्छिन्ने प्रत्यय-क्षेपे, तस्मिन् आङ्ग-कार्ये, यः १.१.३-उत्सर्ग-इक-नियमः, सो न।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.4", "to_sutra": "1.1.5"}}, {"sutra_id": "1.1.6", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "sUryaudaya", "form_after": "sUryaudaya", "why_dev": "इडागम-इकारस्य गुणनिषेधः (परिभाषा-गेट)।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.5", "to_sutra": "1.1.6"}}, {"sutra_id": "1.1.50", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "sUryaudaya", "form_after": "sUryaudaya", "why_dev": "आदेश-चयनस्य परिभाषा — स्थाने (उच्चारण-स्थान-प्रयत्नादि-साम्ये) अन्तरतमः विकल्प्यते।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.6", "to_sutra": "1.1.50"}}, {"sutra_id": "6.1.87", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sUryaudaya", "form_after": "sUryodaya", "why_dev": "अ-कारात् परे इक् वर्णे एकादेश-रूपेण गुणः।", "status": "APPLIED", "why_now_dev": "अ/आ-कारात् परे इक्-वर्णे (इ/उ/ऋ/ऌ) सति उभयोः स्थाने एकः गुण-वर्णः आदिश्यते; यथा अ+इ → ए, अ+उ → ओ (एकादेश-गुण-सन्धिः)। (६.१.८७)", "chronological_transition": {"from_sutra": "1.1.50", "to_sutra": "6.1.87"}}, {"sutra_id": "1.2.45", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sUryodaya", "form_after": "sUryodaya", "why_dev": "धातु-प्रत्यय-प्रत्ययान्त-वर्जितम् अर्थवच्छब्दरूपं प्रातिपदिकसंज्ञकम्।", "status": "APPLIED", "why_now_dev": "अर्थवत्-शब्दरूपं धातु-प्रत्यय-प्रत्ययान्त-वर्जितम् इति प्रातिपदिक-संज्ञां लभते (अव्युत्पन्न-प्रातिपदिकम्)। (१.२.४५)", "chronological_transition": {"from_sutra": "6.1.87", "to_sutra": "1.2.45"}}, {"sutra_id": "1.2.46", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sUryodaya", "form_after": "sUryodaya", "why_dev": "कृत्-तद्धित-समासान्ताः शब्दाः प्रातिपदिक-संज्ञकाः।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.2.45", "to_sutra": "1.2.46"}}, {"sutra_id": "1.4.14", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sUryodaya", "form_after": "sUryodaya", "why_dev": "सुप्-अन्तः तिङ्-अन्तः वा शब्दः पद-संज्ञकः (अष्टाध्यायी)।", "status": "APPLIED", "why_now_dev": "सुप्-अन्तः तिङ्-अन्तः वा शब्दः पद-संज्ञकः; अनेन पद-कार्याणि (त्रिपादी-सन्धि-आदि) प्रसजन्ति। (१.४.१४)", "chronological_transition": {"from_sutra": "1.2.46", "to_sutra": "1.4.14"}}, {"sutra_id": "4.1.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "sUryodaya", "form_after": "sUryodaya", "why_dev": "प्रातिपदिकाधिकारः — ४.१.१ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.4.14", "to_sutra": "4.1.1"}}, {"sutra_id": "1.1.2", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sUryodaya", "form_after": "sUryodaya", "why_dev": "अ, ए, ओ इति गुण-संज्ञाः भवन्ति।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "4.1.1", "to_sutra": "1.1.2"}}, {"sutra_id": "6.4.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "sUryodaya", "form_after": "sUryodaya", "why_dev": "६.४.१ तः ७.४.९७ पर्यन्तानि सूत्राणि अङ्गस्य विधयः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.2", "to_sutra": "6.4.1"}}, {"sutra_id": "4.1.2", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "sUryodaya", "form_after": "sUryodayasu", "why_dev": "एकविंशति सुप्-प्रत्ययाः क्रमेण प्रातिपदिकात् विधीयन्ते; अधिकारः ४.१.२ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "6.4.1", "to_sutra": "4.1.2"}}, {"sutra_id": "1.3.2", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sUryodayasu", "form_after": "sUryodayasu", "why_dev": "उपदेशावस्थायाम् अज् वर्णः अनुनासिकः चेद् इत्-संज्ञकः; इँर्-वार्तिके पुनः द्वयोः संयुक्तः इत्। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "4.1.2", "to_sutra": "1.3.2"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sUryodayasu", "form_after": "sUryodayasu", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.2", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.4", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sUryodayasu", "form_after": "sUryodayasu", "why_dev": "विभक्ति-प्रत्यये अन्त्यौ तु-स्म-वर्णौ हलन्त्य-इत् संज्ञां न लभेते; विधिः १.३.३ एव न प्रवर्तते (तुस्मान्त-निषेधः)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.4"}}, {"sutra_id": "1.3.5", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sUryodayasu", "form_after": "sUryodayasu", "why_dev": "ञ्-इट्-डु-वर्णेषु प्रथमः हल् ‘इत्’ संज्ञकः; लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.4", "to_sutra": "1.3.5"}}, {"sutra_id": "1.3.6", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sUryodayasu", "form_after": "sUryodayasu", "why_dev": "प्रत्ययस्य आदौ ष्-वर्णः ‘इत्’ संज्ञकः; लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.5", "to_sutra": "1.3.6"}}, {"sutra_id": "1.3.7", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sUryodayasu", "form_after": "sUryodayasu", "why_dev": "चवर्ग-टवर्गीयः प्रथमः हल् ‘इत्’ संज्ञकः; लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.6", "to_sutra": "1.3.7"}}, {"sutra_id": "1.3.8", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "sUryodayasu", "form_after": "sUryodayasu", "why_dev": "अतद्धिते प्रत्ययादौ ल्-श्-कु-वर्णानाम् इत्-संज्ञा; लोपः १.३.९। सुप्-पङ्क्तिषु ङ्-आदिर् अपि (*N* ∈ *ku*)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.7", "to_sutra": "1.3.8"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sUryodayasu", "form_after": "sUryodayas", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.8", "to_sutra": "1.3.9"}}, {"sutra_id": "1.3.10", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "sUryodayas", "form_after": "sUryodayas", "why_dev": "द्वयोः समसङ्ख्यक-गणयोः मध्ये अनुदेशः यदा, तदा सः सदस्येषु क्रमेण — यथा ६.१.७८ (ए→अय्, ऐ→आय्), ३.१.१३४ (ल्यु्-णिनि-अच्), १.१.४६ (टित्-कित्)। असमसङ्ख्ये (८.२.३९) न; अन्तरतमम् १.१.५० आदि।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "1.3.10"}}, {"sutra_id": "7.3.102", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sUryodayas", "form_after": "sUryodayas", "why_dev": "यञादि-सुप्-प्रत्यये परे अदन्त-अङ्गस्य अन्त्य-अ-कारस्य दीर्घः आ-कारः भवति।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.10", "to_sutra": "7.3.102"}}, {"sutra_id": "__MERGE__", "sutra_type": "STRUCTURAL", "type_label": "पद-मेलनम्", "form_before": "sUryodayas", "form_after": "sUryodayas", "why_dev": "पद-रचना — सर्व-धातु/सुबन्त/कृदन्त-संयोजनम् (संरचनात्मकं, न सूत्रम्)।", "status": "APPLIED", "event": "MERGE"}, {"sutra_id": "8.2.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "sUryodayas", "form_after": "sUryodayas", "why_dev": "८.२.१ तः ८.४.६८ पर्यन्तम् (त्रिपादी) पूर्व-सूत्रेभ्यः असिद्धम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "7.3.102", "to_sutra": "8.2.1"}}, {"sutra_id": "8.2.23", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sUryodayas", "form_after": "sUryodayas", "why_dev": "संयोगान्त-पदस्य अन्त्य-हल्-लोपः (चितवान्)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.1", "to_sutra": "8.2.23"}}, {"sutra_id": "8.2.39", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sUryodayas", "form_after": "sUryodayas", "why_dev": "पदान्ते झल्-व्यञ्जनस्य स्थाने जश्-व्यञ्जनः (सूत्रम् ८.२.३९ झलां जशोऽन्ते) — त् → द्।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.23", "to_sutra": "8.2.39"}}, {"sutra_id": "8.2.66", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sUryodayas", "form_after": "sUryodayar", "why_dev": "पदान्त-सकारस्य सजुषः च रु-आदेशः (त्रिपादी)।", "status": "APPLIED", "why_now_dev": "पदान्त-सकारस्य 'रु'-आदेशः (त्रिपादी); अयं रु पुनः ८.३.१५ इति खर्/अवसाने विसर्गः, अन्यत्र (घोष-हलि) रेफः अवशिष्यते। (८.२.६६)", "chronological_transition": {"from_sutra": "8.2.39", "to_sutra": "8.2.66"}}, {"sutra_id": "8.3.15", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sUryodayar", "form_after": "sUryodayaH", "why_dev": "खर्-वर्णे परे अवसाने च रु-आदेशस्य विसर्गः।", "status": "APPLIED", "why_now_dev": "खर्-वर्णे परे अवसाने च 'रु' (८.२.६६) इत्यस्य विसर्गः (ः); एवं रामः, धनुः इति विसर्गान्त-रूपं सिध्यति। (८.३.१५)", "chronological_transition": {"from_sutra": "8.2.66", "to_sutra": "8.3.15"}}, {"sutra_id": "8.3.24", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sUryodayaH", "form_after": "sUryodayaH", "why_dev": "अपदान्त-नकारस्य झलि परे अनुस्वारः (डेमो: मुञ्चति)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.15", "to_sutra": "8.3.24"}}, {"sutra_id": "8.3.59", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sUryodayaH", "form_after": "sUryodayaH", "why_dev": "इन्-कुक्-पूर्वे स-कारस्य (प्रत्ययस्थस्य) 'ष'-आदेशः (त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.24", "to_sutra": "8.3.59"}}, {"sutra_id": "8.3.60", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sUryodayaH", "form_after": "sUryodayaH", "why_dev": "वसादौ (सम्प्रसारणोत्तरं) सस्य षत्वं (उषित्वा)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.59", "to_sutra": "8.3.60"}}, {"sutra_id": "8.4.41", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sUryodayaH", "form_after": "sUryodayaH", "why_dev": "ष्-समीपे तकारस्य टकारादेशः; प०३१ न्→ण्; प०३६ ``Na``→``a``; P001-B पूर्व-त्रिपादी ``z``+``t``।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.60", "to_sutra": "8.4.41"}}, {"sutra_id": "8.4.54", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sUryodayaH", "form_after": "sUryodayaH", "why_dev": "अभ्यास-स्थिते झश्-वर्णस्य जश्-आदेशः (भि→बि) — विभिदतुः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.41", "to_sutra": "8.4.54"}}, {"sutra_id": "8.4.55", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sUryodayaH", "form_after": "sUryodayaH", "why_dev": "खरि परे झल्-कार्यम् (द्→त्); प०३१—प०३४ ग्लास्-बॉक्स् पूरणम्।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.54", "to_sutra": "8.4.55"}}, {"sutra_id": "8.4.56", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sUryodayaH", "form_after": "sUryodayaH", "why_dev": "(सूत्रम् 8.4.56) वाऽवसाने।", "status": "APPLIED", "chronological_transition": {"from_sutra": "8.4.55", "to_sutra": "8.4.56"}}, {"sutra_id": "8.4.58", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "sUryodayaH", "form_after": "sUryodayaH", "why_dev": "ययि परे अनुस्वारस्य परसवर्णः (डेमो: मुञ्चति)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.56", "to_sutra": "8.4.58"}}, {"sutra_id": "8.4.68", "sutra_type": "ANUVADA", "type_label": "अनुवाद", "form_before": "sUryodayaH", "form_after": "sUryodayaH", "why_dev": "(सूत्रम् 8.4.68) अ अ इति।", "status": "AUDIT", "chronological_transition": {"from_sutra": "8.4.58", "to_sutra": "8.4.68"}}]}