a_type": "VIDHI", "type_label": "विधि", "form_before": "devaindra", "form_after": "devaindra", "why_dev": "क्‍ङ्-परिच्छिन्ने प्रत्यय-क्षेपे, तस्मिन् आङ्ग-कार्ये, यः १.१.३-उत्सर्ग-इक-नियमः, सो न।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.4", "to_sutra": "1.1.5"}}, {"sutra_id": "1.1.6", "sutra_type": "PRATISHEDHA", "type_label": "प्रतिषेध", "form_before": "devaindra", "form_after": "devaindra", "why_dev": "इडागम-इकारस्य गुणनिषेधः (परिभाषा-गेट)।", "status": "VACUOUS", "chronological_transition": {"from_sutra": "1.1.5", "to_sutra": "1.1.6"}}, {"sutra_id": "1.1.50", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "devaindra", "form_after": "devaindra", "why_dev": "आदेश-चयनस्य परिभाषा — स्थाने (उच्चारण-स्थान-प्रयत्नादि-साम्ये) अन्तरतमः विकल्प्यते।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.6", "to_sutra": "1.1.50"}}, {"sutra_id": "6.1.87", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "devaindra", "form_after": "devendra", "why_dev": "अ-कारात् परे इक् वर्णे एकादेश-रूपेण गुणः।", "status": "APPLIED", "why_now_dev": "अ/आ-कारात् परे इक्-वर्णे (इ/उ/ऋ/ऌ) सति उभयोः स्थाने एकः गुण-वर्णः आदिश्यते; यथा अ+इ → ए, अ+उ → ओ (एकादेश-गुण-सन्धिः)। (६.१.८७)", "parts": [["deve", "prakriti", "deva"], ["", "sup", "Am"], ["ndra", "prakriti", "indra"], ["", "sup", "su"]], "chronological_transition": {"from_sutra": "1.1.50", "to_sutra": "6.1.87"}}, {"sutra_id": "1.2.45", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "devendra", "form_after": "devendra", "why_dev": "धातु-प्रत्यय-प्रत्ययान्त-वर्जितम् अर्थवच्छब्दरूपं प्रातिपदिकसंज्ञकम्।", "status": "APPLIED", "why_now_dev": "अर्थवत्-शब्दरूपं धातु-प्रत्यय-प्रत्ययान्त-वर्जितम् इति प्रातिपदिक-संज्ञां लभते (अव्युत्पन्न-प्रातिपदिकम्)। (१.२.४५)", "parts": [["deve", "prakriti", "deva"], ["", "sup", "Am"], ["ndra", "prakriti", "indra"], ["", "sup", "su"]], "chronological_transition": {"from_sutra": "6.1.87", "to_sutra": "1.2.45"}}, {"sutra_id": "1.2.46", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "devendra", "form_after": "devendra", "why_dev": "कृत्-तद्धित-समासान्ताः शब्दाः प्रातिपदिक-संज्ञकाः।", "status": "APPLIED", "parts": [["devendra", "prakriti", "devendra"]], "chronological_transition": {"from_sutra": "1.2.45", "to_sutra": "1.2.46"}}, {"sutra_id": "1.4.14", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "devendra", "form_after": "devendra", "why_dev": "सुप्-अन्तः तिङ्-अन्तः वा शब्दः पद-संज्ञकः (अष्टाध्यायी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.2.46", "to_sutra": "1.4.14"}}, {"sutra_id": "4.1.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "devendra", "form_after": "devendra", "why_dev": "प्रातिपदिकाधिकारः — ४.१.१ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.4.14", "to_sutra": "4.1.1"}}, {"sutra_id": "1.1.2", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "devendra", "form_after": "devendra", "why_dev": "अ, ए, ओ इति गुण-संज्ञाः भवन्ति।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "4.1.1", "to_sutra": "1.1.2"}}, {"sutra_id": "6.4.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "devendra", "form_after": "devendra", "why_dev": "६.४.१ तः ७.४.९७ पर्यन्तानि सूत्राणि अङ्गस्य विधयः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.2", "to_sutra": "6.4.1"}}, {"sutra_id": "4.1.2", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "devendra", "form_after": "devendrasu~", "why_dev": "एकविंशति सुप्-प्रत्ययाः क्रमेण प्रातिपदिकात् विधीयन्ते; अधिकारः ४.१.२ तः ५.४.१६० पर्यन्तम्।", "status": "APPLIED", "parts": [["devendra", "prakriti", "devendra"], ["su~", "sup", "s~"]], "chronological_transition": {"from_sutra": "6.4.1", "to_sutra": "4.1.2"}}, {"sutra_id": "1.3.2", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "devendrasu~", "form_after": "devendrasu~", "why_dev": "उपदेशावस्थायाम् अज् वर्णः अनुनासिकः चेद् इत्-संज्ञकः; इँर्-वार्तिके पुनः द्वयोः संयुक्तः इत्। लोपः १.३.९।", "status": "APPLIED", "parts": [["devendra", "prakriti", "devendra"], ["su~", "sup", "s~"]], "chronological_transition": {"from_sutra": "4.1.2", "to_sutra": "1.3.2"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "devendrasu~", "form_after": "devendrasu~", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.2", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.4", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "devendrasu~", "form_after": "devendrasu~", "why_dev": "विभक्ति-प्रत्यये अन्त्यौ तु-स्म-वर्णौ हलन्त्य-इत् संज्ञां न लभेते; विधिः १.३.३ एव न प्रवर्तते (तुस्मान्त-निषेधः)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.4"}}, {"sutra_id": "1.3.5", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "devendrasu~", "form_after": "devendrasu~", "why_dev": "धातोः आदौ ञि-टु-डु इति समुदायः ‘इत्’ संज्ञकः; लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.4", "to_sutra": "1.3.5"}}, {"sutra_id": "1.3.6", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "devendrasu~", "form_after": "devendrasu~", "why_dev": "प्रत्ययस्य आदौ ष्-वर्णः ‘इत्’ संज्ञकः; लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.5", "to_sutra": "1.3.6"}}, {"sutra_id": "1.3.7", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "devendrasu~", "form_after": "devendrasu~", "why_dev": "प्रत्ययस्य आदौ चवर्ग-टवर्गीयः वर्णः ‘इत्’ संज्ञकः; लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.6", "to_sutra": "1.3.7"}}, {"sutra_id": "1.3.8", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "devendrasu~", "form_after": "devendrasu~", "why_dev": "अतद्धिते प्रत्ययादौ ल्-श्-कु-वर्णानाम् इत्-संज्ञा; लोपः १.३.९। सुप्-पङ्क्तिषु ङ्-आदिर् अपि (*N* ∈ *ku*)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.7", "to_sutra": "1.3.8"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "devendrasu~", "form_after": "devendras", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः (तस्य लोपः): सुँ — उँ → उदित् (१.३.२)। (१.३.९)", "parts": [["devendra", "prakriti", "devendra"], ["s", "sup", "s~"]], "chronological_transition": {"from_sutra": "1.3.8", "to_sutra": "1.3.9"}}, {"sutra_id": "1.3.10", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "devendras", "form_after": "devendras", "why_dev": "द्वयोः समसङ्ख्यक-गणयोः मध्ये अनुदेशः यदा, तदा सः सदस्येषु क्रमेण — यथा ६.१.७८ (ए→अय्, ऐ→आय्), ३.१.१३४ (ल्यु्-णिनि-अच्), १.१.४६ (टित्-कित्)। असमसङ्ख्ये (८.२.३९) न; अन्तरतमम् १.१.५० आदि।", "status": "VACUOUS", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "1.3.10"}}, {"sutra_id": "7.3.102", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "devendras", "form_after": "devendras", "why_dev": "यञादि-सुप्-प्रत्यये परे अदन्त-अङ्गस्य अन्त्य-अ-कारस्य दीर्घः आ-कारः भवति।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.10", "to_sutra": "7.3.102"}}, {"sutra_id": "__MERGE__", "sutra_type": "STRUCTURAL", "type_label": "पद-मेलनम्", "form_before": "devendras", "form_after": "devendras", "why_dev": "पद-रचना — सर्व-धातु/सुबन्त/कृदन्त-संयोजनम् (संरचनात्मकं, न सूत्रम्)।", "status": "APPLIED", "event": "MERGE"}, {"sutra_id": "8.2.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "devendras", "form_after": "devendras", "why_dev": "८.२.१ तः ८.४.६८ पर्यन्तम् (त्रिपादी) पूर्व-सूत्रेभ्यः असिद्धम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "7.3.102", "to_sutra": "8.2.1"}}, {"sutra_id": "8.2.23", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "devendras", "form_after": "devendras", "why_dev": "संयोगान्त-पदस्य अन्त्य-हल्-लोपः (चितवान्)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.1", "to_sutra": "8.2.23"}}, {"sutra_id": "8.2.25", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "devendras", "form_after": "devendras", "why_dev": "(सूत्रम् 8.2.25) धि च।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.23", "to_sutra": "8.2.25"}}, {"sutra_id": "8.2.27", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "devendras", "form_after": "devendras", "why_dev": "ह्रस्वान्ताद् अङ्गात् परस्य सिचः सस्य लोपो झलि — अकृत।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.25", "to_sutra": "8.2.27"}}, {"sutra_id": "8.2.28", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "devendras", "form_after": "devendras", "why_dev": "इट्-आगमे सति सिच्-स्थ-सकारस्य लोपः (लुङ्-प्रक्रिया, अलावीत्)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.27", "to_sutra": "8.2.28"}}, {"sutra_id": "8.2.26", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "devendras", "form_after": "devendras", "why_dev": "झलो झलि परे लोपः — प०३३ (घ्स्-त-)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.28", "to_sutra": "8.2.26"}}, {"sutra_id": "8.2.36", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "devendras", "form_after": "devendras", "why_dev": "व्रश्चभ्रस्ज…च्छशां षः: a dhātu-final श्/छ् (and सृज्, मृज्, यज्, राज्, भ्राज्) → ष् before a jhal or at the pada end (apavāda of 8.2.30) — दंश्+स्य, सृज्+त → सृष्ट.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.26", "to_sutra": "8.2.36"}}, {"sutra_id": "8.2.30", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "devendras", "form_after": "devendras", "why_dev": "झलि/पदान्ते परे च-वर्णस्य क-वर्णादेशः (उक्त-उपपत्ति)। प००३-ए: त्रिपादी-प्रवेशात् पूर्वम् अनुमतम्।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.36", "to_sutra": "8.2.30"}}, {"sutra_id": "8.2.32", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "devendras", "form_after": "devendras", "why_dev": "दादेर्धातोर्घः: the ह् of a द्-initial dhātu → घ् (apavāda of 8.2.31) — दुह् → दुघ्, दह् → दघ्.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.30", "to_sutra": "8.2.32"}}, {"sutra_id": "8.2.34", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "devendras", "form_after": "devendras", "why_dev": "नहो धः: the ह् of नह् → ध् (apavāda of 8.2.31) — नह्+त → नद्ध.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.32", "to_sutra": "8.2.34"}}, {"sutra_id": "8.2.31", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "devendras", "form_after": "devendras", "why_dev": "हो ढः: ह् → ढ् before a jhal or at the pada end — लिह्+स्य → लिढ्+स्य.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.34", "to_sutra": "8.2.31"}}, {"sutra_id": "8.2.37", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "devendras", "form_after": "devendras", "why_dev": "एकाचो बशो भष् झषन्तस्य स्ध्वोः: a one-vowel dhātu beginning with बश् and ending in झष् aspirates its initial before स्/ध्व् or at the end — दुघ्+स्य → धुघ्+स्य (धोक्ष्यति).", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.31", "to_sutra": "8.2.37"}}, {"sutra_id": "8.2.39", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "devendras", "form_after": "devendras", "why_dev": "पदान्ते झल्-व्यञ्जनस्य स्थाने जश्-व्यञ्जनः (सूत्रम् ८.२.३९ झलां जशोऽन्ते) — त् → द्।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.37", "to_sutra": "8.2.39"}}, {"sutra_id": "8.2.40", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "devendras", "form_after": "devendras", "why_dev": "झष्-पूर्वे त्/थ् का ध्-आदेशः (डेमो: रुणद्धि; प००१-डि पूर्व-त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.39", "to_sutra": "8.2.40"}}, {"sutra_id": "8.2.41", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "devendras", "form_after": "devendras", "why_dev": "षढोः कः सि: ष्/ढ् before स् → क् — लेढ्+स्य → लेक्+स्य.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.40", "to_sutra": "8.2.41"}}, {"sutra_id": "8.2.66", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "devendras", "form_after": "devendrar", "why_dev": "पदान्त-सकारस्य सजुषः च रु-आदेशः (त्रिपादी)।", "status": "APPLIED", "why_now_dev": "पदान्त-सकारस्य 'रु'-आदेशः (त्रिपादी); अयं रु पुनः ८.३.१५ इति खर्/अवसाने विसर्गः, अन्यत्र (घोष-हलि) रेफः अवशिष्यते। (८.२.६६)", "parts": [["devendrar", "pada", ""]], "chronological_transition": {"from_sutra": "8.2.41", "to_sutra": "8.2.66"}}, {"sutra_id": "8.2.77", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "devendrar", "form_after": "devendrar", "why_dev": "धातोः र्वोः पूर्वस्य इकः दीर्घः हलि परे (दीव्यति)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.66", "to_sutra": "8.2.77"}}, {"sutra_id": "8.2.78", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "devendrar", "form_after": "devendrar", "why_dev": "धातोः उपधाभूतयोः र्वोः पूर्वस्य इकः दीर्घः (मूर्वति)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.77", "to_sutra": "8.2.78"}}, {"sutra_id": "8.3.15", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "devendrar", "form_after": "devendraH", "why_dev": "खर्-वर्णे परे अवसाने च रु-आदेशस्य विसर्गः।", "status": "APPLIED", "why_now_dev": "खर्-वर्णे परे अवसाने च 'रु' (८.२.६६) इत्यस्य विसर्गः (ः); एवं रामः, धनुः इति विसर्गान्त-रूपं सिध्यति। (८.३.१५)", "parts": [["devendraH", "pada", ""]], "chronological_transition": {"from_sutra": "8.2.78", "to_sutra": "8.3.15"}}, {"sutra_id": "8.3.24", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "devendraH", "form_after": "deveMdraH", "why_dev": "अपदान्तस्य नकारस्य मकारस्य च झलि परे अनुस्वारः (यशांसि, आक्रंस्यते)।", "status": "APPLIED", "parts": [["deveMdraH", "pada", ""]], "chronological_transition": {"from_sutra": "8.3.15", "to_sutra": "8.3.24"}}, {"sutra_id": "8.3.59", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "deveMdraH", "form_after": "deveMdraH", "why_dev": "इन्-कुक्-पूर्वे स-कारस्य (प्रत्ययस्थस्य) 'ष'-आदेशः (त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.24", "to_sutra": "8.3.59"}}, {"sutra_id": "8.3.60", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "deveMdraH", "form_after": "deveMdraH", "why_dev": "वसादौ (सम्प्रसारणोत्तरं) सस्य षत्वं (उषित्वा)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.59", "to_sutra": "8.3.60"}}, {"sutra_id": "8.4.1", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "deveMdraH", "form_after": "deveMdraH", "why_dev": "समानपदे रेफ-ष-वर्णाभ्यां (ऋवर्णाद् अपि) ऋणे परस्य न-कारस्य सन्निहिते णादेशः (१०८ संहितायाम्, त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.60", "to_sutra": "8.4.1"}}, {"sutra_id": "8.4.2", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "deveMdraH", "form_after": "deveMdraH", "why_dev": "र-ष-वर्णात् परस्य न-कारस्य णत्वम् — अट्-कु-पु-आङ्-नुम् व्यवधाने अपि (त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.1", "to_sutra": "8.4.2"}}, {"sutra_id": "8.4.40", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "deveMdraH", "form_after": "deveMdraH", "why_dev": "चवर्गे परे स्तोः श्चुनेन श्चुः (डेमो: दधि+छत्रम्); ष्टुणा-शाखा पुरातन-मार्ज्वि-मार्गे।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.2", "to_sutra": "8.4.40"}}, {"sutra_id": "8.4.41", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "deveMdraH", "form_after": "deveMdraH", "why_dev": "ष्-समीपे तकारस्य टकारादेशः; प०३१ न्→ण्; P001-B पूर्व-त्रिपादी ``z``+``t``।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.40", "to_sutra": "8.4.41"}}, {"sutra_id": "8.3.13", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "deveMdraH", "form_after": "deveMdraH", "why_dev": "ढकारे परे ढकारस्य लोपः — लेढ्+ढा → लेढा।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.41", "to_sutra": "8.3.13"}}, {"sutra_id": "6.3.112", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "deveMdraH", "form_after": "deveMdraH", "why_dev": "ढ्-लोपे सह्-वह्-धात्वोः अवर्णस्य ओकारः — सढ्+ढा → सोढा।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.13", "to_sutra": "6.3.112"}}, {"sutra_id": "6.3.111", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "deveMdraH", "form_after": "deveMdraH", "why_dev": "ढ्-लोपे सति पूर्वस्य अणः दीर्घः — लिढ्+ढ → लीढ।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.3.112", "to_sutra": "6.3.111"}}, {"sutra_id": "8.4.53", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "deveMdraH", "form_after": "deveMdraH", "why_dev": "झशि परे झल्-वर्णस्य जश्-आदेशः (डेमो: ध् → द्; प००१-डि पूर्व-त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.3.111", "to_sutra": "8.4.53"}}, {"sutra_id": "8.4.54", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "deveMdraH", "form_after": "deveMdraH", "why_dev": "अभ्यास-स्थिते झश्-वर्णस्य जश्-आदेशः (भि→बि) — विभिदतुः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.53", "to_sutra": "8.4.54"}}, {"sutra_id": "8.4.55", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "deveMdraH", "form_after": "deveMdraH", "why_dev": "खरि परे झल्-कार्यम् (द्→त्); प०३१—प०३४ ग्लास्-बॉक्स् पूरणम्।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.54", "to_sutra": "8.4.55"}}, {"sutra_id": "8.4.56", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "deveMdraH", "form_after": "deveMdraH", "why_dev": "(सूत्रम् 8.4.56) वाऽवसाने।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.55", "to_sutra": "8.4.56"}}, {"sutra_id": "8.4.58", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "deveMdraH", "form_after": "devendraH", "why_dev": "ययि परे अनुस्वारस्य परसवर्णः (डेमो: मुञ्चति)।", "status": "APPLIED", "parts": [["devendraH", "pada", ""]], "chronological_transition": {"from_sutra": "8.4.56", "to_sutra": "8.4.58"}}, {"sutra_id": "8.4.68", "sutra_type": "ANUVADA", "type_label": "अनुवाद", "form_before": "devendraH", "form_after": "devendraH", "why_dev": "(सूत्रम् 8.4.68) अ अ इति।", "status": "VACUOUS", "chronological_transition": {"from_sutra": "8.4.58", "to_sutra": "8.4.68"}}]}