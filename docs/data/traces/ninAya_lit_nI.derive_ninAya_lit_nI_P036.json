{"module": "pipelines.ninAya_lit_nI", "callable": "derive_ninAya_lit_nI_P036", "ok": true, "smoke_note": null, "invocation": {"args": [], "kwargs": {}}, "result_kind": "state", "final_flat_slp1": "ninAya", "phase": "angakarya", "tripadi_zone": false, "trace_len": 25, "trace": [{"sutra_id": "1.3.1", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "nI", "form_after": "nI", "why_dev": "भू आदि गणे पठितानां धातूनां धातु-संज्ञा (उपदेश एव अधिकृतः)।", "status": "APPLIED", "chronological_transition": {"from_sutra": null, "to_sutra": "1.3.1"}}, {"sutra_id": "1.3.2", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "nI", "form_after": "nI", "why_dev": "उपदेशावस्थायाम् अज् वर्णः अनुनासिकः चेद् इत्-संज्ञकः; इँर्-वार्तिके पुनः द्वयोः संयुक्तः इत्। लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.1", "to_sutra": "1.3.2"}}, {"sutra_id": "1.3.5", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "nI", "form_after": "nI", "why_dev": "ञ्-इट्-डु-वर्णेषु प्रथमः हल् ‘इत्’ संज्ञकः; लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.2", "to_sutra": "1.3.5"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "nI", "form_after": "nI", "why_dev": "इत्-संज्ञक-वर्णाः न सन्ति, अतः लोपः शून्यः; तथापि नियम-परीक्षा अनिवार्या (१.३.९)।", "status": "APPLIED_VACUOUS", "lopa_count": 0, "chronological_transition": {"from_sutra": "1.3.5", "to_sutra": "1.3.9"}}, {"sutra_id": "3.2.115", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "nI", "form_after": "nIli", "why_dev": "परोक्ष-भूते लिट्-लकार-प्रत्ययः विधीयते (विभिदतुः)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "3.2.115"}}, {"sutra_id": "3.1.91", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "nIli", "form_after": "nIli", "why_dev": "धातोः कृत्-तिङ्-प्रत्ययाः — अधिकारः ३.१.९१ तः ३.४.११