{"module": "pipelines.taddhita_itika_etikAyana", "callable": "derive_taddhita_itika_EtikAyana", "ok": true, "smoke_note": null, "invocation": {"args": [], "kwargs": {}}, "result_kind": "state", "final_flat_slp1": "EtikAyana", "phase": "angakarya", "tripadi_zone": false, "trace_len": 30, "trace": [{"sutra_id": "2.1.1", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "itika", "form_after": "itika", "why_dev": "पदविधि-प्रसङ्गे सामर्थ्य-अपेक्षा — इह यन्त्रे अर्थ-अन्धत्वात् केवलं परिभाषा-गेट-रूपेण निबद्धम् (ग्लास-बॉक्स्-आडिट्)।", "status": "AUDIT", "chronological_transition": {"from_sutra": null, "to_sutra": "2.1.1"}}, {"sutra_id": "2.3.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "itika", "form_after": "itika", "why_dev": "२.३.१ इत्यतः २.३.७३ पर्यन्तं 'अनभिहित' अधिकारः प्रवर्तते।", "status": "AUDIT", "chronological_transition": {"from_sutra": "2.1.1", "to_sutra": "2.3.1"}}, {"sutra_id": "2.3.50", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "itika", "form_after": "itika", "why_dev": "कर्मादिभ्योऽन्यः (स्वस्वामिसंबन्धादिः) शेषः; तत्र षष्ठी विभक्तिः। इह प्रक्रियायां '६-१' इति विभक्ति-निर्णयः (सुप्-आदेशः ४.१.२)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "2.3.1", "to_sutra": "2.3.50"}}, {"sutra_id": "4.1.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "itika", "form_after": "itika", "why_dev": "प्रातिपदिकाधिकारः — ४.१.१ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "2.3.50", "to_sutra": "4.1.1"}}, {"sutra_id": "1.2.45", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "itika", "form_after": "itika", "why_dev": "धातु-प्रत्यय-प्रत्ययान्त-वर्जितम् अर्थवच्छब्दरूपं प्रातिपदिकसंज्ञकम्।", "status": "APPLIED", "why_now_dev": "अर्थवत्-शब्दरूपं धातु-प्रत्यय-प्रत्ययान्त-वर्जितम् इति प्रातिपदिक-संज्ञां लभते (अव्युत्पन्न-प्रातिपदिकम्)। (१.२.४५)", "chronological_transition": {"from_sutra": "4.1.1", "to_sutra": "1.2.45"}}, {"sutra_id": "4.1.2", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "itika", "form_after": "itikaNas", "why_dev": "एकविंशति सुप्-प्रत्ययाः क्रमेण प्रातिपदिकात् विधीयन्ते; अधिकारः ४.१.२ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.2.45", "to_sutra": "4.1.2"}}, {"sutra_id": "4.1.82", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "itikaNas", "form_after": "itikaNas", "why_dev": "अर्थज्ञापकसूत्रे समर्थेषु यः प्रथमः पदार्थः, तेन निर्दिष्टात् पदात् परः तद्धितः विकल्पेन (महाभाष्य-सामर्थ्यम्, कृतसंधिकार्यपरम्) — ४.१.८२ तः ५.२.१४० पर्यन्तं समर्थाधिकारः; ४.१.८१ तः अन्यतरस्याम् अनुवृत्तिः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "4.1.2", "to_sutra": "4.1.82"}}, {"sutra_id": "4.1.92", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "itikaNas", "form_after": "itikaNas", "why_dev": "प्राग्दीव्यतीयः शेषाधिकारः — ४.१.९२ तः ४.३.१२० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "4.1.82", "to_sutra": "4.1.92"}}, {"sutra_id": "4.1.99", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "itikaNas", "form_after": "itikaNasPak", "why_dev": "नडादि-गण-आधारेण (अपत्याधिकारः ४.१.९२) *फक्* तद्धित-प्रत्यय-विधानम्।", "status": "APPLIED", "chronological_transition": {"from_sutra": "4.1.92", "to_sutra": "4.1.99"}}, {"sutra_id": "1.1.1", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "itikaNasPak", "form_after": "itikaNasPak", "why_dev": "आ-ऐ-औ इति वृद्धि-संज्ञा (अधिकार-बद्धा न, सर्वत्र उपलब्धा)। अनया केवल वर्ण-समूहस्य निर्देशः — पदेषु स्वतः परिवर्तनं न। वृद्धि-प्रयोगः तु यदा विधि-सूत्रेषु (यथा ६.१.८८) प्रसङ्गः, तदा। अष्टाध्याय्यां 'वृद्धि' इयं संज्ञा नवसु सूत्रेषु साक्षात्, अन्यत्र अनुवृत्त्या च।", "status": "APPLIED", "why_now_dev": "आ, ऐ, औ — एते वर्णाः 'वृद्धि'-संज्ञां प्राप्नुवन्ति; इयं संज्ञा वृद्धि-विधिषु (यथा ६.१.८८ वृद्धिरेचि, ७.२.१ सिचि वृद्धिः) उपयुज्यते। (१.१.१)", "chronological_transition": {"from_sutra": "4.1.99", "to_sutra": "1.1.1"}}, {"sutra_id": "1.1.50", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "itikaNasPak", "form_after": "itikaNasPak", "why_dev": "आदेश-चयनस्य परिभाषा — स्थाने (उच्चारण-स्थान-प्रयत्नादि-साम्ये) अन्तरतमः विकल्प्यते।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.1", "to_sutra": "1.1.50"}}, {"sutra_id": "3.1.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "itikaNasPak", "form_after": "itikaNasPak", "why_dev": "अधिकारः प्रत्यय-विधानम् — ३.१.१ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.50", "to_sutra": "3.1.1"}}, {"sutra_id": "3.1.2", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "itikaNasPak", "form_after": "itikaNasPak", "why_dev": "प्रत्ययः निमित्तात् परः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.1", "to_sutra": "3.1.2"}}, {"sutra_id": "3.1.3", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "itikaNasPak", "form_after": "itikaNasPak", "why_dev": "प्रत्ययस्य आद्युदात्तत्वम् — अधिकारः ३.१.३ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.2", "to_sutra": "3.1.3"}}, {"sutra_id": "4.1.76", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "itikaNasPak", "form_after": "itikaNasPak", "why_dev": "तद्धिताधिकारः — ४.१.७६ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.3", "to_sutra": "4.1.76"}}, {"sutra_id": "1.2.46", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "itikaNasPak", "form_after": "itikaNasPak", "why_dev": "कृत्-तद्धित-समासान्ताः शब्दाः प्रातिपदिक-संज्ञकाः।", "status": "APPLIED", "chronological_transition": {"from_sutra": "4.1.76", "to_sutra": "1.2.46"}}, {"sutra_id": "2.4.71", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "itikaNasPak", "form_after": "itikaPak", "why_dev": "धातु/प्रातिपदिक-अवयवे विद्यमानस्य सुपः लुक् (आर्म्ड-मेटा)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.2.46", "to_sutra": "2.4.71"}}, {"sutra_id": "1.1.62", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "itikaPak", "form_after": "itikaPak", "why_dev": "प्रत्ययस्य लोपे कृते अपि प्रत्ययाश्रितं कार्यम् अवश्यं भवति — यथा नदी+सुँ → नदी (६.१.६८) इत्यत्र पदम् १.४.१४; षष्+जस् → षड् (७.१.२२ लुक्); अदस्+सुँ → असौ (७.२.१०६); अग्निचित् (६.१.७१); अधुक् (७.३.८६, ८.२.३२)। अङ्गकार्ये अपवादः १.१.६३।", "status": "AUDIT", "chronological_transition": {"from_sutra": "2.4.71", "to_sutra": "1.1.62"}}, {"sutra_id": "1.4.13", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "itikaPak", "form_after": "itikaPak", "why_dev": "प्रत्यय-विधेर् यस्मात् तदादि प्रत्यये यत् तद् अङ्गम्।", "status": "APPLIED", "why_now_dev": "प्रत्ययात् पूर्वं स्थितः अवयवः अङ्ग-संज्ञकः (प्रत्यये परतः अङ्गम्); अनेन अङ्ग-अधिकार-कार्याणि (६.४.१ आदि) प्रसजन्ति। (१.४.१३)", "chronological_transition": {"from_sutra": "1.1.62", "to_sutra": "1.4.13"}}, {"sutra_id": "6.4.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "itikaPak", "form_after": "itikaPak", "why_dev": "६.४.१ तः ७.४.९७ पर्यन्तानि सूत्राणि अङ्गस्य विधयः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.4.13", "to_sutra": "6.4.1"}}, {"sutra_id": "7.1.2", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "itikaPak", "form_after": "itikaAyana", "why_dev": "तद्धित-प्रत्ययस्य आदौ फ्-ढ्-ख्-छ्-घ्-क्रमेण आयन्-एय्-ईन्-ईय्-इय्-आदेशाः (१.३.१० यथासङ्ख्यम्)। कृत्-सुप्-तिङ्-प्रत्ययेषु न।", "status": "APPLIED", "chronological_transition": {"from_sutra": "6.4.1", "to_sutra": "7.1.2"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "itikaAyana", "form_after": "itikaAyana", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.2", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.8", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "itikaAyana", "form_after": "itikaAyana", "why_dev": "अतद्धिते प्रत्ययादौ ल्-श्-कु-वर्णानाम् इत्-संज्ञा; लोपः १.३.९। सुप्-पङ्क्तिषु ङ्-आदिर् अपि (*N* ∈ *ku*)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.8"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "itikaAyana", "form_after": "itikaAyana", "why_dev": "इत्-संज्ञक-वर्णाः न सन्ति, अतः लोपः शून्यः; तथापि नियम-परीक्षा अनिवार्या (१.३.९)।", "status": "APPLIED_VACUOUS", "lopa_count": 0, "chronological_transition": {"from_sutra": "1.3.8", "to_sutra": "1.3.9"}}, {"sutra_id": "1.3.10", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "itikaAyana", "form_after": "itikaAyana", "why_dev": "द्वयोः समसङ्ख्यक-गणयोः मध्ये अनुदेशः यदा, तदा सः सदस्येषु क्रमेण — यथा ६.१.७८ (ए→अय्, ऐ→आय्), ३.१.१३४ (ल्यु्-णिनि-अच्), १.१.४६ (टित्-कित्)। असमसङ्ख्ये (८.२.३९) न; अन्तरतमम् १.१.५० आदि।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "1.3.10"}}, {"sutra_id": "7.2.118", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "itikaAyana", "form_after": "EtikaAyana", "why_dev": "तद्धित-कि-तद्धित-परिक्षे *इतिक* आदौ *इ*→*E* (वृद्धि)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.10", "to_sutra": "7.2.118"}}, {"sutra_id": "1.4.18", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "EtikaAyana", "form_after": "EtikaAyana", "why_dev": "स्वादि-प्रत्यये असर्वनामस्थानके यकारादौ वा अजादौ आदौ च परे प्रकृतेः भ-संज्ञा; पद-संज्ञां (१.४.१७) बाधते।", "status": "APPLIED", "why_now_dev": "यकारादौ अजादौ वा असर्वनामस्थान-प्रत्यये परे प्रकृतिः 'भ'-संज्ञां प्राप्नोति; इयं संज्ञा पद-संज्ञां (१.४.१७) बाधते, अतः पदाश्रित-कार्यं न (यथा राजन्+शस्)। (१.४.१८)", "chronological_transition": {"from_sutra": "7.2.118", "to_sutra": "1.4.18"}}, {"sutra_id": "6.4.129", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "EtikaAyana", "form_after": "EtikaAyana", "why_dev": "भाधिकारः — ६.४.१२९ तः ६.४.१७५ पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.4.18", "to_sutra": "6.4.129"}}, {"sutra_id": "6.4.148", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "EtikaAyana", "form_after": "EtikAyana", "why_dev": "भाधिकारे इत्यादौ परे अङ्गान्त्यस्य अ/इ-वर्णस्य लोपः।", "status": "APPLIED", "chronological_transition": {"from_sutra": "6.4.129", "to_sutra": "6.4.148"}}, {"sutra_id": "1.1.60", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "EtikAyana", "form_after": "EtikAyana", "why_dev": "स्थानिनि वर्णः वा वर्णसमूहः वा अदर्शनं यत्, तत् 'लोप' इति संज्ञा — उपयोगः १.३.९, ८.२.२३, ६.१.६८, … इतिषु; अत्र केवल संज्ञा-निर्णयः।", "status": "APPLIED", "why_now_dev": "स्थाने वर्णस्य वर्णसमूहस्य वा अदर्शनं 'लोप'-संज्ञां प्राप्नोति; अनया संज्ञया उत्तर-विधयः (यथा १.३.९ इत्-लोपः) प्रवर्तन्ते। (१.१.६०)", "chronological_transition": {"from_sutra": "6.4.148", "to_sutra": "1.1.60"}}]}