{"module": "pipelines.trApuSam_jAtuSam_taddhita", "callable": "derive_trApuSam", "ok": true, "smoke_note": null, "invocation": {"args": [], "kwargs": {}}, "result_kind": "state", "final_flat_slp1": "trApuzam", "phase": "angakarya", "tripadi_zone": false, "trace_len": 16, "trace": [{"sutra_id": "4.1.2", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "trapu", "form_after": "trapuNas", "why_dev": "एकविंशति सुप्-प्रत्ययाः क्रमेण प्रातिपदिकात् विधीयन्ते; अधिकारः ४.१.२ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": null, "to_sutra": "4.1.2"}}, {"sutra_id": "1.1.46", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "trapuNas", "form_after": "trapuNas", "why_dev": "टित्-आगमः आगमिनः पूर्वम्, कित्-आगमः आगमिनः अनन्तरम् इति स्थाननिर्णयः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "4.1.2", "to_sutra": "1.1.46"}}, {"sutra_id": "4.3.138", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "trapuNas", "form_after": "trapuzukNasaN", "why_dev": "त्रपु/जतु-शब्दयोः तद्धिते षुक्-आगमः (विकार-अर्थे, अण्-सह)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.1.46", "to_sutra": "4.3.138"}}, {"sutra_id": "1.3.2", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "trapuzukNasaN", "form_after": "trapuzukNasaN", "why_dev": "उपदेशावस्थायाम् अज् वर्णः अनुनासिकः चेद् इत्-संज्ञकः; इँर्-वार्तिके पुनः द्वयोः संयुक्तः इत्। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "4.3.138", "to_sutra": "1.3.2"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "trapuzukNasaN", "form_after": "trapuzukNasaN", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.2", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.8", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "trapuzukNasaN", "form_after": "trapuzukNasaN", "why_dev": "अतद्धिते प्रत्ययादौ ल्-श्-कु-वर्णानाम् इत्-संज्ञा; लोपः १.३.९। सुप्-पङ्क्तिषु ङ्-आदिर् अपि (*N* ∈ *ku*)।", "status": "APPLIED", "why_now_dev": "अतद्धित-प्रत्ययस्य आदौ ल्/श्/कवर्ग-वर्णः 'इत्'-संज्ञां प्राप्नोति; अयं वर्णः अनन्तरं १.३.९ इति लुप्यते (यथा शप् → अ, ङी → ई)। (१.३.८)", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.8"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "trapuzukNasaN", "form_after": "trapuzasa", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.8", "to_sutra": "1.3.9"}}, {"sutra_id": "__ZUK_MERGE__", "sutra_type": "STRUCTURAL", "type_label": "षुक्-मेलनम्", "form_before": "trapuzasa", "form_after": "trapuzasa", "why_dev": "षुक्-आगमस्य शेष-वर्णः (ष्) अङ्गे एव अन्तर्भाव्यते (संरचनात्मकं, न सूत्रम्)।", "status": "APPLIED"}, {"sutra_id": "1.2.46", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "trapuzasa", "form_after": "trapuzasa", "why_dev": "कृत्-तद्धित-समासान्ताः शब्दाः प्रातिपदिक-संज्ञकाः।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "1.2.46"}}, {"sutra_id": "2.4.71", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "trapuzasa", "form_after": "trapuza", "why_dev": "धातु/प्रातिपदिक-अवयवे विद्यमानस्य सुपः लुक् (आर्म्ड-मेटा)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.2.46", "to_sutra": "2.4.71"}}, {"sutra_id": "6.4.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "trapuza", "form_after": "trapuza", "why_dev": "६.४.१ तः ७.४.९७ पर्यन्तानि सूत्राणि अङ्गस्य विधयः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "2.4.71", "to_sutra": "6.4.1"}}, {"sutra_id": "7.2.117"