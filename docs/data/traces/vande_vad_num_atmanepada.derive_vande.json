{"module": "pipelines.vande_vad_num_atmanepada", "callable": "derive_vande", "ok": true, "smoke_note": null, "invocation": {"args": [], "kwargs": {}}, "result_kind": "state", "final_flat_slp1": "vande", "phase": "angakarya", "tripadi_zone": false, "trace_len": 23, "trace": [{"sutra_id": "1.3.1", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "vadi", "form_after": "vadi", "why_dev": "भू आदि गणे पठितानां धातूनां धातु-संज्ञा (उपदेश एव अधिकृतः)।", "status": "APPLIED", "chronological_transition": {"from_sutra": null, "to_sutra": "1.3.1"}}, {"sutra_id": "1.3.2", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "vadi", "form_after": "vadi", "why_dev": "उपदेशावस्थायाम् अज् वर्णः अनुनासिकः चेद् इत्-संज्ञकः; इँर्-वार्तिके पुनः द्वयोः संयुक्तः इत्। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.1", "to_sutra": "1.3.2"}}, {"sutra_id": "1.3.5", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "vadi", "form_after": "vadi", "why_dev": "ञ्-इट्-डु-वर्णेषु प्रथमः हल् ‘इत्’ संज्ञकः; लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.2", "to_sutra": "1.3.5"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vadi", "form_after": "vad", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.5", "to_sutra": "1.3.9"}}, {"sutra_id": "1.1.47", "sutra_type": "NIYAMA", "type_label": "नियम", "form_before": "vad", "form_after": "vad", "why_dev": "मित्-आदेशः अङ्गस्य अन्त्य-अच् वर्णात् परः स्थाप्यते।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "1.1.47"}}, {"sutra_id": "7.1.58", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vad", "form_after": "vand", "why_dev": "इदित्-धातोः नुम्-आगमः (डेमो: वन्दे)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.1.47", "to_sutra": "7.1.58"}}, {"sutra_id": "3.1.91", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "vand", "form_after": "vand", "why_dev": "धातोः कृत्-तिङ्-प्रत्ययाः — अधिकारः ३.१.९१ तः ३.४.११७ पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "7.1.58", "to_sutra": "3.1.91"}}, {"sutra_id": "3.1.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "vand", "form_after": "vand", "why_dev": "अधिकारः प्रत्यय-विधानम् — ३.१.१ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.91", "to_sutra": "3.1.1"}}, {"sutra_id": "3.1.2", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "vand", "form_after": "vand", "why_dev": "प्रत्ययः निमित्तात् परः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.1", "to_sutra": "3.1.2"}}, {"sutra_id": "3.1.3", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "vand", "form_after": "vand", "why_dev": "प्रत्ययस्य आद्युदात्तत्वम् — अधिकारः ३.१.३ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.2", "to_sutra": "3.1.3"}}, {"sutra_id": "3.2.123", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "vand", "form_after": "vand", "why_dev": "वर्तमानाधिकारः — ३.२.१२३ तः ३.३.१ पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.3", "to_sutra": "3.2.123"}}, {"sutra_id": "1.3.12", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "vandla", "form_after": "vandla", "why_dev": "अनुदात्तेत्-धातोः कर्तरि आत्मनेपदम्; १.३.७८-शेष-परस्मैपदं न भवति।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "3.2.123", "to_sutra": "1.3.12"}}, {"sutra_id": "3.4.77", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "vandla", "form_after": "vandla", "why_dev": "लाधिकारः — ३.४.७७ तः ३.४.११२ पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.3.12", "to_sutra": "3.4.77"}}, {"sutra_id": "3.4.78", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vandla", "form_after": "vandiw", "why_dev": "लकार-प्रत्ययस्य स्थाने तिङ्-आदेश (तिप्-तस्-झि-…-महिङ्) — संज्ञाः १.४.९९ इत्यादि-सूत्रैः पृथक्; सूत्रे अभिकल्पित-तिङ्-लक्ष्यम्, न पुरुष-वचन-परिगणनम् (CONSTITUTION २)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "3.4.77", "to_sutra": "3.4.78"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "vandiw", "form_after": "vandiw", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "3.4.78", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vandiw", "form_after": "vandi", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.9"}}, {"sutra_id": "3.1.68", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vandi", "form_after": "vandSapi", "why_dev": "कर्तरि सार्वधातुके परे विकरण-शप्-आगमः; अपवादाः ३.१.६९ इत्यादौ पृथक्।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "3.1.68"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "vandSapi", "form_after": "vandSapi", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "3.1.68", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.8", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "vandSapi", "form_after": "vandSapi", "why_dev": "अतद्धिते प्रत्ययादौ ल्-श्-कु-वर्णानाम् इत्-संज्ञा; लोपः १.३.९। सुप्-पङ्क्तिषु ङ्-आदिर् अपि (*N* ∈ *ku*)।", "status": "APPLIED", "why_now_dev": "अतद्धित-प्रत्ययस्य आदौ ल्/श्/कवर्ग-वर्णः 'इत्'-संज्ञां प्राप्नोति; अयं वर्णः अनन्तरं १.३.९ इति लुप्यते (यथा शप् → अ, ङी → ई)। (१.३.८)", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.8"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vandSapi", "form_after": "vandai", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.8", "to_sutra": "1.3.9"}}, {"sutra_id": "1.1.64", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "vandai", "form_after": "vandai", "why_dev": "प्रत्ययस्य अन्त्य-अच्-आदि-भागः ‘टि’ संज्ञकः (डेमो-स्लाइस)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "1.1.64"}}, {"sutra_id": "3.4.79", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vandai", "form_after": "vandae", "why_dev": "आत्मनेपद-प्रत्ययस्य टि-भागे (अन्तिम-स्वर + अनन्तर) ‘ए’-आदेशः — ते, आते, जे, आथे, ध्वे, ए, वहे, महे।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.1.64", "to_sutra": "3.4.79"}}, {"sutra_id": "__MERGE__", "sutra_type": "STRUCTURAL", "type_label": "पद-मेलनम्", "form_before": "vandae", "form_after": "vandae", "why_dev": "पद-रचना — सर्व-धातु/सुबन्त/कृदन्त-संयोजनम् (संरचनात्मकं, न सूत्रम्)।", "status": "APPLIED", "event": "MERGE"}]}