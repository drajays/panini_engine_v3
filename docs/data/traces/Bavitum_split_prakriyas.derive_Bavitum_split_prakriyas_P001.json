{"module": "pipelines.Bavitum_split_prakriyas", "callable": "derive_Bavitum_split_prakriyas_P001", "ok": true, "smoke_note": null, "invocation": {"args": [], "kwargs": {}}, "result_kind": "state", "final_flat_slp1": "Bavitum", "phase": "angakarya", "tripadi_zone": false, "trace_len": 9, "trace": [{"sutra_id": "3.3.158", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "BUtumn", "form_after": "BUtumn", "why_dev": "समानकर्तृकेतुमर्थे तुमुन् (*split_prakriyas_11* **P001**, **भवितुम्**)।", "status": "APPLIED", "chronological_transition": {"from_sutra": null, "to_sutra": "3.3.158"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "BUtumn", "form_after": "BUtumn", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "3.3.158", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BUtumn", "form_after": "BUtum", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.9"}}, {"sutra_id": "7.2.35", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BUtum", "form_after": "BUitum", "why_dev": "आर्धधातुके परे वल्-प्रथमादौ इट्-आगमः (प्रतिषेधे न)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "7.2.35"}}, {"sutra_id": "7.3.84", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BUitum", "form_after": "Boitum", "why_dev": "अङ्गान्तिकः गुणः — धातोः परतरं सार्वधातुके वा आर्धधातुके वा (तिङ्-शित्-सूची, तृच्-आदि)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "7.2.35", "to_sutra": "7.3.84"}}, {"sutra_id": "6.1.78", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Boitum", "form_after": "Bavitum", "why_dev": "एचः (ए, ऐ, ओ, औ) स्थाने परे अचि क्रमेण अय्, अव्, आय्, आव् आदेशः (एचोऽयवायावः) — ओस्-विषयकः पूर्वे य्-आगम-वर्णनम् अत्रानुपयुक्तम्। अत्र यथा अङ्गान्ते एच्-वर्णः \"e\" (गुणात्) + परे अच् \"a\" (विकरणादादौ) → \"e\"+\"a\" → \"a\"+\"y\"+\"a\" (अय्) → je+a+… → jay+a+… → jayati। अपरः प्रसङ्गः: अदन्त-अङ्ग + \"ओस्\"-प्रत्यय (a+o) पूर्वे \"य्\"-आगमः।", "status": "APPLIED", "why_now_dev": "अच्-वर्णे परे एच्-वर्णस्य (ए/ऐ/ओ/औ) क्रमेण अय्/आय्/अव्/आव् इति आदेशः; यथा ए+अ → अय् (जे+अ → जय → जयति)। (६.१.७८)", "chronological_transition": {"from_sutra": "7.3.84", "to_sutra": "6.1.78"}}, {"sutra_id": "1.1.40", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "Bavitum", "form_after": "Bavitum", "why_dev": "क्त्वा-तोसुन्-कसुन्-प्रत्ययान्तस्य अव्ययत्वम् (२.४.८२ सुप्-लुक्-प्रसङ्गः)।", "status": "AUDIT", "chronological_transition": {"from_sutra": "6.1.78", "to_sutra": "1.1.40"}}, {"sutra_id": "4.1.2", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "Bavitum", "form_after": "Bavitumsu", "why_dev": "एकविंशति सुप्-प्रत्ययाः क्रमेण प्रातिपदिकात् विधीयन्ते; अधिकारः ४.१.२ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.40", "to_sutra": "4.1.2"}}, {"sutra_id": "2.4.82", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Bavitumsu", "form_after": "Bavitum", "why_dev": "अव्ययात् परस्य सुपः लुक् (अव्यय-शब्दाः अव्ययवत् तिष्ठन्ति)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "4.1.2", "to_sutra": "2.4.82"}}]}