{"module": "pipelines.tinanta", "callable": "derive_bhavisyatah", "ok": true, "smoke_note": null, "invocation": {"args": [], "kwargs": {}}, "result_kind": "state", "final_flat_slp1": "BavizyataH", "phase": "angakarya", "tripadi_zone": true, "trace_len": 89, "trace": [{"sutra_id": "1.1.20", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "BU", "form_after": "BU", "why_dev": "दा-धाव् अद-आप् च, घु-संज्ञा — इति धातु-तात्पर्यं।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": null, "to_sutra": "1.1.20"}}, {"sutra_id": "1.1.5", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BU", "form_after": "BU", "why_dev": "क्‍ङ्-परिच्छिन्ने प्रत्यय-क्षेपे, तस्मिन् आङ्ग-कार्ये, यः १.१.३-उत्सर्ग-इक-नियमः, सो न।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.20", "to_sutra": "1.1.5"}}, {"sutra_id": "1.3.1", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "BU", "form_after": "BU", "why_dev": "भू आदि गणे पठितानां धातूनां धातु-संज्ञा (उपदेश एव अधिकृतः)।", "status": "DEFINED", "chronological_transition": {"from_sutra": "1.1.5", "to_sutra": "1.3.1"}}, {"sutra_id": "1.3.2", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "BU", "form_after": "BU", "why_dev": "उपदेशावस्थायाम् अज् वर्णः अनुनासिकः चेद् इत्-संज्ञकः; इँर्-वार्तिके पुनः द्वयोः संयुक्तः इत्। लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.1", "to_sutra": "1.3.2"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "BU", "form_after": "BU", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.2", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.5", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "BU", "form_after": "BU", "why_dev": "ञ्-इट्-डु-वर्णेषु प्रथमः हल् ‘इत्’ संज्ञकः; लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.5"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BU", "form_after": "BU", "why_dev": "इत्-संज्ञक-वर्णाः न सन्ति, अतः लोपः शून्यः; तथापि नियम-परीक्षा अनिवार्या (१.३.९)।", "status": "VACUOUS", "lopa_count": 0, "chronological_transition": {"from_sutra": "1.3.5", "to_sutra": "1.3.9"}}, {"sutra_id": "6.1.64", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BU", "form_after": "BU", "why_dev": "धात्वादौ षकारस्य सकारः (P001-C ञिष्विदाँ → स्विद्, आर्म्-सीमितम्)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "6.1.64"}}, {"sutra_id": "6.1.65", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BU", "form_after": "BU", "why_dev": "धात्वादौ णकारस्य नकारः (णीञ् → नी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.64", "to_sutra": "6.1.65"}}, {"sutra_id": "7.1.101", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BU", "form_after": "BU", "why_dev": "धातोः उपधाभूतस्य ॠकारस्य इकारः (रपरः) — कॄत् → कीर्तयति।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.65", "to_sutra": "7.1.101"}}, {"sutra_id": "6.1.73", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BU", "form_after": "BU", "why_dev": "ह्रस्वस्वरात् परः अव्यवहितः छकारः विद्यते चेत् तस्य ह्रस्वस्य 'तुक्' आगमः। आद्यन्तौ टकितौ १.१.४६ इत्यनेन स्वरात् अनन्तरम्।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.101", "to_sutra": "6.1.73"}}, {"sutra_id": "6.1.75", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BU", "form_after": "BU", "why_dev": "दीर्घस्वरात् परः अव्यवहितः छकारः विद्यते चेत् दीर्घस्वरस्य 'तुक्' आगमः। आद्यन्तौ टकितौ १.१.४६ इत्यनेन स्वरात् अनन्तरम्।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.73", "to_sutra": "6.1.75"}}, {"sutra_id": "1.3.28", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BU", "form_after": "BU", "why_dev": "आङ्-पूर्वयोः यम्-हन्-धात्वोः कर्तरि आत्मनेपदम् (P010 आयच्छते)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.75", "to_sutra": "1.3.28"}}, {"sutra_id": "1.3.12", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BU", "form_after": "BU", "why_dev": "अनुदात्तेत्-धातोः कर्तरि आत्मनेपदम्; १.३.७८-शेष-परस्मैपदं न भवति।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.28", "to_sutra": "1.3.12"}}, {"sutra_id": "1.3.78", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BU", "form_after": "BU", "why_dev": "१.३.१२–७७ इत्यादिष्व् आत्मनेपद-विषयं विहाय अन्येभ्यो धातुभ्यः कर्तरि परस्मैपदम्; १.४.९९ इत्यादौ परस्मैपद-संज्ञा।", "status": "VACUOUS", "chronological_transition": {"from_sutra": "1.3.12", "to_sutra": "1.3.78"}}, {"sutra_id": "3.1.91", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "BU", "form_after": "BU", "why_dev": "धातोः कृत्-तिङ्-प्रत्ययाः — अधिकारः ३.१.९१ तः ३.४.११७ पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.3.78", "to_sutra": "3.1.91"}}, {"sutra_id": "3.1.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "BU", "form_after": "BU", "why_dev": "अधिकारः प्रत्यय-विधानम् — ३.१.१ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.91", "to_sutra": "3.1.1"}}, {"sutra_id": "3.1.2", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "BU", "form_after": "BU", "why_dev": "प्रत्ययः निमित्तात् परः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.1", "to_sutra": "3.1.2"}}, {"sutra_id": "3.1.3", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "BU", "form_after": "BU", "why_dev": "प्रत्ययस्य आद्युदात्तत्वम् — अधिकारः ३.१.३ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.2", "to_sutra": "3.1.3"}}, {"sutra_id": "3.3.13", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BU", "form_after": "BU", "why_dev": "धातोः प्रत्ययः (३.3.13)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "3.1.3", "to_sutra": "3.3.13"}}, {"sutra_id": "1.3.2", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "BUlR", "form_after": "BUlR", "why_dev": "उपदेशावस्थायाम् अज् वर्णः अनुनासिकः चेद् इत्-संज्ञकः; इँर्-वार्तिके पुनः द्वयोः संयुक्तः इत्। लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "3.3.13", "to_sutra": "1.3.2"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "BUlR", "form_after": "BUlR", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.2", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BUlR", "form_after": "BUl", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.9"}}, {"sutra_id": "3.4.77", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "BUl", "form_after": "BUl", "why_dev": "लाधिकारः — ३.४.७७ तः ३.४.११२ पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "3.4.77"}}, {"sutra_id": "3.4.78", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BUl", "form_after": "BUtas", "why_dev": "लकार-प्रत्ययस्य स्थाने तिङ्-आदेश (तिप्-तस्-झि-…-महिङ्) — संज्ञाः १.४.९९ इत्यादि-सूत्रैः पृथक्; सूत्रे अभिकल्पित-तिङ्-लक्ष्यम्, न पुरुष-वचन-परिगणनम् (CONSTITUTION २)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "3.4.77", "to_sutra": "3.4.78"}}, {"sutra_id": "1.4.99", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "BUtas", "form_after": "BUtas", "why_dev": "लकार-स्थानि तिङादेशादिषु अन्त्यैकादश-प्रकारेषु परस्मैपद-संज्ञा; तङादिषु १.४.१०० इति पृथक् (एकसंज्ञा-सापेक्ष)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "3.4.78", "to_sutra": "1.4.99"}}, {"sutra_id": "1.3.4", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "BUtas", "form_after": "BUtas", "why_dev": "विभक्ति-प्रत्यये अन्त्यौ तु-स्म-वर्णौ हलन्त्य-इत् संज्ञां न लभेते; विधिः १.३.३ एव न प्रवर्तते (तुस्मान्त-निषेधः)।", "status": "DEFINED", "chronological_transition": {"from_sutra": "1.4.99", "to_sutra": "1.3.4"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "BUtas", "form_after": "BUtas", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.4", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BUtas", "form_after": "BUtas", "why_dev": "इत्-संज्ञक-वर्णाः न सन्ति, अतः लोपः शून्यः; तथापि नियम-परीक्षा अनिवार्या (१.३.९)।", "status": "VACUOUS", "lopa_count": 0, "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.9"}}, {"sutra_id": "1.4.100", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "BUtas", "form_after": "BUtas", "why_dev": "लकार-स्थाने तङ्-आदेशाः शानच्-कानच् च आत्मनेपद-संज्ञकाः; एकसंज्ञाधिकारे परस्मैपद-संज्ञां बाधन्ते।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "skip_detail": "अत्र तिङ्-प्रत्ययः (तिप्) परस्मैपद-नियतः; तङ्-शानच्-कानच्-आत्मनेपद-नियम १.४.१०० अत्र न प्रवर्तते, अतः १.४.९९-दत्ता परस्मैपद-संज्ञा अनिर्बाधा।", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "1.4.100"}}, {"sutra_id": "3.4.79", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BUtas", "form_after": "BUtas", "why_dev": "आत्मनेपद-प्रत्ययस्य टि-भागे (अन्तिम-स्वर + अनन्तर) ‘ए’-आदेशः — ते, आते, जे, आथे, ध्वे, ए, वहे, महे।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.4.100", "to_sutra": "3.4.79"}}, {"sutra_id": "3.4.80", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BUtas", "form_after": "BUtas", "why_dev": "आत्मनेपद-२मध्यम-एकवचने 'थास्' स्थाने 'से' आदेशः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "3.4.79", "to_sutra": "3.4.80"}}, {"sutra_id": "3.4.113", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "BUtas", "form_after": "BUtas", "why_dev": "तिङ्-तथा-शित्-प्रत्ययः सार्वधातुक-संज्ञकः, आर्धधातुकानि ३.४.११४-अग्रे।", "status": "APPLIED", "chronological_transition": {"from_sutra": "3.4.80", "to_sutra": "3.4.113"}}, {"sutra_id": "3.1.33", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BUtas", "form_after": "BUsyatas", "why_dev": "लुट्-परे तासि-आगमः; P019: लृङि ``sy``-विकरणः।", "status": "APPLIED", "chronological_transition": {"from_sutra": "3.4.113", "to_sutra": "3.1.33"}}, {"sutra_id": "3.4.114", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "BUsyatas", "form_after": "BUsyatas", "why_dev": "शेषः प्रत्यय आर्धधातुक-संज्ञकः (तृच् इत्यादौ)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "3.1.33", "to_sutra": "3.4.114"}}, {"sutra_id": "6.1.45", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BUsyatas", "form_after": "BUsyatas", "why_dev": "उपदेशे एजन्तस्य धातोः आत्वम् अशिति प्रत्यये परे (ग्लै → ग्ला)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "3.4.114", "to_sutra": "6.1.45"}}, {"sutra_id": "7.2.10", "sutra_type": "PRATISHEDHA", "type_label": "प्रतिषेध", "form_before": "BUsyatas", "form_after": "BUsyatas", "why_dev": "एकाच् धातौ आर्धधातुके इट्-प्रतिषेधः (त्रिच्-पथ)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.45", "to_sutra": "7.2.10"}}, {"sutra_id": "7.2.35", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BUsyatas", "form_after": "BUisyatas", "why_dev": "आर्धधातुके परे वल्-प्रथमादौ इट्-आगमः (प्रतिषेधे न)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "7.2.10", "to_sutra": "7.2.35"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "BUisyatas", "form_after": "BUisyatas", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.2.35", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BUisyatas", "form_after": "BUisyatas", "why_dev": "इत्-संज्ञक-वर्णाः न सन्ति, अतः लोपः शून्यः; तथापि नियम-परीक्षा अनिवार्या (१.३.९)।", "status": "VACUOUS", "lopa_count": 0, "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.9"}}, {"sutra_id": "1.2.4", "sutra_type": "ATIDESHA", "type_label": "अतिदेश", "form_before": "BUisyatas", "form_after": "BUisyatas", "why_dev": "अपित्-सार्वधातुकस्य कङित्-व्यवहारः — गुणादि निषेध-प्रसङ्गः (कुरुतः)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "1.2.4"}}, {"sutra_id": "7.1.5", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BUisyatas", "form_after": "BUisyatas", "why_dev": "(सूत्रम् 7.1.5) आत्मनेपदेष्वनतः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.2.4", "to_sutra": "7.1.5"}}, {"sutra_id": "7.1.3", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BUisyatas", "form_after": "BUisyatas", "why_dev": "झि-प्रत्ययस्य झकारस्य अन्तादेशः → अन्ति (परस्मैपद); कर्मणि झ (J) → अन्त → झे (Je) के बाद अन्ते।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.1.5", "to_sutra": "7.1.3"}}, {"sutra_id": "1.4.13", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "BUisyatas", "form_after": "BUisyatas", "why_dev": "प्रत्यय-विधेर् यस्मात् तदादि प्रत्यये यत् तद् अङ्गम्।", "status": "DEFINED", "chronological_transition": {"from_sutra": "7.1.3", "to_sutra": "1.4.13"}}, {"sutra_id": "1.1.5", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BUisyatas", "form_after": "BUisyatas", "why_dev": "क्‍ङ्-परिच्छिन्ने प्रत्यय-क्षेपे, तस्मिन् आङ्ग-कार्ये, यः १.१.३-उत्सर्ग-इक-नियमः, सो न।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.4.13", "to_sutra": "1.1.5"}}, {"sutra_id": "7.3.101", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BUisyatas", "form_after": "BUisyatas", "why_dev": "अङ्ग/विकरण-अन्तस्य ह्रस्व-अकारस्य, यञ्-आदि-प्रत्यय-परे, दीर्घादेशः; उत्तम-पुरुष-तिङन्ते: भव+अ+मि → भव+आ+मि → भवामि।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.5", "to_sutra": "7.3.101"}}, {"sutra_id": "7.3.84", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BUisyatas", "form_after": "Boisyatas", "why_dev": "अङ्गान्तिकः गुणः — धातोः परतरं सार्वधातुके वा आर्धधातुके वा (तिङ्-शित्-सूची, तृच्-आदि)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "7.3.101", "to_sutra": "7.3.84"}}, {"sutra_id": "1.1.51", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "Boisyatas", "form_after": "Boisyatas", "why_dev": "ऋ/ऌ-प्रसङ्गे अण्-आदेशानन्तरं र्/ल्-आगमः (यथासङ्ख्यम्) — उरण् रपरः (कृ→कर्, हृ→हर्)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.3.84", "to_sutra": "1.1.51"}}, {"sutra_id": "1.4.14", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "Boisyatas", "form_after": "Boisyatas", "why_dev": "सुप्-अन्तः तिङ्-अन्तः वा शब्दः पद-संज्ञकः (अष्टाध्यायी)।", "status": "APPLIED", "why_now_dev": "सुप्-अन्तः तिङ्-अन्तः वा शब्दः पद-संज्ञकः; अनेन पद-कार्याणि (त्रिपादी-सन्धि-आदि) प्रसजन्ति। (१.४.१४)", "chronological_transition": {"from_sutra": "1.1.51", "to_sutra": "1.4.14"}}, {"sutra_id": "6.1.78", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Boisyatas", "form_after": "Bavisyatas", "why_dev": "एचः (ए, ऐ, ओ, औ) स्थाने परे अचि क्रमेण अय्, अव्, आय्, आव् आदेशः (एचोऽयवायावः) — ओस्-विषयकः पूर्वे य्-आगम-वर्णनम् अत्रानुपयुक्तम्। अत्र यथा अङ्गान्ते एच्-वर्णः \"e\" (गुणात्) + परे अच् \"a\" (विकरणादादौ) → \"e\"+\"a\" → \"a\"+\"y\"+\"a\" (अय्) → je+a+… → jay+a+… → jayati। अपरः प्रसङ्गः: अदन्त-अङ्ग + \"ओस्\"-प्रत्यय (a+o) पूर्वे \"य्\"-आगमः।", "status": "APPLIED", "why_now_dev": "अच्-वर्णे परे एच्-वर्णस्य (ए/ऐ/ओ/औ) क्रमेण अय्/आय्/अव्/आव् इति आदेशः; यथा ए+अ → अय् (जे+अ → जय → जयति)। (६.१.७८)", "chronological_transition": {"from_sutra": "1.4.14", "to_sutra": "6.1.78"}}, {"sutra_id": "6.1.97", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Bavisyatas", "form_after": "Bavisyatas", "why_dev": "गुणे पररूप-एकादेशः — अकार-द्वय-संयोगे प्रथमम् अकारं लोपयति।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.78", "to_sutra": "6.1.97"}}, {"sutra_id": "7.2.81", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Bavisyatas", "form_after": "Bavisyatas", "why_dev": "कर्मणि/भावे ङित-विकरण-पूर्वम् आत्मनेपद-द्विवचनस्य आकारस्य 'इय्'-आदेशः — आते → इय्ते, आथे → इय्थे।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.97", "to_sutra": "7.2.81"}}, {"sutra_id": "6.1.66", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Bavisyatas", "form_after": "Bavisyatas", "why_dev": "तृच्-पथ: दीर्घात् परस्य अपृक्त हल्-लोपः (सु→स्)। विधि-लिङ्-पथ: यासुट्-अवशेष [i,y] में य्-लोपः हल्-पूर्वे। आशीर्-लिङ्-पथ (२मध्यम-एक): यासुट्-पश्चात् सिप्-जन्य-स्-लोपः। कर्मणि-पथ: ७.२.८१-जन्य इय् में य्-लोपः हल्-पूर्वे (इय्ते→इते)। कर्मणि-विधिलिङ्-पथ: सीयुट्-अवशेष [I,y] में य्-लोपः हल्-पूर्वे। व्योः-वलि-पथ: य्-लोपः व/ल/र/त्-पूर्वम् (**1.1.58**+**6.4.48** पाठ)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "7.2.81", "to_sutra": "6.1.66"}}, {"sutra_id": "6.1.87", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Bavisyatas", "form_after": "Bavisyatas", "why_dev": "अ-कारात् परे इक् वर्णे एकादेश-रूपेण गुणः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.66", "to_sutra": "6.1.87"}}, {"sutra_id": "6.4.19", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Bavisyatas", "form_after": "Bavisyatas", "why_dev": "क्ङिति परे (पृच्छ्) अन्त्य-च्छ् → श् (पृष्ट्वा-पूर्वम्)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.1.87", "to_sutra": "6.4.19"}}, {"sutra_id": "__MERGE__", "sutra_type": "STRUCTURAL", "type_label": "पद-मेलनम्", "form_before": "Bavisyatas", "form_after": "Bavisyatas", "why_dev": "पद-रचना — सर्व-धातु/सुबन्त/कृदन्त-संयोजनम् (संरचनात्मकं, न सूत्रम्)।", "status": "APPLIED", "event": "MERGE"}, {"sutra_id": "8.2.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "Bavisyatas", "form_after": "Bavisyatas", "why_dev": "८.२.१ तः ८.४.६८ पर्यन्तम् (त्रिपादी) पूर्व-सूत्रेभ्यः असिद्धम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "6.4.19", "to_sutra": "8.2.1"}}, {"sutra_id": "8.2.23", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Bavisyatas", "form_after": "Bavisyatas", "why_dev": "संयोगान्त-पदस्य अन्त्य-हल्-लोपः (चितवान्)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.1", "to_sutra": "8.2.23"}}, {"sutra_id": "8.2.25", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Bavisyatas", "form_after": "Bavisyatas", "why_dev": "(सूत्रम् 8.2.25) धि च।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.23", "to_sutra": "8.2.25"}}, {"sutra_id": "8.2.27", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Bavisyatas", "form_after": "Bavisyatas", "why_dev": "ह्रस्वान्ताद् अङ्गात् परस्य सिचः सस्य लोपो झलि — अकृत।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.25", "to_sutra": "8.2.27"}}, {"sutra_id": "8.2.26", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Bavisyatas", "form_after": "Bavisyatas", "why_dev": "झलो झलि परे लोपः — प०३३ (घ्स्-त-)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.27", "to_sutra": "8.2.26"}}, {"sutra_id": "8.2.36", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Bavisyatas", "form_after": "Bavisyatas", "why_dev": "व्रश्चभ्रस्ज…च्छशां षः: a dhātu-final श्/छ् (and सृज्, मृज्, यज्, राज्, भ्राज्) → ष् before a jhal or at the pada end (apavāda of 8.2.30) — दंश्+स्य, सृज्+त → सृष्ट.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.26", "to_sutra": "8.2.36"}}, {"sutra_id": "8.2.30", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Bavisyatas", "form_after": "Bavisyatas", "why_dev": "झलि/पदान्ते परे च-वर्णस्य क-वर्णादेशः (उक्त-उपपत्ति)। प००३-ए: त्रिपादी-प्रवेशात् पूर्वम् अनुमतम्।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.36", "to_sutra": "8.2.30"}}, {"sutra_id": "8.2.32", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Bavisyatas", "form_after": "Bavisyatas", "why_dev": "दादेर्धातोर्घः: the ह् of a द्-initial dhātu → घ् (apavāda of 8.2.31) — दुह् → दुघ्, दह् → दघ्.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.30", "to_sutra": "8.2.32"}}, {"sutra_id": "8.2.34", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Bavisyatas", "form_after": "Bavisyatas", "why_dev": "नहो धः: the ह् of नह् → ध् (apavāda of 8.2.31) — नह्+त → नद्ध.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.32", "to_sutra": "8.2.34"}}, {"sutra_id": "8.2.31", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Bavisyatas", "form_after": "Bavisyatas", "why_dev": "हो ढः: ह् → ढ् before a jhal or at the pada end — लिह्+स्य → लिढ्+स्य.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.34", "to_sutra": "8.2.31"}}, {"sutra_id": "8.2.37", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Bavisyatas", "form_after": "Bavisyatas", "why_dev": "एकाचो बशो भष् झषन्तस्य स्ध्वोः: a one-vowel dhātu beginning with बश् and ending in झष् aspirates its initial before स्/ध्व् or at the end — दुघ्+स्य → धुघ्+स्य (धोक्ष्यति).", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.31", "to_sutra": "8.2.37"}}, {"sutra_id": "8.2.39", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Bavisyatas", "form_after": "Bavisyatas", "why_dev": "पदान्ते झल्-व्यञ्जनस्य स्थाने जश्-व्यञ्जनः (सूत्रम् ८.२.३९ झलां जशोऽन्ते) — त् → द्।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.37", "to_sutra": "8.2.39"}}, {"sutra_id": "8.2.40", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Bavisyatas", "form_after": "Bavisyatas", "why_dev": "झष्-पूर्वे त्/थ् का ध्-आदेशः (डेमो: रुणद्धि; प००१-डि पूर्व-त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.39", "to_sutra": "8.2.40"}}, {"sutra_id": "8.2.41", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Bavisyatas", "form_after": "Bavisyatas", "why_dev": "षढोः कः सि: ष्/ढ् before स् → क् — लेढ्+स्य → लेक्+स्य.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.40", "to_sutra": "8.2.41"}}, {"sutra_id": "8.2.66", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Bavisyatas", "form_after": "Bavisyatar", "why_dev": "पदान्त-सकारस्य सजुषः च रु-आदेशः (त्रिपादी)।", "status": "APPLIED", "why_now_dev": "पदान्त-सकारस्य 'रु'-आदेशः (त्रिपादी); अयं रु पुनः ८.३.१५ इति खर्/अवसाने विसर्गः, अन्यत्र (घोष-हलि) रेफः अवशिष्यते। (८.२.६६)", "chronological_transition": {"from_sutra": "8.2.41", "to_sutra": "8.2.66"}}, {"sutra_id": "8.2.77", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Bavisyatar", "form_after": "Bavisyatar", "why_dev": "धातोः र्वोः पूर्वस्य इकः दीर्घः हलि परे (दीव्यति)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.66", "to_sutra": "8.2.77"}}, {"sutra_id": "8.2.78", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Bavisyatar", "form_after": "Bavisyatar", "why_dev": "धातोः उपधाभूतयोः र्वोः पूर्वस्य इकः दीर्घः (मूर्वति)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.77", "to_sutra": "8.2.78"}}, {"sutra_id": "8.3.15", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "Bavisyatar", "form_after": "BavisyataH", "why_dev": "खर्-वर्णे परे अवसाने च रु-आदेशस्य विसर्गः।", "status": "APPLIED", "why_now_dev": "खर्-वर्णे परे अवसाने च 'रु' (८.२.६६) इत्यस्य विसर्गः (ः); एवं रामः, धनुः इति विसर्गान्त-रूपं सिध्यति। (८.३.१५)", "chronological_transition": {"from_sutra": "8.2.78", "to_sutra": "8.3.15"}}, {"sutra_id": "8.3.24", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BavisyataH", "form_after": "BavisyataH", "why_dev": "अपदान्त-नकारस्य झलि परे अनुस्वारः (डेमो: मुञ्चति)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.15", "to_sutra": "8.3.24"}}, {"sutra_id": "8.3.59", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BavisyataH", "form_after": "BavizyataH", "why_dev": "इन्-कुक्-पूर्वे स-कारस्य (प्रत्ययस्थस्य) 'ष'-आदेशः (त्रिपादी)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "8.3.24", "to_sutra": "8.3.59"}}, {"sutra_id": "8.3.60", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BavizyataH", "form_after": "BavizyataH", "why_dev": "वसादौ (सम्प्रसारणोत्तरं) सस्य षत्वं (उषित्वा)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.59", "to_sutra": "8.3.60"}}, {"sutra_id": "8.4.1", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BavizyataH", "form_after": "BavizyataH", "why_dev": "समानपदे रेफ-ष-वर्णाभ्यां (ऋवर्णाद् अपि) ऋणे परस्य न-कारस्य सन्निहिते णादेशः (१०८ संहितायाम्, त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.60", "to_sutra": "8.4.1"}}, {"sutra_id": "8.4.2", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BavizyataH", "form_after": "BavizyataH", "why_dev": "र-ष-वर्णात् परस्य न-कारस्य णत्वम् — अट्-कु-पु-आङ्-नुम् व्यवधाने अपि (त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.1", "to_sutra": "8.4.2"}}, {"sutra_id": "8.4.40", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BavizyataH", "form_after": "BavizyataH", "why_dev": "चवर्गे परे स्तोः श्चुनेन श्चुः (डेमो: दधि+छत्रम्); ष्टुणा-शाखा पुरातन-मार्ज्वि-मार्गे।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.2", "to_sutra": "8.4.40"}}, {"sutra_id": "8.4.41", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BavizyataH", "form_after": "BavizyataH", "why_dev": "ष्-समीपे तकारस्य टकारादेशः; प०३१ न्→ण्; P001-B पूर्व-त्रिपादी ``z``+``t``।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.40", "to_sutra": "8.4.41"}}, {"sutra_id": "8.4.53", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "BavizyataH", "form_after": "BavizyataH",