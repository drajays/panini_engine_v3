{"module": "pipelines.viSAKaH_taddhita_luk_aR_paribhasha", "callable": "derive_viSAKaH_taddhita_luk_aR_P039", "ok": true, "smoke_note": null, "invocation": {"args": [], "kwargs": {}}, "result_kind": "state", "final_flat_slp1": "viSAKaH", "phase": "angakarya", "tripadi_zone": true, "trace_len": 51, "trace": [{"sutra_id": "1.1.68", "sutra_type": "ANUVADA", "type_label": "अनुवाद", "form_before": "viSAKA", "form_after": "viSAKA", "why_dev": "शब्दः स्व-रूप-पर्यायः (अशब्द-संज्ञा-अपवादः) — डेमो-आडिट्।", "status": "AUDIT", "chronological_transition": {"from_sutra": null, "to_sutra": "1.1.68"}}, {"sutra_id": "4.1.76", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "viSAKA", "form_after": "viSAKA", "why_dev": "तद्धिताधिकारः — ४.१.७६ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.68", "to_sutra": "4.1.76"}}, {"sutra_id": "4.3.25", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKA", "form_after": "viSAKAaR", "why_dev": "विशाखायां जात इति प्रसङ्गे अण् (४.३.२५) — P039।", "status": "APPLIED", "parts": [["viSAKA", "prakriti", "viSAKA"], ["aR", "taddhita", "aR"]], "chronological_transition": {"from_sutra": "4.1.76", "to_sutra": "4.3.25"}}, {"sutra_id": "4.3.34", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKAaR", "form_after": "viSAKA", "why_dev": "विशाखायाः अण्-प्रत्ययस्य लुक् (४.३.३४) — P039 संक्षेप-छेदः।", "status": "APPLIED", "parts": [["viSAKA", "prakriti", "viSAKA"]], "chronological_transition": {"from_sutra": "4.3.25", "to_sutra": "4.3.34"}}, {"sutra_id": "1.1.60", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "viSAKA", "form_after": "viSAKA", "why_dev": "स्थानिनि वर्णः वा वर्णसमूहः वा अदर्शनं यत्, तत् 'लोप' इति संज्ञा — उपयोगः १.३.९, ८.२.२३, ६.१.६८, … इतिषु; अत्र केवल संज्ञा-निर्णयः।", "status": "DEFINED", "chronological_transition": {"from_sutra": "4.3.34", "to_sutra": "1.1.60"}}, {"sutra_id": "1.1.61", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "viSAKA", "form_after": "viSAKA", "why_dev": "प्रत्ययस्य लोपः यदा 'लुक्' / 'श्लुः' / 'लुप्' इति विशिष्टेन शब्देनोक्तः, तदा स लोपः तथैव संज्ञकः; केवलं 'लोपः' इति शब्देनोक्तस्तु न — १.१.६३ इत्यादौ 'लु' इति सामान्यनिर्देशः; सम्पूर्ण-प्रत्ययलोपे १.१.५२, १.१.५४ न। तिसृणां प्रयोजनम् — श्लौ ६.१.१० इति श्लुः-संज्ञकलोपानन्तरं प्रकृतेः द्वित्वम् (यथा दा+शप्+ति → ददाति); लुक् समूहलोपे, तद्धिते लुकि १.२.४९ लुक्तद्धितलुकि उपसर्जन-स्त्रीप्रत्ययस्यापि लुक् (यथा आमलक्याः फलम् → आमलक+…, ४.३.१६३); १.१.६२–६३ प्रत्ययलक्षणम् / न लुमताङ्गस्य — अनिष्टाङ्गकार्ये लुक्-श्लु-लुप्-संज्ञा (यथा पञ्चन्+जस् → पञ्च, ७.१.२२); लुप्-संज्ञायां १.२.५१ लुपि युक्तवद् व्यक्तिवचने इति लिङ्ग-वचने प्रकृतिम् अनुसरतः (यथा पञ्चालानां निवासः → पञ्चालाः जनपदः, ४.२.८१ इत्यादौ लुप्)।", "status": "DEFINED", "chronological_transition": {"from_sutra": "1.1.60", "to_sutra": "1.1.61"}}, {"sutra_id": "4.1.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "viSAKA", "form_after": "viSAKA", "why_dev": "प्रातिपदिकाधिकारः — ४.१.१ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.61", "to_sutra": "4.1.1"}}, {"sutra_id": "4.1.3", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "viSAKA", "form_after": "viSAKA", "why_dev": "स्त्र्यधिकारः (द्वितीयः) — ४.१.३ तः ४.१.८९ पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "4.1.1", "to_sutra": "4.1.3"}}, {"sutra_id": "4.1.4", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKA", "form_after": "viSAKA", "why_dev": "अजादिगण-शब्देभ्यः ह्रस्व-अकारान्तेभ्यश्च स्त्रियाम् टाप्; ईयसो बहुव्रीहेः प्रतिषेधो वार्तिकेन (अङ्गे 'Iyas_bahuvrIhi_pratishedha' इति)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "4.1.3", "to_sutra": "4.1.4"}}, {"sutra_id": "4.1.2", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKA", "form_after": "viSAKAsu", "why_dev": "एकविंशति सुप्-प्रत्ययाः क्रमेण प्रातिपदिकात् विधीयन्ते; अधिकारः ४.१.२ तः ५.४.१६० पर्यन्तम्।", "status": "APPLIED", "parts": [["viSAKA", "prakriti", "viSAKA"], ["su", "sup", "s~"]], "chronological_transition": {"from_sutra": "4.1.4", "to_sutra": "4.1.2"}}, {"sutra_id": "1.3.2", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "viSAKAsu", "form_after": "viSAKAsu", "why_dev": "उपदेशावस्थायाम् अज् वर्णः अनुनासिकः चेद् इत्-संज्ञकः; इँर्-वार्तिके पुनः द्वयोः संयुक्तः इत्। लोपः १.३.९।", "status": "APPLIED", "parts": [["viSAKA", "prakriti", "viSAKA"], ["su", "sup", "s~"]], "chronological_transition": {"from_sutra": "4.1.2", "to_sutra": "1.3.2"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKAsu", "form_after": "viSAKAs", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "parts": [["viSAKA", "prakriti", "viSAKA"], ["s", "sup", "s~"]], "chronological_transition": {"from_sutra": "1.3.2", "to_sutra": "1.3.9"}}, {"sutra_id": "1.2.41", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "viSAKAs", "form_after": "viSAKAs", "why_dev": "एक-हल्-प्रत्ययः अपृक्त-संज्ञकः (ईट्-आगम ७.३.९६ इत्यादि-प्रसङ्गे)।", "status": "APPLIED", "why_now_dev": "एक-अल् (एक-वर्ण) प्रत्ययः 'अपृक्त'-संज्ञां प्राप्नोति; अनया संज्ञया ईट्-आगम-आदि-विधयः (यथा ७.३.९६) प्रवर्तन्ते। (१.२.४१)", "parts": [["viSAKA", "prakriti", "viSAKA"], ["s", "sup", "s~"]], "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "1.2.41"}}, {"sutra_id": "6.1.68", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKAs", "form_after": "viSAKA", "why_dev": "हल्-अन्तात् / ङी-आभ्-अन्तात् दीर्घात् अङ्गात् परस्य अपृक्त-सु-हल्-लोपः।", "status": "APPLIED", "parts": [["viSAKA", "prakriti", "viSAKA"]], "chronological_transition": {"from_sutra": "1.2.41", "to_sutra": "6.1.68"}}, {"sutra_id": "__MERGE__", "sutra_type": "STRUCTURAL", "type_label": "P039-पुं-प्रथम-पद", "form_before": "viSAKas", "form_after": "viSAKas", "why_dev": "टाप्-अन्त-स्त्रीमूलात् पुंलिङ्ग-प्रथमायाः विशाख-आकारान्तं तथा पदान्त-सकारं संरचनात्मकं (JSON क्रमे ८.२.६६ सङ्क्षेपः)।", "status": "APPLIED"}, {"sutra_id": "8.2.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "viSAKas", "form_after": "viSAKas", "why_dev": "८.२.१ तः ८.४.६८ पर्यन्तम् (त्रिपादी) पूर्व-सूत्रेभ्यः असिद्धम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "6.1.68", "to_sutra": "8.2.1"}}, {"sutra_id": "8.2.23", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKas", "form_after": "viSAKas", "why_dev": "संयोगान्त-पदस्य अन्त्य-हल्-लोपः (चितवान्)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.1", "to_sutra": "8.2.23"}}, {"sutra_id": "8.2.25", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKas", "form_after": "viSAKas", "why_dev": "(सूत्रम् 8.2.25) धि च।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.23", "to_sutra": "8.2.25"}}, {"sutra_id": "8.2.27", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKas", "form_after": "viSAKas", "why_dev": "ह्रस्वान्ताद् अङ्गात् परस्य सिचः सस्य लोपो झलि — अकृत।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.25", "to_sutra": "8.2.27"}}, {"sutra_id": "8.2.28", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKas", "form_after": "viSAKas", "why_dev": "इट्-आगमे सति सिच्-स्थ-सकारस्य लोपः (लुङ्-प्रक्रिया, अलावीत्)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.27", "to_sutra": "8.2.28"}}, {"sutra_id": "8.2.26", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKas", "form_after": "viSAKas", "why_dev": "झलो झलि परे लोपः — प०३३ (घ्स्-त-)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.28", "to_sutra": "8.2.26"}}, {"sutra_id": "8.2.36", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKas", "form_after": "viSAKas", "why_dev": "व्रश्चभ्रस्ज…च्छशां षः: a dhātu-final श्/छ् (and सृज्, मृज्, यज्, राज्, भ्राज्) → ष् before a jhal or at the pada end (apavāda of 8.2.30) — दंश्+स्य, सृज्+त → सृष्ट.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.26", "to_sutra": "8.2.36"}}, {"sutra_id": "8.2.30", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKas", "form_after": "viSAKas", "why_dev": "झलि/पदान्ते परे च-वर्णस्य क-वर्णादेशः (उक्त-उपपत्ति)। प००३-ए: त्रिपादी-प्रवेशात् पूर्वम् अनुमतम्।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.36", "to_sutra": "8.2.30"}}, {"sutra_id": "8.2.32", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKas", "form_after": "viSAKas", "why_dev": "दादेर्धातोर्घः: the ह् of a द्-initial dhātu → घ् (apavāda of 8.2.31) — दुह् → दुघ्, दह् → दघ्.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.30", "to_sutra": "8.2.32"}}, {"sutra_id": "8.2.34", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKas", "form_after": "viSAKas", "why_dev": "नहो धः: the ह् of नह् → ध् (apavāda of 8.2.31) — नह्+त → नद्ध.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.32", "to_sutra": "8.2.34"}}, {"sutra_id": "8.2.31", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKas", "form_after": "viSAKas", "why_dev": "हो ढः: ह् → ढ् before a jhal or at the pada end — लिह्+स्य → लिढ्+स्य.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.34", "to_sutra": "8.2.31"}}, {"sutra_id": "8.2.37", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKas", "form_after": "viSAKas", "why_dev": "एकाचो बशो भष् झषन्तस्य स्ध्वोः: a one-vowel dhātu beginning with बश् and ending in झष् aspirates its initial before स्/ध्व् or at the end — दुघ्+स्य → धुघ्+स्य (धोक्ष्यति).", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.31", "to_sutra": "8.2.37"}}, {"sutra_id": "8.2.39", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKas", "form_after": "viSAKas", "why_dev": "पदान्ते झल्-व्यञ्जनस्य स्थाने जश्-व्यञ्जनः (सूत्रम् ८.२.३९ झलां जशोऽन्ते) — त् → द्।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.37", "to_sutra": "8.2.39"}}, {"sutra_id": "8.2.40", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKas", "form_after": "viSAKas", "why_dev": "झष्-पूर्वे त्/थ् का ध्-आदेशः (डेमो: रुणद्धि; प००१-डि पूर्व-त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.39", "to_sutra": "8.2.40"}}, {"sutra_id": "8.2.41", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKas", "form_after": "viSAKas", "why_dev": "षढोः कः सि: ष्/ढ् before स् → क् — लेढ्+स्य → लेक्+स्य.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.40", "to_sutra": "8.2.41"}}, {"sutra_id": "8.2.66", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKas", "form_after": "viSAKar", "why_dev": "पदान्त-सकारस्य सजुषः च रु-आदेशः (त्रिपादी)।", "status": "APPLIED", "why_now_dev": "पदान्त-सकारस्य 'रु'-आदेशः (त्रिपादी); अयं रु पुनः ८.३.१५ इति खर्/अवसाने विसर्गः, अन्यत्र (घोष-हलि) रेफः अवशिष्यते। (८.२.६६)", "parts": [["viSAKar", "pada", "viSAKA"]], "chronological_transition": {"from_sutra": "8.2.41", "to_sutra": "8.2.66"}}, {"sutra_id": "8.2.77", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKar", "form_after": "viSAKar", "why_dev": "धातोः र्वोः पूर्वस्य इकः दीर्घः हलि परे (दीव्यति)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.66", "to_sutra": "8.2.77"}}, {"sutra_id": "8.2.78", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKar", "form_after": "viSAKar", "why_dev": "धातोः उपधाभूतयोः र्वोः पूर्वस्य इकः दीर्घः (मूर्वति)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.77", "to_sutra": "8.2.78"}}, {"sutra_id": "8.3.15", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKar", "form_after": "viSAKaH", "why_dev": "खर्-वर्णे परे अवसाने च रु-आदेशस्य विसर्गः।", "status": "APPLIED", "why_now_dev": "खर्-वर्णे परे अवसाने च 'रु' (८.२.६६) इत्यस्य विसर्गः (ः); एवं रामः, धनुः इति विसर्गान्त-रूपं सिध्यति। (८.३.१५)", "parts": [["viSAKaH", "pada", "viSAKA"]], "chronological_transition": {"from_sutra": "8.2.78", "to_sutra": "8.3.15"}}, {"sutra_id": "8.3.24", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKaH", "form_after": "viSAKaH", "why_dev": "अपदान्तस्य नकारस्य मकारस्य च झलि परे अनुस्वारः (यशांसि, आक्रंस्यते)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.15", "to_sutra": "8.3.24"}}, {"sutra_id": "8.3.59", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKaH", "form_after": "viSAKaH", "why_dev": "इन्-कुक्-पूर्वे स-कारस्य (प्रत्ययस्थस्य) 'ष'-आदेशः (त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.24", "to_sutra": "8.3.59"}}, {"sutra_id": "8.3.60", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKaH", "form_after": "viSAKaH", "why_dev": "वसादौ (सम्प्रसारणोत्तरं) सस्य षत्वं (उषित्वा)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.59", "to_sutra": "8.3.60"}}, {"sutra_id": "8.4.1", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKaH", "form_after": "viSAKaH", "why_dev": "समानपदे रेफ-ष-वर्णाभ्यां (ऋवर्णाद् अपि) ऋणे परस्य न-कारस्य सन्निहिते णादेशः (१०८ संहितायाम्, त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.60", "to_sutra": "8.4.1"}}, {"sutra_id": "8.4.2", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKaH", "form_after": "viSAKaH", "why_dev": "र-ष-वर्णात् परस्य न-कारस्य णत्वम् — अट्-कु-पु-आङ्-नुम् व्यवधाने अपि (त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.1", "to_sutra": "8.4.2"}}, {"sutra_id": "8.4.40", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKaH", "form_after": "viSAKaH", "why_dev": "चवर्गे परे स्तोः श्चुनेन श्चुः (डेमो: दधि+छत्रम्); ष्टुणा-शाखा पुरातन-मार्ज्वि-मार्गे।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.2", "to_sutra": "8.4.40"}}, {"sutra_id": "8.4.41", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKaH", "form_after": "viSAKaH", "why_dev": "ष्-समीपे तकारस्य टकारादेशः; प०३१ न्→ण्; P001-B पूर्व-त्रिपादी ``z``+``t``।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.40", "to_sutra": "8.4.41"}}, {"sutra_id": "8.3.13", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKaH", "form_after": "viSAKaH", "why_dev": "ढकारे परे ढकारस्य लोपः — लेढ्+ढा → लेढा।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.41", "to_sutra": "8.3.13"}}, {"sutra_id": "6.3.112", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKaH", "form_after": "viSAKaH", "why_dev": "ढ्-लोपे सह्-वह्-धात्वोः अवर्णस्य ओकारः — सढ्+ढा → सोढा।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.3.13", "to_sutra": "6.3.112"}}, {"sutra_id": "6.3.111", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKaH", "form_after": "viSAKaH", "why_dev": "ढ्-लोपे सति पूर्वस्य अणः दीर्घः — लिढ्+ढ → लीढ।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.3.112", "to_sutra": "6.3.111"}}, {"sutra_id": "8.4.53", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKaH", "form_after": "viSAKaH", "why_dev": "झशि परे झल्-वर्णस्य जश्-आदेशः (डेमो: ध् → द्; प००१-डि पूर्व-त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "6.3.111", "to_sutra": "8.4.53"}}, {"sutra_id": "8.4.54", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKaH", "form_after": "viSAKaH", "why_dev": "अभ्यास-स्थिते झश्-वर्णस्य जश्-आदेशः (भि→बि) — विभिदतुः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.53", "to_sutra": "8.4.54"}}, {"sutra_id": "8.4.55", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKaH", "form_after": "viSAKaH", "why_dev": "खरि परे झल्-कार्यम् (द्→त्); प०३१—प०३४ ग्लास्-बॉक्स् पूरणम्।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.54", "to_sutra": "8.4.55"}}, {"sutra_id": "8.4.56", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKaH", "form_after": "viSAKaH", "why_dev": "(सूत्रम् 8.4.56) वाऽवसाने।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.55", "to_sutra": "8.4.56"}}, {"sutra_id": "8.4.58", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKaH", "form_after": "viSAKaH", "why_dev": "ययि परे अनुस्वारस्य परसवर्णः (डेमो: मुञ्चति)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.4.56", "to_sutra": "8.4.58"}}, {"sutra_id": "8.4.68", "sutra_type": "ANUVADA", "type_label": "अनुवाद", "form_before": "viSAKaH", "form_after": "viSAKaH", "why_dev": "(सूत्रम् 8.4.68) अ अ इति।", "status": "VACUOUS", "chronological_transition": {"from_sutra": "8.4.58", "to_sutra": "8.4.68"}}, {"sutra_id": "1.1.68", "sutra_type": "ANUVADA", "type_label": "अनुवाद", "form_before": "viSAKaH", "form_after": "viSAKaH", "why_dev": "शब्दः स्व-रूप-पर्यायः (अशब्द-संज्ञा-अपवादः) — डेमो-आडिट्।", "status": "SKIPPED", "skip_reason": "ASIDDHA-GATE (cannot fire outside Tripāḍī once entered)", "chronological_transition": {"from_sutra": "8.4.68", "to_sutra": "1.1.68"}}]}