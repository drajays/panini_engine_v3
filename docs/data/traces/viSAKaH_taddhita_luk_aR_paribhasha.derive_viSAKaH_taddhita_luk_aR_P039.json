{"module": "pipelines.viSAKaH_taddhita_luk_aR_paribhasha", "callable": "derive_viSAKaH_taddhita_luk_aR_P039", "ok": true, "smoke_note": null, "invocation": {"args": [], "kwargs": {}}, "result_kind": "state", "final_flat_slp1": "viSAKaH", "phase": "angakarya", "tripadi_zone": true, "trace_len": 30, "trace": [{"sutra_id": "1.1.68", "sutra_type": "ANUVADA", "type_label": "अनुवाद", "form_before": "viSAKA", "form_after": "viSAKA", "why_dev": "शब्दः स्व-रूप-पर्यायः (अशब्द-संज्ञा-अपवादः) — डेमो-आडिट्।", "status": "AUDIT", "chronological_transition": {"from_sutra": null, "to_sutra": "1.1.68"}}, {"sutra_id": "4.1.76", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "viSAKA", "form_after": "viSAKA", "why_dev": "तद्धिताधिकारः — ४.१.७६ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.68", "to_sutra": "4.1.76"}}, {"sutra_id": "4.3.25", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKA", "form_after": "viSAKAaR", "why_dev": "विशाखायां जात इति प्रसङ्गे अण् (४.३.२५) — P039।", "status": "APPLIED", "chronological_transition": {"from_sutra": "4.1.76", "to_sutra": "4.3.25"}}, {"sutra_id": "4.3.34", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKAaR", "form_after": "viSAKA", "why_dev": "विशाखायाः अण्-प्रत्ययस्य लुक् (४.३.३४) — P039 संक्षेप-छेदः।", "status": "APPLIED", "chronological_transition": {"from_sutra": "4.3.25", "to_sutra": "4.3.34"}}, {"sutra_id": "1.1.60", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "viSAKA", "form_after": "viSAKA", "why_dev": "स्थानिनि वर्णः वा वर्णसमूहः वा अदर्शनं यत्, तत् 'लोप' इति संज्ञा — उपयोगः १.३.९, ८.२.२३, ६.१.६८, … इतिषु; अत्र केवल संज्ञा-निर्णयः।", "status": "APPLIED", "why_now_dev": "स्थाने वर्णस्य वर्णसमूहस्य वा अदर्शनं 'लोप'-संज्ञां प्राप्नोति; अनया संज्ञया उत्तर-विधयः (यथा १.३.९ इत्-लोपः) प्रवर्तन्ते। (१.१.६०)", "chronological_transition": {"from_sutra": "4.3.34", "to_sutra": "1.1.60"}}, {"sutra_id": "1.1.61", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "viSAKA", "form_after": "viSAKA", "why_dev": "प्रत्ययस्य लोपः यदा 'लुक्' / 'श्लुः' / 'लुप्' इति विशिष्टेन शब्देनोक्तः, तदा स लोपः तथैव संज्ञकः; केवलं 'लोपः' इति शब्देनोक्तस्तु न — १.१.६३ इत्यादौ 'लु' इति सामान्यनिर्देशः; सम्पूर्ण-प्रत्ययलोपे १.१.५२, १.१.५४ न। तिसृणां प्रयोजनम् — श्लौ ६.१.१० इति श्लुः-संज्ञकलोपानन्तरं प्रकृतेः द्वित्वम् (यथा दा+शप्+ति → ददाति); लुक् समूहलोपे, तद्धिते लुकि १.२.४९ लुक्तद्धितलुकि उपसर्जन-स्त्रीप्रत्ययस्यापि लुक् (यथा आमलक्याः फलम् → आमलक+…, ४.३.१६३); १.१.६२–६३ प्रत्ययलक्षणम् / न लुमताङ्गस्य — अनिष्टाङ्गकार्ये लुक्-श्लु-लुप्-संज्ञा (यथा पञ्चन्+जस् → पञ्च, ७.१.२२); लुप्-संज्ञायां १.२.५१ लुपि युक्तवद् व्यक्तिवचने इति लिङ्ग-वचने प्रकृतिम् अनुसरतः (यथा पञ्चालानां निवासः → पञ्चालाः जनपदः, ४.२.८१ इत्यादौ लुप्)।", "status": "APPLIED", "why_now_dev": "प्रत्ययलोपस्य 'लुक्'/'श्लुः'/'लुप्' इति त्रयः विशेष-संज्ञाः अधुना पञ्जीकृताः; लोप-संज्ञा (१.१.६०) पूर्वम् एव सक्रिया। (१.१.६१)", "chronological_transition": {"from_sutra": "1.1.60", "to_sutra": "1.1.61"}}, {"sutra_id": "4.1.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "viSAKA", "form_after": "viSAKA", "why_dev": "प्रातिपदिकाधिकारः — ४.१.१ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.61", "to_sutra": "4.1.1"}}, {"sutra_id": "4.1.3", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "viSAKA", "form_after": "viSAKA", "why_dev": "स्त्र्यधिकारः (द्वितीयः) — ४.१.३ तः ४.१.८९ पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "4.1.1", "to_sutra": "4.1.3"}}, {"sutra_id": "4.1.4", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKA", "form_after": "viSAKA", "why_dev": "अजादिगण-शब्देभ्यः ह्रस्व-अकारान्तेभ्यश्च स्त्रियाम् टाप्; ईयसो बहुव्रीहेः प्रतिषेधो वार्तिकेन (अङ्गे 'Iyas_bahuvrIhi_pratishedha' इति)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "4.1.3", "to_sutra": "4.1.4"}}, {"sutra_id": "4.1.2", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "viSAKA", "form_after": "viSAKAsu", "why_dev": "एकविंशति सुप्-प्रत्ययाः क्रमेण प्रातिपदिकात् विधीयन्ते; अधिकारः ४.१.२ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "4.1.4", "to_sutra": "4.1.2"}}, {"sutra_id": "1.3.2", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "viSAKAsu", "form_after": "viSAKAsu", "why_dev": "उपदेशावस्थायाम् अज् वर्णः अनुनासिकः चेद् इत्-संज्ञकः; इँर्-वार्तिके पुनः द्वयोः संयुक्तः इत्। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "4.1.2", "to_sutra": "1.3.2"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKAsu", "form_after": "viSAKAs", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.2", "to_sutra": "1.3.9"}}, {"sutra_id": "1.2.41", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "viSAKAs", "form_after": "viSAKAs", "why_dev": "एक-हल्-प्रत्ययः अपृक्त-संज्ञकः (ईट्-आगम ७.३.९६ इत्यादि-प्रसङ्गे)।", "status": "APPLIED", "why_now_dev": "एक-अल् (एक-वर्ण) प्रत्ययः 'अपृक्त'-संज्ञां प्राप्नोति; अनया संज्ञया ईट्-आगम-आदि-विधयः (यथा ७.३.९६) प्रवर्तन्ते। (१.२.४१)", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "1.2.41"}}, {"sutra_id": "6.1.68", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "viSAKAs", "form_after": "viSAKA", "why_dev": "हल्-अन्तात् / ङी-आभ्-अन्तात् दीर्घात् अङ्गात् परस्य अपृक्त-सु-हल्-लोपः।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.2.41", "to_sutra": "6.1.68"}}, {"sutra_id": "__MERGE__", "sutra_type": "STRUCTURAL", "type_label": "P039-पुं-प्रथम-पद", "form_before": "viSAKas", "form_after": "viSAKas", "why_dev": "ट