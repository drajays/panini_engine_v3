sutra_type": "VIDHI", "type_label": "विधि", "form_before": "yadA", "form_after": "yadA", "why_dev": "झष्-पूर्वे त्/थ् का ध्-आदेशः (डेमो: रुणद्धि; प००१-डि पूर्व-त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.39", "to_sutra": "8.2.40"}}, {"sutra_id": "8.2.41", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "yadA", "form_after": "yadA", "why_dev": "षढोः कः सि: ष्/ढ् before स् → क् — लेढ्+स्य → लेक्+स्य.", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.40", "to_sutra": "8.2.41"}}, {"sutra_id": "8.2.66", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "yadA", "form_after": "yadA", "why_dev": "पदान्त-सकारस्य सजुषः च रु-आदेशः (त्रिपादी)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.41", "to_sutra": "8.2.66"}}, {"sutra_id": "8.2.77", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "yadA", "form_after": "yadA", "why_dev": "धातोः र्वोः पूर्वस्य इकः दीर्घः हलि परे (दीव्यति)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.66", "to_sutra": "8.2.77"}}, {"sutra_id": "8.2.78", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "yadA", "form_after": "yadA", "why_dev": "धातोः उपधाभूतयोः र्वोः पूर्वस्य इकः दीर्घः (मूर्वति)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.77", "to_sutra": "8.2.78"}}, {"sutra_id": "8.3.15", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "yadA", "form_after": "yadA", "why_dev": "खर्-वर्णे परे अवसाने च रु-आदेशस्य विसर्गः।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.78", "to_sutra": "8.3.15"}}, {"sutra_id": "8.3.24", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "yadA", "form_after": "yadA", "why_dev": "अपदान्त-नकारस्य झलि परे अनुस्वारः (डेमो: मुञ्चति)।", "sta