{"module": "pipelines.avaDIt_luN_han", "callable": "derive_avaDIt", "ok": true, "smoke_note": null, "invocation": {"args": [], "kwargs": {}}, "result_kind": "state", "final_flat_slp1": "avaDIt", "phase": "angakarya", "tripadi_zone": true, "trace_len": 38, "trace": [{"sutra_id": "1.1.68", "sutra_type": "ANUVADA", "type_label": "अनुवाद", "form_before": "han", "form_after": "han", "why_dev": "शब्दः स्व-रूप-पर्यायः (अशब्द-संज्ञा-अपवादः) — डेमो-आडिट्।", "status": "AUDIT", "chronological_transition": {"from_sutra": null, "to_sutra": "1.1.68"}}, {"sutra_id": "1.3.1", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "han", "form_after": "han", "why_dev": "भू आदि गणे पठितानां धातूनां धातु-संज्ञा (उपदेश एव अधिकृतः)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.1.68", "to_sutra": "1.3.1"}}, {"sutra_id": "3.2.110", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "han", "form_after": "hanluG", "why_dev": "अद्यतन-भूते लुङ्-लकार-स्थापनम् (इह 'luG' प्लेसहोल्डर्) ।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.1", "to_sutra": "3.2.110"}}, {"sutra_id": "3.4.69", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "hanluG", "form_after": "hanluG", "why_dev": "सकर्मकानां धातूनां लकारे कर्तरि कर्मणि च, अकर्मकानां कर्तरि भावे च — अतः paribhAṣA-dvArAH (Term.meta karmakatva)।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.2.110", "to_sutra": "3.4.69"}}, {"sutra_id": "3.1.91", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "hanluG", "form_after": "hanluG", "why_dev": "धातोः कृत्-तिङ्-प्रत्ययाः — अधिकारः ३.१.९१ तः ३.४.११७ पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.4.69", "to_sutra": "3.1.91"}}, {"sutra_id": "3.1.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "hanluG", "form_after": "hanluG", "why_dev": "अधिकारः प्रत्यय-विधानम् — ३.१.१ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.91", "to_sutra": "3.1.1"}}, {"sutra_id": "3.1.2", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "hanluG", "form_after": "hanluG", "why_dev": "प्रत्ययः निमित्तात् परः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.1", "to_sutra": "3.1.2"}}, {"sutra_id": "3.1.3", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "hanluG", "form_after": "hanluG", "why_dev": "प्रत्ययस्य आद्युदात्तत्वम् — अधिकारः ३.१.३ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "3.1.2", "to_sutra": "3.1.3"}}, {"sutra_id": "3.1.43", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "hanluG", "form_after": "hancliluG", "why_dev": "लुङ्-लकारे धातोः परे च्लि-आगमः (सिच्-आदेश-पूर्वः)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "3.1.3", "to_sutra": "3.1.43"}}, {"sutra_id": "3.1.44", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "hancliluG", "form_after": "hanscluG", "why_dev": "च्लि-आगमस्य स्थाने सिच्-आदेशः (लुङ्-सिच्-प्रक्रिया)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "3.1.43", "to_sutra": "3.1.44"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "hanscluG", "form_after": "hanscluG", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "3.1.44", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "hanscluG", "form_after": "haslu", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.9"}}, {"sutra_id": "1.3.10", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "haslu", "form_after": "haslu", "why_dev": "द्वयोः समसङ्ख्यक-गणयोः मध्ये अनुदेशः यदा, तदा सः सदस्येषु क्रमेण — यथा ६.१.७८ (ए→अय्, ऐ→आय्), ३.१.१३४ (ल्यु्-णिनि-अच्), १.१.४६ (टित्-कित्)। असमसङ्ख्ये (८.२.३९) न; अन्तरतमम् १.१.५० आदि।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "1.3.10"}}, {"sutra_id": "2.4.43", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "haslu", "form_after": "vadhaslu", "why_dev": "लुङ्-लकारे हन्-धातोः स्थाने वध्-आदेशः (अवधीत्-प्रक्रिया)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.10", "to_sutra": "2.4.43"}}, {"sutra_id": "6.4.71", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "vadhaslu", "form_after": "avadhaslu", "why_dev": "लुङ्/लङ्/लृङ्-लकारे धातोः पूर्वं अट्-आगमः; P014: लिटि अनुप्रयोग-कृ-यण्-मूर्तौ ``kr`` पूर्वम् ``a`` (आगम-समान-कार्यम्)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "2.4.43", "to_sutra": "6.4.71"}}, {"sutra_id": "3.4.77", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "avadhaslu", "form_after": "avadhaslu", "why_dev": "लाधिकारः — ३.४.७७ तः ३.४.११२ पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "6.4.71", "to_sutra": "3.4.77"}}, {"sutra_id": "3.4.78", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "avadhaslu", "form_after": "avadhastip", "why_dev": "लकार-प्रत्ययस्य स्थाने तिङ्-आदेश (तिप्-तस्-झि-…-महिङ्) — संज्ञाः १.४.९९ इत्यादि-सूत्रैः पृथक्; सूत्रे अभिकल्पित-तिङ्-लक्ष्यम्, न पुरुष-वचन-परिगणनम् (CONSTITUTION २)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "3.4.77", "to_sutra": "3.4.78"}}, {"sutra_id": "1.4.99", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "avadhastip", "form_after": "avadhastip", "why_dev": "लकार-स्थानि तिङादेशादिषु अन्त्यैकादश-प्रकारेषु परस्मैपद-संज्ञा; तङादिषु १.४.१०० इति पृथक् (एकसंज्ञा-सापेक्ष)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "3.4.78", "to_sutra": "1.4.99"}}, {"sutra_id": "1.3.3", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "avadhastip", "form_after": "avadhastip", "why_dev": "उपदेशे अन्त्यः हल् वर्णः ‘इत्’ संज्ञां लभते; तुस्मान्त-विभक्तौ निषेधः १.३.४। लोपः १.३.९।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.4.99", "to_sutra": "1.3.3"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "avadhastip", "form_after": "avadhasti", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.9"}}, {"sutra_id": "3.4.100", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "avadhasti", "form_after": "avadhast", "why_dev": "लङ्/लुङ्/लृङ्-प्रक्रियायां तिङ्-अन्तस्थ इकारस्य लोपः (ति→त्, सि→स्, झि→झ्); लङि: ७.१.३-पूर्वं झि→झ् → अन्त्।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "3.4.100"}}, {"sutra_id": "1.2.41", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "avadhast", "form_after": "avadhast", "why_dev": "एक-हल्-प्रत्ययः अपृक्त-संज्ञकः (ईट्-आगम ७.३.९६ इत्यादि-प्रसङ्गे)।", "status": "APPLIED", "why_now_dev": "एक-अल् (एक-वर्ण) प्रत्ययः 'अपृक्त'-संज्ञां प्राप्नोति; अनया संज्ञया ईट्-आगम-आदि-विधयः (यथा ७.३.९६) प्रवर्तन्ते। (१.२.४१)", "chronological_transition": {"from_sutra": "3.4.100", "to_sutra": "1.2.41"}}, {"sutra_id": "3.4.114", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "avadhast", "form_after": "avadhast", "why_dev": "शेषः प्रत्यय आर्धधातुक-संज्ञकः (तृच् इत्यादौ)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.2.41", "to_sutra": "3.4.114"}}, {"sutra_id": "7.2.35", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "avadhast", "form_after": "avadhaist", "why_dev": "आर्धधातुके परे वल्-प्रथमादौ इट्-आगमः (प्रतिषेधे न)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "3.4.114", "to_sutra": "7.2.35"}}, {"sutra_id": "6.4.48", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "avadhaist", "form_after": "avadhist", "why_dev": "अकारान्त-अङ्गस्य परे अकारादौ अ-लोपः; परनिमित्तकः उपधा-वृद्धिं निवारयति।", "status": "APPLIED", "chronological_transition": {"from_sutra": "7.2.35", "to_sutra": "6.4.48"}}, {"sutra_id": "1.1.57", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "avadhist", "form_after": "avadhist", "why_dev": "पूर्वविधि-लोपितस्य अचः स्थानिवत्-भावः (P025)।", "status": "AUDIT", "chronological_transition": {"from_sutra": "6.4.48", "to_sutra": "1.1.57"}}, {"sutra_id": "1.1.56", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "avadhist", "form_after": "avadhist", "why_dev": "आदेशः स्थानिनः समानधर्मा भवति, परम् अल्-विधिं विहाय।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.57", "to_sutra": "1.1.56"}}, {"sutra_id": "1.1.1", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "avadhist", "form_after": "avadhist", "why_dev": "आ-ऐ-औ इति वृद्धि-संज्ञा (अधिकार-बद्धा न, सर्वत्र उपलब्धा)। अनया केवल वर्ण-समूहस्य निर्देशः — पदेषु स्वतः परिवर्तनं न। वृद्धि-प्रयोगः तु यदा विधि-सूत्रेषु (यथा ६.१.८८) प्रसङ्गः, तदा। अष्टाध्याय्यां 'वृद्धि' इयं संज्ञा नवसु सूत्रेषु साक्षात्, अन्यत्र अनुवृत्त्या च।", "status": "APPLIED", "why_now_dev": "आ, ऐ, औ — एते वर्णाः 'वृद्धि'-संज्ञां प्राप्नुवन्ति; इयं संज्ञा वृद्धि-विधिषु (यथा ६.१.८८ वृद्धिरेचि, ७.२.१ सिचि वृद्धिः) उपयुज्यते। (१.१.१)", "chronological_transition": {"from_sutra": "1.1.56", "to_sutra": "1.1.1"}}, {"sutra_id": "1.1.3", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "avadhist", "form_after": "avadhist", "why_dev": "यत्र गुण-वृद्धी उत्सर्गतः, न च स्थानी षष्ठ्यन्तं निर्दिष्टः, तत्र स्थानी इक्-वर्ण एव; अत्र तत्-परिभाषा-द्वारा निश्चयः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.1", "to_sutra": "1.1.3"}}, {"sutra_id": "1.1.4", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "avadhist", "form_after": "avadhist", "why_dev": "आर्धधातुके क्षेपे सति यदि धातु-लोपः, तदा १.१.३-वर्णितः इक-स्थानिन्-नियमो गुण-वृद्धि-क्रियायै न प्रवर्तते।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.3", "to_sutra": "1.1.4"}}, {"sutra_id": "1.1.5", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "avadhist", "form_after": "avadhist", "why_dev": "क्‍ङ्-परिच्छिन्ने प्रत्यय-क्षेपे, तस्मिन् आङ्ग-कार्ये, यः १.१.३-उत्सर्ग-इक-नियमः, सो न।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.4", "to_sutra": "1.1.5"}}, {"sutra_id": "1.1.6", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "avadhist", "form_after": "avadhist", "why_dev": "इडागम-इकारस्य गुणनिषेधः (परिभाषा-गेट)।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.5", "to_sutra": "1.1.6"}}, {"sutra_id": "1.1.50", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "avadhist", "form_after": "avadhist", "why_dev": "आदेश-चयनस्य परिभाषा — स्थाने (उच्चारण-स्थान-प्रयत्नादि-साम्ये) अन्तरतमः विकल्प्यते।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.6", "to_sutra": "1.1.50"}}, {"sutra_id": "7.2.7", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "avadhist", "form_after": "avadhist", "why_dev": "लुङ्-सिच्-पथे इट्-कार्यम् (इ→ई, P026); हलादेः पूर्वस्य अ-विकल्प-वृद्धिः (हन्-लुङ्)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.1.50", "to_sutra": "7.2.7"}}, {"sutra_id": "7.2.7", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "avadhist", "form_after": "avadhIst", "why_dev": "लुङ्-सिच्-पथे इट्-कार्यम् (इ→ई, P026); हलादेः पूर्वस्य अ-विकल्प-वृद्धिः (हन्-लुङ्)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "7.2.7", "to_sutra": "7.2.7"}}, {"sutra_id": "__MERGE__", "sutra_type": "STRUCTURAL", "type_label": "पद-मेलनम्", "form_before": "avadhIst", "form_after": "avadhIst", "why_dev": "पद-रचना — सर्व-धातु/सुबन्त/कृदन्त-संयोजनम् (संरचनात्मकं, न सूत्रम्)।", "status": "APPLIED", "event": "MERGE"}, {"sutra_id": "6.4.114", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "avadhIst", "form_after": "avaDIt", "why_dev": "सिच्-सकारस्य लोपः, धकारस्य ठत्वं च (अवधीत्-ट्रिपादी-डेमो)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "7.2.7", "to_sutra": "6.4.114"}}, {"sutra_id": "8.2.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "avaDIt", "form_after": "avaDIt", "why_dev": "८.२.१ तः ८.४.६८ पर्यन्तम् (त्रिपादी) पूर्व-सूत्रेभ्यः असिद्धम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "6.4.114", "to_sutra": "8.2.1"}}]}