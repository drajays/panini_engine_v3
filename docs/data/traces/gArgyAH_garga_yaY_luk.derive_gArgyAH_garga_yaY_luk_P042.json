, "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "1.3.3", "to_sutra": "1.3.8"}}, {"sutra_id": "1.3.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gargayaY", "form_after": "gargaya", "why_dev": "ये वर्णाः ‘इत्’ संज्ञकाः (१.३.२–१.३.८), तेषां लोपः। अयम् एव ध्वनि-अपगमः — संज्ञा-निर्देशो न।", "status": "APPLIED", "why_now_dev": "इत्-संज्ञक-वर्णानां लोपः उपदेशावस्थायाम् (इतस्य लोपः); एते वर्णाः १.३.२–१.३.८ इति सूत्रैः ‘इत्’-संज्ञां प्राप्ताः। (१.३.९)", "chronological_transition": {"from_sutra": "1.3.8", "to_sutra": "1.3.9"}}, {"sutra_id": "1.3.10", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "gargaya", "form_after": "gargaya", "why_dev": "द्वयोः समसङ्ख्यक-गणयोः मध्ये अनुदेशः यदा, तदा सः सदस्येषु क्रमेण — यथा ६.१.७८ (ए→अय्, ऐ→आय्), ३.१.१३४ (ल्यु्-णिनि-अच्), १.१.४६ (टित्-कित्)। असमसङ्ख्ये (८.२.३९) न; अन्तरतमम् १.१.५० आदि।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.3.9", "to_sutra": "1.3.10"}}, {"sutra_id": "6.4.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "gargaya", "form_after": "gargaya", "why_dev": "६.४.१ तः ७.४.९७ पर्यन्तानि सूत्राणि अङ्गस्य विधयः।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.3.10", "to_sutra": "6.4.1"}}, {"sutra_id": "7.2.117", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gargaya", "form_after": "gArgaya", "why_dev": "णित्/ञित्-तद्धित-प्रत्यये परे अङ्गस्य आद्य-अचः वृद्धिः (दक्ष+इञ्→दाक्ष, शीत+ष्यञ्→शैत, सोम+ट्यण्→सौम)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "6.4.1", "to_sutra": "7.2.117"}}, {"sutra_id": "__MERGE__", "sutra_type": "STRUCTURAL", "type_label": "यञ्-मेलनम्", "form_before": "gArgaya", "form_after": "gArgya", "why_dev": "गार्ग + य → गार्ग्य (संरचनात्मकं, P042)।", "status": "APPLIED"}, {"sutra_id": "4.1.2", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "gArgya", "form_after": "gArgyajas", "why_dev": "एकविंशति सुप्-प्रत्ययाः क्रमेण प्रातिपदिकात् विधीयन्ते; अधिकारः ४.१.२ तः ५.४.१६० पर्यन्तम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "7.2.117", "to_sutra": "4.1.2"}}, {"sutra_id": "4.1.162", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "gArgyajas", "form_after": "gArgyajas", "why_dev": "यञन्त-अपत्यं गोत्र-संज्ञकम् (४.१.१६२) — P042।", "status": "APPLIED", "chronological_transition": {"from_sutra": "4.1.2", "to_sutra": "4.1.162"}}, {"sutra_id": "2.4.64", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gArgyajas", "form_after": "gArgyajas", "why_dev": "यञ्-लुक्-प्रसङ्गः (गार्ग्याः, P042) — संक्षेप-छेदः।", "status": "APPLIED", "chronological_transition": {"from_sutra": "4.1.162", "to_sutra": "2.4.64"}}, {"sutra_id": "1.1.60", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "gArgyajas", "form_after": "gArgyajas", "why_dev": "स्थानिनि वर्णः वा वर्णसमूहः वा अदर्शनं यत्, तत् 'लोप' इति संज्ञा — उपयोगः १.३.९, ८.२.२३, ६.१.६८, … इतिषु; अत्र केवल संज्ञा-निर्णयः।", "status": "APPLIED", "why_now_dev": "स्थाने वर्णस्य वर्णसमूहस्य वा अदर्शनं 'लोप'-संज्ञां प्राप्नोति; अनया संज्ञया उत्तर-विधयः (यथा १.३.९ इत्-लोपः) प्रवर्तन्ते। (१.१.६०)", "chronological_transition": {"from_sutra": "2.4.64", "to_sutra": "1.1.60"}}, {"sutra_id": "1.1.61", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "gArgyajas", "form_after": "gArgyajas", "why_dev": "प्रत्ययस्य लोपः यदा 'लुक्' / 'श्लुः' / 'लुप्' इति विशिष्टेन शब्देनोक्तः, तदा स लोपः तथैव संज्ञकः; केवलं 'लोपः' इति शब्देनोक्तस्तु न — १.१.६३ इत्यादौ 'लु' इति सामान्यनिर्देशः; सम्पूर्ण-प्रत्ययलोपे १.१.५२, १.१.५४ न। तिसृणां प्रयोजनम् — श्लौ ६.१.१० इति श्लुः-संज्ञकलोपानन्तरं प्रकृतेः द्वित्वम् (यथा दा+शप्+ति → ददाति); लुक् समूहलोपे, तद्धिते लुकि १.२.४९ लुक्तद्धितलुकि उपसर्जन-स्त्रीप्रत्ययस्यापि लुक् (यथा आमलक्याः फलम् → आमलक+…, ४.३.१६३); १.१.६२–६३ प्रत्ययलक्षणम् / न लुमताङ्गस्य — अनिष्टाङ्गकार्ये लुक्-श्लु-लुप्-संज्ञा (यथा पञ्चन्+जस् → पञ्च, ७.१.२२); लुप्-संज्ञायां १.२.५१ लुपि युक्तवद् व्यक्तिवचने इति लिङ्ग-वचने प्रकृतिम् अनुसरतः (यथा पञ्चालानां निवासः → पञ्चालाः जनपदः, ४.२.८१ इत्यादौ लुप्)।", "status": "APPLIED", "why_now_dev": "प्रत्ययलोपस्य 'लुक्'/'श्लुः'/'लुप्' इति त्रयः विशेष-संज्ञाः अधुना पञ्जीकृताः; लोप-संज्ञा (१.१.६०) पूर्वम् एव सक्रिया। (१.१.६१)", "chronological_transition": {"from_sutra": "1.1.60", "to_sutra": "1.1.61"}}, {"sutra_id": "1.1.62", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "gArgyajas", "form_after": "gArgyajas", "why_dev": "प्रत्ययस्य लोपे कृते अपि प्रत्ययाश्रितं कार्यम् अवश्यं भवति — यथा नदी+सुँ → नदी (६.१.६८) इत्यत्र पदम् १.४.१४; षष्+जस् → षड् (७.१.२२ लुक्); अदस्+सुँ → असौ (७.२.१०६); अग्निचित् (६.१.७१); अधुक् (७.३.८६, ८.२.३२)। अङ्गकार्ये अपवादः १.१.६३।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.61", "to_sutra": "1.1.62"}}, {"sutra_id": "1.1.63", "sutra_type": "PARIBHASHA", "type_label": "परिभाषा", "form_before": "gArgyajas", "form_after": "gArgyajas", "why_dev": "लुक्-श्लु-लुप्-संज्ञकेन प्रत्ययलोपे लुप्तप्रत्ययनिमित्तकम् अङ्गकार्यम् न — यथा इदम्+सुँ → इदम् (७.१.२३ लुक्, ७.२.११० यः सौ न); हु+शप् → झुहुतः (२.४.७५ श्लुः, ७.३.८४ गुणो न); पञ्चाल+अण् (४.२.८१ लुप्, ७.२.११७ आदिवृद्धिर्न)। केवल-लोपे (६.१.६८) १.१.६३ न, यथा शशिन्+सुँ → शशी (६.४.१३)। अङ्गस्यैव निषेधः — पदम्, नलोपः (८.२.७) आदयः अङ्गकार्यं विना १.१.६२-अनुसारेण (यथा पञ्चन्+जस् → पञ्च)।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.1.62", "to_sutra": "1.1.63"}}, {"sutra_id": "7.1.9", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gArgyajas", "form_after": "gArgyaas", "why_dev": "अदन्त-अङ्गात् परस्य 'भिस्'-प्रत्ययस्य 'ऐस्'-आदेशः।", "status": "APPLIED", "chronological_transition": {"from_sutra": "1.1.63", "to_sutra": "7.1.9"}}, {"sutra_id": "6.1.101", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gArgyaas", "form_after": "gArgyAs", "why_dev": "अक् वर्णस्य परस्मिन् सवर्णे एकादेशः सवर्ण-दीर्घः भवति; प०३६ ``ninaya``→``ninAya`` (णल्-परिणाम)।", "status": "APPLIED", "chronological_transition": {"from_sutra": "7.1.9", "to_sutra": "6.1.101"}}, {"sutra_id": "__MERGE__", "sutra_type": "STRUCTURAL", "type_label": "पद-मेलनम्", "form_before": "gArgyAs", "form_after": "gArgyAs", "why_dev": "पद-रचना — सर्व-धातु/सुबन्त/कृदन्त-संयोजनम् (संरचनात्मकं, न सूत्रम्)।", "status": "APPLIED", "event": "MERGE"}, {"sutra_id": "1.4.14", "sutra_type": "SAMJNA", "type_label": "संज्ञा", "form_before": "gArgyAs", "form_after": "gArgyAs", "why_dev": "सुप्-अन्तः तिङ्-अन्तः वा शब्दः पद-संज्ञकः (अष्टाध्यायी)।", "status": "APPLIED", "why_now_dev": "सुप्-अन्तः तिङ्-अन्तः वा शब्दः पद-संज्ञकः; अनेन पद-कार्याणि (त्रिपादी-सन्धि-आदि) प्रसजन्ति। (१.४.१४)", "chronological_transition": {"from_sutra": "6.1.101", "to_sutra": "1.4.14"}}, {"sutra_id": "8.2.1", "sutra_type": "ADHIKARA", "type_label": "अधिकार", "form_before": "gArgyAs", "form_after": "gArgyAs", "why_dev": "८.२.१ तः ८.४.६८ पर्यन्तम् (त्रिपादी) पूर्व-सूत्रेभ्यः असिद्धम्।", "status": "AUDIT", "chronological_transition": {"from_sutra": "1.4.14", "to_sutra": "8.2.1"}}, {"sutra_id": "8.2.23", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gArgyAs", "form_after": "gArgyAs", "why_dev": "संयोगान्त-पदस्य अन्त्य-हल्-लोपः (चितवान्)।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.1", "to_sutra": "8.2.23"}}, {"sutra_id": "8.2.39", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gArgyAs", "form_after": "gArgyAs", "why_dev": "पदान्ते झल्-व्यञ्जनस्य स्थाने जश्-व्यञ्जनः (सूत्रम् ८.२.३९ झलां जशोऽन्ते) — त् → द्।", "status": "SKIPPED", "skip_reason": "COND-FALSE", "chronological_transition": {"from_sutra": "8.2.23", "to_sutra": "8.2.39"}}, {"sutra_id": "8.2.66", "sutra_type": "VIDHI", "type_label": "विधि", "form_before": "gArgyAs", "form_after": "gArgyAr", "why_dev": "पदान्त-सकारस्य सजुषः च रु-आदेशः (त्रिपादी)।", "status": "APPLIED", "why_now_dev": "पदान्त-सकारस्य 'रु'-आदेशः (त्रिपादी); अयं रु पुनः ८.३.१५ इति खर्/अवसाने विसर्गः, अन्यत्र (घोष-हलि) रेफः अवशिष्यते। (८.२.६६)", "chronological_transiti