 "lessons": [
  {"id": "v1", "level": 1, "title": "The bare sentence", "deva": "कर्ता क्रिया च", "frames": ["INTRANS"], "lakaras": ["laT"], "vacanas": [1], "persons": [3],
   "about": "One noun, one verb, the present. The verb's ending already says who acts (3.4.69), so the kartā is left with the bare प्रथमा (2.3.46).",
   "sutras": ["1.4.54", "2.3.46", "3.4.69"]},
  {"id": "v2", "level": 1, "title": "One, two, many", "deva": "वचनम्", "frames": ["INTRANS", "TRANS"], "lakaras": ["laT"], "vacanas": [1, 2, 3], "persons": [3],
   "about": "Sanskrit counts one, two, many (1.4.21, 1.4.22). The verb takes the kartā's number.",
   "sutras": ["1.4.21", "1.4.22"]},
  {"id": "v3", "level": 1, "title": "I and you", "deva": "पुरुषः", "frames": ["INTRANS", "TRANS"], "lakaras": ["laT"], "vacanas": [1, 2, 3], "persons": [1, 2],
   "about": "With yuṣmad the verb is madhyama (1.4.105), with asmad uttama (1.4.107), otherwise prathama (1.4.108).",
   "sutras": ["1.4.105", "1.4.107", "1.4.108"]},
  {"id": "v4", "level": 2, "title": "The object", "deva": "कर्म द्वितीया च", "frames": ["TRANS"], "lakaras": ["laT"], "vacanas": [1, 2, 3], "persons": [3],
   "about": "What the doer most wants to reach is the karman (1.4.49); it takes द्वितीया (2.3.2) — only because the verb has not already expressed it (2.3.1 अनभिहिते).",
   "sutras": ["1.4.49", "2.3.1", "2.3.2"]},
  {"id": "v5", "level": 2, "title": "Going somewhere", "deva": "गत्यर्थकर्म", "frames": ["MOTION"], "lakaras": ["laT"], "vacanas": [1, 2, 3], "persons": [3],
   "about": "The place one goes to is the karman of a verb of going — द्वितीया again (1.4.49, 2.3.2).",
   "sutras": ["1.4.49", "2.3.2"]},
  {"id": "v6", "level": 2, "title": "Where it happens", "deva": "अधिकरणं सप्तमी च", "frames": ["LOC"], "lakaras": ["laT"], "vacanas": [1, 2, 3], "persons": [3],
   "about": "The ground an action rests on is the adhikaraṇa (1.4.45) and takes सप्तमी (2.3.36).",
   "sutras": ["1.4.45", "2.3.36"]},
  {"id": "v7", "level": 3, "title": "Means, giving, source", "deva": "करणं सम्प्रदानम् अपादानं च", "frames": ["INSTR", "GIVE", "ABL"], "lakaras": ["laT"], "vacanas": [1, 2, 3], "persons": [3],
   "about": "Karaṇa (1.4.42) → तृतीया (2.3.18); sampradāna (1.4.32) → चतुर्थी (2.3.13); apādāna (1.4.24) → पञ्चमी (2.3.28).",
   "sutras": ["1.4.42", "2.3.18", "1.4.32", "2.3.13", "1.4.24", "2.3.28"]},
  {"id": "v8", "level": 3, "title": "Yesterday and tomorrow", "deva": "लङ् लृट् च", "frames": ["INTRANS", "TRANS", "MOTION", "LOC", "INSTR", "GIVE", "ABL"], "lakaras": ["laG", "lRT"], "vacanas": [1, 2, 3], "persons": [1, 2, 3],
   "about": "The same sentences in the past not of today (3.2.111 anadyatane laṅ) and the future (3.3.13 lṛṭ śeṣe ca). Only the verb changes.",
   "sutras": ["3.2.111", "3.3.13"]},
  {"id": "v9", "level": 3, "title": "Commands and wishes", "deva": "लोट् विधिलिङ् च", "frames": ["INTRANS", "TRANS", "MOTION", "LOC", "INSTR", "GIVE", "ABL"], "lakaras": ["loT", "liG"], "vacanas": [1, 2, 3], "persons": [3],
   "about": "Imperative (3.3.162 loṭ ca) and optative (3.3.161 vidhinimantraṇa… liṅ): 'let Rāma go', 'Rāma should go'.",
   "sutras": ["3.3.162", "3.3.161"]}
 ]
